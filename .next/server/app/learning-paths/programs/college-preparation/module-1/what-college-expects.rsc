17:["$","p","1",{"className":"text-gray-700 leading-relaxed","children":"The single largest difference between high school and college is not that the work is harder. It is that tracking the work is now your job. Attendance may not be taken. Reminders may not come. A syllabus issued in week one is often the only time you will be told what is due, and it is assumed you will keep it."}]
18:["$","figure","2",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"In high school"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"In college"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Teachers remind you what is due"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"The syllabus tells you once, in week one"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Attendance is monitored and reported"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Attendance may be your own to manage"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Most work happens in class"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Most work happens outside class"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"A parent is told when you fall behind"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"You are told, and only if you are looking"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Extensions are often negotiable"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Late policies are published and applied"}]]}],["$","tr","5",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Help is offered to you"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Help exists and you have to go and get it"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"Where the responsibility moved"}]]}]
19:["$","div","3",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-blue-50 border-blue-400","children":[false,"The standard expectation is two hours of work outside class for every hour in it. A twelve-credit schedule is therefore closer to a 36-hour week than a 12-hour one. Students who plan around class time alone are not lazy — they have been given a number that was never explained to them."]}]
1a:["$","div","4",{"className":"rounded-xl border border-gray-200 bg-white p-6","children":[["$","h4",null,{"className":"text-sm font-semibold uppercase tracking-wide text-gray-500 mb-4","children":"Key terms"}],["$","dl",null,{"className":"space-y-3","children":[["$","div","0",{"className":"sm:flex sm:gap-4","children":[["$","dt",null,{"className":"font-semibold text-gray-900 sm:w-48 sm:flex-shrink-0","children":"Credit hour"}],["$","dd",null,{"className":"text-gray-700 leading-relaxed","children":"Roughly one hour of class per week for a term, plus about two hours of work outside it."}]]}],["$","div","1",{"className":"sm:flex sm:gap-4","children":[["$","dt",null,{"className":"font-semibold text-gray-900 sm:w-48 sm:flex-shrink-0","children":"Syllabus"}],["$","dd",null,{"className":"text-gray-700 leading-relaxed","children":"The course contract: what is covered, what is due, how you are graded, and what the policies are."}]]}],["$","div","2",{"className":"sm:flex sm:gap-4","children":[["$","dt",null,{"className":"font-semibold text-gray-900 sm:w-48 sm:flex-shrink-0","children":"Prerequisite"}],["$","dd",null,{"className":"text-gray-700 leading-relaxed","children":"A course you must pass before enrolling in another."}]]}],["$","div","3",{"className":"sm:flex sm:gap-4","children":[["$","dt",null,{"className":"font-semibold text-gray-900 sm:w-48 sm:flex-shrink-0","children":"Full-time"}],["$","dd",null,{"className":"text-gray-700 leading-relaxed","children":"Usually twelve or more credits a term. It affects financial aid eligibility."}]]}],["$","div","4",{"className":"sm:flex sm:gap-4","children":[["$","dt",null,{"className":"font-semibold text-gray-900 sm:w-48 sm:flex-shrink-0","children":"Academic standing"}],["$","dd",null,{"className":"text-gray-700 leading-relaxed","children":"Whether your GPA meets the minimum. Falling below it triggers warning, then probation."}]]}],["$","div","5",{"className":"sm:flex sm:gap-4","children":[["$","dt",null,{"className":"font-semibold text-gray-900 sm:w-48 sm:flex-shrink-0","children":"Withdrawal (W)"}],["$","dd",null,{"className":"text-gray-700 leading-relaxed","children":"Dropping a course after the add/drop window. It appears on your transcript but does not affect GPA."}]]}]]}]]}]
1b:["$","div","5",{"className":"rounded-xl border border-primary-200 bg-primary-50/50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-primary-700 mb-2","children":"Worked example"}],["$","h4",null,{"className":"text-lg font-bold text-gray-900 mb-1","children":"Reading a syllabus for what it obliges you to do"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-5","children":"You have four syllabi and thirty minutes. Extract what actually matters."}],["$","ol",null,{"className":"space-y-4","children":[["$","li","0",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":1}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Put every due date from all four into one calendar, in one sitting."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Four separate syllabi hide collisions. Three midterms in one week is a real and common situation, and it is only visible when the dates are in one place. Finding it in week one gives you a month to prepare; finding it in week seven does not."}]]}]]}],["$","li","1",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":2}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Find the grading breakdown and note what the largest single component is."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"If participation is 20%, missing class is expensive in a way the syllabus does not shout about. If one paper is 40%, that paper is the course. This tells you where to spend effort."}]]}]]}],["$","li","2",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":3}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Find the late policy and the attendance policy, and write them down."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"These are the two policies you will need under pressure, and that is exactly when you will not want to be searching a PDF. Knowing whether late work loses 10% or is refused outright changes what you do at 11pm."}]]}]]}],["$","li","3",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":4}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Find the instructor's office hours and put one in your calendar now."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Going once, early, while nothing is wrong makes the second visit — when something is wrong — enormously easier. Most students never go at all, and most instructors sit through empty office hours."}]]}]]}]]}],["$","p",null,{"className":"mt-5 pt-4 border-t border-primary-200 text-gray-800","children":[["$","span",null,{"className":"font-semibold","children":"Result: "}],"One calendar, four grading structures understood, two policies known, and one office hour booked."]}],["$","p",null,{"className":"mt-2 text-gray-900 font-medium","children":[["$","span",null,{"aria-hidden":"true","children":"🔑 "}],"The syllabus is not reading. It is a document you extract from, once, in week one."]}]]}]
1c:["$","$L20","6",{"block":{"type":"knowledge-check","question":"You are enrolled in 12 credits. Roughly how many hours a week should you plan for, in total?","options":["About 12 — that is what the credits mean","About 36 — twelve hours in class plus roughly two hours outside for each","About 20 — class time plus a few hours of homework","It depends entirely on the subject and cannot be estimated"],"correctIndex":1,"explanation":"The standard planning figure is two hours outside class for every hour in it. Twelve credits is therefore about 36 hours a week — close to a full-time job. Students who budget only for class time are working from a number nobody explained.","optionRationales":["Credit hours count class time only. The out-of-class expectation is separate and larger.","Correct. Twelve in class plus roughly twenty-four outside.","This underestimates by about half and is the assumption behind a lot of first-term trouble.","It does vary, but two-to-one is the standard planning figure and is far better than no estimate."]}}]
1d:["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mb-3","children":"Challenge"}],["$","p",null,{"className":"text-lg text-gray-600 leading-relaxed max-w-3xl","children":"Apply what you've learned in this lesson."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"Do this with real documents if you have them, or with sample syllabi if you do not."}],["$","ol","1",{"start":"$undefined","className":"list-decimal pl-6 space-y-3 text-gray-700 marker:font-semibold marker:text-primary-600","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Take every syllabus you have and build one calendar containing every due date, exam, and deadline. Note any week carrying more than one major item."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"For each course, write down the grading breakdown and circle the largest component."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Write out the late policy and attendance policy for each course in one sentence each."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"Calculate your realistic weekly hours: credits × 3. Compare that against the hours you actually have free after work and family commitments, and write down what you will do if the numbers do not fit."}]]}]]}]}]]}]

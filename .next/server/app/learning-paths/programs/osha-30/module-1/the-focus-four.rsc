1b:["$","figure","1",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Hazard"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Typical cause"}],["$","th","2",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Primary control"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Falls"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Unprotected edges, holes, improper ladder and scaffold use"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Guardrails, covers, personal fall arrest"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Struck-by"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Vehicles, falling objects, swinging loads"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"High-visibility clothing, hard hats, exclusion zones, toe boards"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Caught-in / between"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Trench collapse, unguarded machinery, pinch points"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Protective systems, machine guarding, lockout/tagout"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Electrocution"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Contact with power lines, damaged cords, missing grounding"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"De-energizing, GFCI, clearance distances, lockout/tagout"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"The Focus Four"}]]}]
1c:["$","div","2",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-blue-50 border-blue-400","children":[false,"Falls are the leading cause of death in construction, and the trigger height in construction is generally six feet above a lower level. General industry uses four feet. That difference matters and is commonly confused — verify the standard for the work you are actually doing rather than assuming one figure covers everything."]}]
1d:["$","p","3",{"className":"text-gray-700 leading-relaxed","children":"Trenching deserves specific mention because it kills quickly and the danger is not intuitive. A cubic yard of soil weighs roughly as much as a small car, and a collapse gives no warning and no time to escape. Protective systems — sloping, shoring, or shielding — are generally required at five feet, and a competent person must inspect the excavation daily and after any rain."}]
1e:["$","div","4",{"className":"rounded-xl border border-primary-200 bg-primary-50/50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-primary-700 mb-2","children":"Worked example"}],["$","h4",null,{"className":"text-lg font-bold text-gray-900 mb-1","children":"Assessing a work-at-height task"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-5","children":"You are asked to work on a flat roof eighteen feet up with an unprotected edge."}],["$","ol",null,{"className":"space-y-4","children":[["$","li","0",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":1}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Ask whether the fall hazard can be removed rather than protected against."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"The hierarchy of controls puts elimination first. Doing the work from the ground, or from a lift, removes the hazard entirely — which is always better than managing it. This question is skipped far too often."}]]}]]}],["$","li","1",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":2}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"If it cannot, check what protection is in place at the edge."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Guardrails protect everyone passively, with nothing to put on and nothing to remember. That makes them more reliable than equipment depending on each worker using it correctly every time."}]]}]]}],["$","li","2",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":3}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"If personal fall arrest is the answer, check the whole system, not the harness."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"A harness is one part. You need an anchor rated for the load, a lanyard or lifeline, and enough clearance below that you stop before hitting anything. A correctly worn harness with insufficient fall clearance does not save you."}]]}]]}],["$","li","3",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":4}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Inspect your equipment before every use."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Cuts, fraying, chemical damage, or evidence a component has already arrested a fall all mean the equipment is out of service. A harness that has taken a fall is discarded, not reused."}]]}]]}],["$","li","4",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":5}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"If protection is absent, stop and raise it."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"This is what the rights in the previous lesson are for. An unprotected leading edge at eighteen feet is a fatality waiting for a moment of inattention, and you are entitled to say so."}]]}]]}]]}],"$L23","$L24"]}]
1f:["$","$L25","5",{"block":{"type":"knowledge-check","question":"In construction, at what height does fall protection generally become required?","options":["Four feet","Six feet","Ten feet","Whenever the worker feels unsafe"],"correctIndex":1,"explanation":"Construction generally requires fall protection at six feet above a lower level. General industry uses four feet, which is why the two are often confused — check the standard that applies to the work being done.","optionRationales":["Four feet is the general industry trigger, not construction.","Correct for construction, with scaffolding and steel erection having their own provisions.","Ten feet is not a general trigger height.","Worker judgment is important, but the requirement is a defined height."]}}]

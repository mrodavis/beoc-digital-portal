-top leading-relaxed","children":"Where the work happens"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Termination area"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Returns traffic to normal"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"The parts of a traffic control zone"}]]}]
18:["$","div","3",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"The buffer space is deliberately empty and it is not storage. Parking a vehicle, stacking materials, or standing in it removes the margin that exists for a driver who is not paying attention. A buffer space being used for anything is one of the clearest signs a work zone is not being run correctly."]}]
19:["$","figure","4",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Item / signal"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Detail"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"STOP/SLOW paddle"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"The primary device. A red flag is for emergencies only"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"High-visibility apparel"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Class 2 or 3 depending on speed and conditions; Class 3 for night or high speed"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"To stop traffic"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Face traffic, hold the STOP face toward them, raise the free arm palm out"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"To let traffic proceed"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Show the SLOW face and motion with the free hand"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"To slow traffic"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Show SLOW and lower the free hand in a slowing motion"}]]}],["$","tr","5",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Escape route"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Planned before work starts — where you go if a vehicle does not stop"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"Standard flagging equipment and signals"}]]}]
1a:["$","div","5",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-blue-50 border-blue-400","children":[false,"Two things distinguish a safe flagger station: it is visible to approaching drivers with enough distance to stop, and it is never in the path of traffic. Stand on the shoulder or in a closed lane, not in a live one. And know your escape route before you need it — a flagger who has to decide where to go in the moment does not have time to decide."]}]
1b:["$","div","6",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"Flagger certification is a separate requirement from OSHA training, and most states require it. It is typically issued through an approved provider — ATSSA or a state DOT program are common — and usually carries an expiry. Completing OSHA 30 does not make you a certified flagger, and this coursework does not either."]}]
1c:["$","$L20","7",{"block":{"type":"knowledge-check","question":"What is the buffer space in a work zone for?","options":["Storing equipment and materials close to the work","Empty space giving an errant vehicle room to stop before it reaches workers","Parking for the work crew's vehicles","The area where the flagger stands"],"correctIndex":1,"explanation":"The buffer space exists specifically to be empty. It is the margin for a driver who does not slow or stop in time, and putting anything in it — vehicles, materials, or people — removes the protection it provides.","optionRationales":["Storing materials there defeats its entire purpose.","Correct. It is deliberately empty space.","Parking in the buffer removes the margin and creates a struck-by hazard.","The flagger station is positioned separately, out of the path of traffic."]}}]
1d:["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mb-3","children":"Challenge"}],["$","p",null,{"className":"text-lg text-gray-600 leading-relaxed max-w-3xl","children":"Apply what you've learned in this lesson."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"Traffic control is governed by published standards — work from them."}],["$","ol","1",{"start":"$undefined","className":"list-decimal pl-6 space-y-3 text-gray-700 marker:font-semibold marker:text-primary-600","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Find your state's flagger certification requirement: who issues it, what it costs, and how long it lasts."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"Look up the MUTCD taper length formula and calculate the required taper for a 45 mph road."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Find the high-visibility apparel class required for night work on a highway."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"Observe a real work zone from a safe distance and identify each of the five zones. Note anything that does not match the standard."}]]}]]}]}]]}]

1b:["$","p","1",{"className":"text-gray-700 leading-relaxed","children":"Days supply is total quantity divided by the amount taken per day. The arithmetic is simple; the errors come from misreading the sig. Two tablets twice daily is four per day, not two — and that single misreading halves or doubles the answer."}]
1c:["$","div","2",{"className":"rounded-xl border border-primary-200 bg-primary-50/50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-primary-700 mb-2","children":"Worked example"}],["$","h4",null,{"className":"text-lg font-bold text-gray-900 mb-1","children":"Days supply for a liquid"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-5","children":"Amoxicillin suspension, 250 mg/5 mL. Sig: 500 mg PO TID. Dispensed: 300 mL. How many days?"}],["$","ol",null,{"className":"space-y-4","children":[["$","li","0",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":1}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Convert the dose from mg to mL."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"The bottle is measured in mL and the dose is written in mg, so they must be brought to the same unit before anything else. 500 mg at 250 mg per 5 mL is 10 mL per dose."}]]}]]}],["$","li","1",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":2}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Calculate the daily volume."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"TID is three times daily, so 10 mL × 3 = 30 mL per day. This is the step where a misread frequency does its damage, so read the sig again here."}]]}]]}],["$","li","2",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":3}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Divide the quantity dispensed by the daily volume."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"300 mL ÷ 30 mL per day = 10 days."}]]}]]}],["$","li","3",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":4}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Sanity-check against the prescription's intent."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Ten days is a normal antibiotic course, so the answer is plausible. An answer of 100 days or 1.5 days would tell you a decimal went astray — and this check catches most calculation errors in about three seconds."}]]}]]}]]}],["$","p",null,{"className":"mt-5 pt-4 border-t border-primary-200 text-gray-800","children":[["$","span",null,{"className":"font-semibold","children":"Result: "}],"10 days supply."]}],["$","p",null,{"className":"mt-2 text-gray-900 font-medium","children":[["$","span",null,{"aria-hidden":"true","children":"🔑 "}],"Match the units first, then find the daily amount, then divide — and always ask whether the answer is a plausible course of therapy."]}]]}]

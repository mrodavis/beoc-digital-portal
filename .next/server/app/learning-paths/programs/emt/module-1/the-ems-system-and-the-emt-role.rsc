","aria-hidden":"true","children":"✓"}],["$","span",null,{"children":"Describe the certification pathway from course to licensure"}]]}],["$","li","3",{"className":"flex gap-3 text-gray-800 leading-relaxed","children":[["$","span",null,{"className":"flex-shrink-0 text-primary-600 font-bold","aria-hidden":"true","children":"✓"}],["$","span",null,{"children":"Identify the personal demands of the role honestly"}]]}]]}],false,false]}],"$undefined","$undefined",["$","div",null,{"className":"mb-12","children":["$","div",null,{"className":"inline-flex items-center gap-2 px-4 py-2 bg-blue-50 border border-blue-200 rounded-full text-blue-700 font-medium text-sm","children":"📘 Reading Lesson"}]}],["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Lesson Notes"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Read through the key concepts before you try the challenge."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-12","children":[["$","div","0",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Four levels, and the line between them is skills and supervision"}],["$","div",null,{"className":"space-y-6","children":[["$","div","0",{"className":"rounded-xl border border-amber-200 bg-amber-50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-amber-800 mb-2","children":"On the job"}],"$undefined",["$","p",null,{"className":"text-sm font-medium text-amber-900 mb-2","children":"You are considering EMT training."}],["$","p",null,{"className":"text-gray-800 leading-relaxed","children":"The job is described in recruitment material as fast-paced and rewarding. It is also physically hard, emotionally costly, often poorly paid at entry level, and involves shifts that end whenever the last call ends. All of that is true at once, and deciding well means knowing both halves."}],"$L1a"]}],"$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}]]}]]}]}]]}],false,false,"$L22",false,"$undefined","$L23","$L24"]}]

00 border-b border-gray-100 align-top leading-relaxed","children":"Contracted rates apply"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Out-of-network reduction or denial"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Copay, deductible, coinsurance"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"What to collect at the desk"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Uncollected patient balance"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Prior authorization requirements"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Whether approval is needed first"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"No authorization on file"}]]}],["$","tr","5",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Referral requirements"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Whether a referral is needed"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"No referral on file"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"What to verify, and why each matters"}]]}]
1d:["$","p","3",{"className":"text-gray-700 leading-relaxed","children":"Three things are commonly conflated and are genuinely different. Coverage means the plan includes this benefit. Authorization means the payer has approved this specific service in advance. Medical necessity means the service was appropriate for the patient's documented condition. A service can be covered, authorized, and still denied for medical necessity if the documentation does not support it."}]
1e:["$","div","4",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"An eligibility verification is not a guarantee of payment, and payers say so explicitly in their responses. It confirms coverage was active when you checked. The claim can still be denied for medical necessity, for a non-covered service, or because the patient's deductible absorbed the payment. Verification reduces risk substantially; it does not eliminate it, and telling a patient 'your insurance will cover this' overstates what you actually know."]}]
1f:["$","div","5",{"className":"rounded-xl border border-primary-200 bg-primary-50/50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-primary-700 mb-2","children":"Worked example"}],["$","h4",null,{"className":"text-lg font-bold text-gray-900 mb-1","children":"Handling a service Medicare may not cover"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-5","children":"A Medicare patient is scheduled for a service you believe Medicare will consider not reasonable and necessary."}],["$","ol",null,{"className":"space-y-4","children":[["$","li","0",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":1}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Confirm the likely non-coverage before the service, not after."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Check the applicable coverage determination. Discovering non-coverage after delivery means the practice either absorbs the cost or bills a patient who was never warned — and the second option is where complaints come from."}]]}]]}],["$","li","1",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":2}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Issue an Advance Beneficiary Notice of Noncoverage and have the patient sign it."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"The ABN is a specific CMS form telling the patient Medicare may not pay and that they may be responsible. Without it, you generally cannot bill the patient when Medicare denies. It must be given before the service and must state a genuine reason."}]]}]]}],["$","li","2",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":3}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Append modifier GA to the claim line."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"GA tells Medicare a signed waiver is on file. It is what preserves the practice's ability to bill the patient after the denial, and omitting it means the denial lands on the practice."}]]}]]}],["$","li","3",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":4}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Never issue blanket ABNs routinely to every patient."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Routine ABNs issued without a specific expectation of non-coverage are invalid, and CMS treats the practice as one. The form exists to inform a patient about a particular service, not to shift all risk onto patients as a matter of policy."}]]}]]}]]}],["$","p",null,{"className":"mt-5 pt-4 border-t border-primary-200 text-gray-800","children":[["$","span",null,{"className":"font-semibold","children":"Result: "}],"The patient is informed before the service, and the practice retains the right to bill them if Medicare denies."]}],["$","p",null,{"className":"mt-2 text-gray-900 font-medium","children":[["$","span",null,{"aria-hidden":"true","children":"🔑 "}],"The ABN protects the patient's right to decide and the practice's right to bill. It only works when it is specific, signed in advance, and flagged with modifier GA."]}]]}]
20:["$","$L24","6",{"block":{"type":"knowledge-check","question":"You verify eligibility and the payer confirms active coverage. The claim is later denied for medical necessity. What went wrong?","options":["The eligibility verification was performed incorrectly","Nothing about the verification — eligibility confirms coverage, not that a specific service was appropriate for the documented condition","The payer is obligated to pay, since coverage was confirmed","Prior authorization was obtained but not recorded"],"correctIndex":1,"explanation":"Eligibility, authorization, and medical necessity are three separate determinations. Confirming coverage was active says nothing about whether the documentation supports this particular service for this patient's condition. The next step is to review the documentation and consider an appeal.","optionRationales":["The verification did what it does. It was never a medical necessity determination.","Correct. Coverage, authorization, and medical necessity are separate questions.","Payer responses explicitly state that verification is not a guarantee of payment.","Authorization is also separate from medical necessity — an authorized service can still be denied on necessity grounds."]}}]
21:["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Challenge"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Apply what you've learned in this lesson."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"Build the front-end process that prevents the denials you costed in Module 1."}],["$","ol","1",{"start":"$undefined","className":"list-decimal pl-6 space-y-3 text-gray-700 marker:font-semibold marker:text-primary-600","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Write a front-desk verification checklist covering every item in the table above, formatted so someone could work through it in ninety seconds."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"Research the CMS ABN form (CMS-R-131). Note the three things the form must state to be valid."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Explain in three sentences the difference between coverage, authorization, and medical necessity, using an example of a service that could fail each one."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"Given 61 eligibility denials and 29 authorization denials last month, write a two-paragraph recommendation to the practice manager naming what you would change and how you would measure it."}]]}]]}]}]]}]

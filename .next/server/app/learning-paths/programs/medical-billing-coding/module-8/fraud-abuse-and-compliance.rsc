0 align-top leading-relaxed","children":"Billing a mid-level provider's service under a physician's NPI improperly"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Cloned documentation"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Identical notes across encounters, suggesting they do not reflect real visits"}]]}],["$","tr","5",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Routine waiver of copays"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Systematically not collecting patient responsibility"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"Patterns that draw scrutiny"}]]}]
1b:["$","div","5",{"className":"rounded-xl border border-primary-200 bg-primary-50/50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-primary-700 mb-2","children":"Worked example"}],["$","h4",null,{"className":"text-lg font-bold text-gray-900 mb-1","children":"When you are asked to code something unsupportable"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-5","children":"Respond to a provider's request to change a 99213 to a 99215 on documentation that does not support it."}],["$","ol",null,{"className":"space-y-4","children":[["$","li","0",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":1}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Assume good faith and treat it as a documentation question first."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Providers are often genuinely unaware of what the level requires, and the visit may well have involved work that was simply not written down. Framing it as 'the note does not currently support 99215 — was there more?' opens the legitimate route rather than starting a confrontation."}]]}]]}],["$","li","1",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":2}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Offer the proper mechanism: amend the documentation."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"If the work genuinely occurred, the provider may amend the note through the record's amendment process, with the amendment dated and attributed. A properly amended note supporting the higher level makes the higher code correct. This is the real solution, and it is available."}]]}]]}],["$","li","2",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":3}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"If the answer is that the work did not occur, decline clearly and without hostility."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"'I can't code above what the documentation supports' is a complete answer. You are not accusing anyone; you are stating the rule you work by. Most requests end here."}]]}]]}],["$","li","3",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":4}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"If pressed, escalate through the compliance process rather than deciding alone."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Every practice should have a compliance officer or designated escalation route. Using it protects the practice, the provider, and you — and creates a record that you raised it, which matters a great deal if the pattern is later investigated."}]]}]]}],["$","li","4",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":5}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Document what was asked and what you did."}],"$L21"]}]]}]]}],"$L22","$L23"]}]
1c:["$","div","6",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"Following instructions is not a defence. A coder who submits a claim they know the documentation does not support has knowingly participated in submitting a false claim, regardless of who directed it. The False Claims Act also has whistleblower provisions, meaning colleagues have both protection and financial incentive to report. Your signature on the work is yours."]}]
1d:["$","$L24","7",{"block":{"type":"knowledge-check","question":"A provider directs you to bill a level of service the documentation does not support. You comply. What is your position?","options":["Protected, since you were following a supervisor's direction","Exposed — knowingly submitting a claim the documentation does not support is participating in a false claim, whoever directed it","Responsible only if the payer detects it","Not responsible, since the provider is accountable for the documentation"],"correctIndex":1,"explanation":"Liability under the False Claims Act attaches to knowingly submitting a false claim. A coder who understands the rules and submits anyway has the requisite knowledge, and direction from a supervisor does not remove it. The correct response is to offer the amendment route and escalate through compliance.","optionRationales":["Following orders is not a recognized defence to knowingly submitting a false claim.","Correct. Knowledge is what creates exposure, and you had it.","Liability arises from the submission, not from whether it is caught.","The provider is accountable for documentation, and the coder is accountable for coding to it. Both are exposed."]}}]
1e:["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mb-3","children":"Challenge"}],["$","p",null,{"className":"text-lg text-gray-600 leading-relaxed max-w-3xl","children":"Apply what you've learned in this lesson."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"Know the process before you need it."}],["$","ol","1",{"start":"$undefined","className":"list-decimal pl-6 space-y-3 text-gray-700 marker:font-semibold marker:text-primary-600","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Research the seven elements of an effective compliance program as described by the OIG. Summarize each in one sentence."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"Find the OIG exclusion list (LEIE) and describe what it is used for and how often a practice should check it."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Write out, word for word, what you would say to a provider asking you to code above the documentation. Keep it to three sentences and make it non-confrontational."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"Describe the escalation path you would follow if the request were repeated after you declined, and what you would document at each step."}]]}]]}]}]]}]

16:["$","p",null,{"className":"mt-3 pt-3 border-t border-amber-200 text-gray-900","children":[["$","span",null,{"className":"font-semibold","children":"Your task: "}],"Understand what you are handling and the rules that govern it."]}]
17:["$","p","1",{"className":"text-gray-700 leading-relaxed","children":"Protected health information is individually identifiable health information held or transmitted by a covered entity. Billing data is squarely within it — a claim links a person to a diagnosis, which is exactly the kind of association the rules exist to protect."}]
18:["$","p","2",{"className":"text-gray-700 leading-relaxed","children":"HIPAA permits disclosure without patient authorization for treatment, payment, and health care operations. Billing sits in the payment category, which is why you may send a claim carrying a diagnosis to a payer. That permission is specific, not general: it covers what payment requires and nothing beyond it."}]
19:["$","figure","3",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Situation"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Appropriate"}],["$","th","2",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Not appropriate"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Submitting a claim"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"The codes and identifiers the claim requires"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"The complete clinical record attached by default"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Responding to a payer records request"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Records for the dates and services in question"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"The entire chart because it is easier to send"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Discussing an account with a colleague"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"What they need to resolve the issue"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Details unrelated to the question"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Looking up a record"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Accounts you are assigned to work"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"A neighbour's or coworker's record out of curiosity"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"The minimum necessary standard in practice"}]]}]
1a:["$","div","4",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"Accessing a record you have no work reason to see is a violation even if you tell no one and change nothing. Access is logged, audits are routine, and curiosity about a coworker's, neighbour's, or public figure's record is among the most common causes of termination in healthcare administration. There is no version of this that is harmless."]}]
1b:["$","p","5",{"className":"text-gray-700 leading-relaxed","children":"A breach is an impermissible use or disclosure that compromises the security or privacy of protected health information. Emailing a claim to the wrong address, leaving a report on a printer, discussing an account where it can be overheard, and losing an unencrypted device all qualify. Report a suspected breach immediately to your privacy officer — the reporting obligation has deadlines, and delay makes every outcome worse."}]
1c:["$","$L20","6",{"block":{"type":"knowledge-check","question":"A payer requests records to support one claim for a single date of service. What should be sent?","options":["The complete patient chart, so the reviewer has full context","Only the records for the date of service and the services at issue","Nothing without written patient authorization","A summary written by the biller rather than the actual records"],"correctIndex":1,"explanation":"The minimum necessary standard limits disclosure to what the purpose requires. The purpose is supporting one claim, so records for that date and those services are appropriate. Sending the whole chart discloses far more than the payer needs or is entitled to.","optionRationales":["Sending the full chart exceeds minimum necessary and discloses unrelated information.","Correct. Disclose what the specific purpose requires and no more.","Disclosure for payment purposes does not require separate patient authorization.","A biller's summary is not the medical record and cannot substitute for it in a payer review."]}}]
1d:["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mb-3","children":"Challenge"}],["$","p",null,{"className":"text-lg text-gray-600 leading-relaxed max-w-3xl","children":"Apply what you've learned in this lesson."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"Apply the standard to situations you will actually face."}],["$","ol","1",{"start":"$undefined","className":"list-decimal pl-6 space-y-3 text-gray-700 marker:font-semibold marker:text-primary-600","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"List the eighteen HIPAA identifiers. Note which ones appear on a routine claim."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"For each of these, decide whether it is a breach and justify it: a claim emailed to the wrong payer address; a report left on a shared printer overnight; discussing an account with the treating provider; looking up a coworker's balance out of concern for them."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Write a three-sentence description of the minimum necessary standard as you would explain it to a new colleague."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"Find your organization's or a sample breach reporting procedure. Note who to contact and within what timeframe."}]]}]]}]}]]}]

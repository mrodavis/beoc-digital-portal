1d:["$","p","3",{"className":"text-gray-700 leading-relaxed","children":"Most payers offer several levels of appeal, each with its own deadline. A first-level appeal is typically an internal reconsideration. A second level may involve a different reviewer or a peer-to-peer discussion with a physician. Some plans, and Medicare in particular, provide independent external review beyond that. Each level has a window, and missing one usually forecloses the rest."}]
1e:["$","figure","4",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Bucket"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Interpretation"}],["$","th","2",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Action"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"0-30 days"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Normal processing"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Monitor only"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"31-60 days"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Slower than expected"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Check status; confirm the payer received it"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"61-90 days"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Something is wrong"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Work actively; a denial may have gone unnoticed"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"91-120 days"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Recovery becoming unlikely"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Escalate; check filing and appeal deadlines"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"120+ days"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Often uncollectible"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Determine whether to pursue or write off"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"Reading an A/R aging report"}]]}]
1f:["$","div","5",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"Writing off a balance is a decision with rules, not a way to clear a queue. A contractual adjustment is required by the payer contract. A bad debt write-off follows genuine collection effort. Writing off a collectible balance to tidy the aging report misstates the practice's revenue, and routinely waiving patient responsibility that a plan requires you to collect can violate your payer contracts and, for federal programs, implicate the anti-kickback statute. Write-offs should follow a written policy and be approved, not made ad hoc by whoever is working the queue."]}]
20:["$","$L24","6",{"block":{"type":"knowledge-check","question":"A first-level appeal on a medical necessity denial is upheld. The documentation genuinely supports the service. What is the appropriate next step?","options":["Write the balance off, since the payer has now refused twice","Escalate to the next level of appeal within its deadline, adding any evidence the first appeal lacked","Bill the patient for the full amount","Resubmit the original claim unchanged"],"correctIndex":1,"explanation":"A first-level denial is not the end of the process. Most payers provide further levels, often including peer-to-peer review, and each has its own deadline. If the documentation supports the service, escalating with a strengthened argument is the correct route.","optionRationales":["Writing off a supportable claim forfeits revenue the practice legitimately earned.","Correct. Escalate within the deadline and strengthen the evidence.","The patient is not responsible for a payer's medical necessity determination, and billing them may breach the payer contract.","Resubmitting unchanged produces the same denial or a duplicate rejection, while the appeal window runs out."]}}]
21:["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Challenge"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Apply what you've learned in this lesson."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"Write a real appeal and read a real aging report."}],["$","ol","1",{"start":"$undefined","className":"list-decimal pl-6 space-y-3 text-gray-700 marker:font-semibold marker:text-primary-600","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Write a complete appeal letter using the five-section structure, for a medical necessity denial on a service you invent. Keep it to one page."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"Research the appeal levels one major payer offers, and note the deadline for each."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Given total A/R of $412,000 with $94,000 over 90 days, calculate the percentage over 90 days and state whether it falls inside a 15-20% target."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"Draft a short write-off policy naming who may approve a write-off, what documentation is required, and which categories are eligible."}]]}]]}]}]]}]

700 border-b border-gray-100 align-top leading-relaxed","children":"Medical necessity"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Documentation does not support the service"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Appeal with records if the documentation does support it; otherwise the denial stands"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Bundling / NCCI edit"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Two codes should not be billed together"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Review whether a modifier is genuinely warranted. Do not add one reflexively"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Duplicate claim"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Payer already has this claim"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Check status before resubmitting — usually the original is still processing"}]]}],["$","tr","5",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Timely filing"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Submitted past the deadline"}],"$L1f"]}],"$L20"]}]]}]}],"$L21"]}]
19:["$","div","3",{"className":"rounded-xl border border-primary-200 bg-primary-50/50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-primary-700 mb-2","children":"Worked example"}],["$","h4",null,{"className":"text-lg font-bold text-gray-900 mb-1","children":"Prioritizing a 138-claim denial queue"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-5","children":"Decide the order to work $47,000 of denials with limited staff time."}],["$","ol",null,{"className":"space-y-4","children":[["$","li","0",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":1}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Sort by days remaining until the appeal or filing deadline."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Deadlines are absolute. A $3,000 claim five days from its appeal window is worth more attention today than a $3,000 claim with ninety days left, because one becomes worthless on a known date and the other does not."}]]}]]}],["$","li","1",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":2}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Within that, sort by dollar value."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Staff time is the constraint. Ten minutes recovering $2,400 is a better use of it than ten minutes recovering $40 — and the small-dollar denials are usually the ones a practice should be preventing rather than working."}]]}]]}],["$","li","2",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":3}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Set aside the categories with no realistic recovery."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Eligibility denials where coverage genuinely was not active, and timely filing denials caused by the practice, will not be paid. Working them feels productive and recovers nothing. Route them to patient billing or write-off and spend the time where recovery is possible."}]]}]]}],["$","li","3",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":4}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Group the remainder by reason code and look for patterns."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Twenty-nine authorization denials are not twenty-nine problems; they are one process problem twenty-nine times. Fixing the front-end process stops the thirtieth, which is worth more than recovering any single claim."}]]}]]}],["$","li","4",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":5}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Report the pattern, not just the recovery total."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"'We recovered $18,000' is an outcome. 'We recovered $18,000, and 29 denials came from one gap in the authorization process that I have proposed fixing' is an outcome plus a prevention — and the second is what changes next month's numbers."}]]}]]}]]}],"$L22","$L23"]}]
1a:["$","div","4",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"Never resubmit an identical claim in response to a denial. The payer has already adjudicated it and will return the same decision, or reject it as a duplicate — while the appeal window continues to run. A denial requires a corrected claim, marked as such, or a formal appeal. Resubmitting is the most common way a recoverable denial becomes unrecoverable."]}]
1b:["$","$L24","5",{"block":{"type":"knowledge-check","question":"You have 138 denials of varying value and deadline. What should determine the order you work them?","options":["Oldest first, so nothing sits too long","Deadline proximity first, then dollar value, setting aside categories with no realistic recovery","Smallest first, to reduce the claim count quickly","Alphabetically by payer, to batch phone calls"],"correctIndex":1,"explanation":"Deadlines are absolute — a claim past its appeal window is worth nothing regardless of value. Within that constraint, dollar value determines where limited staff time returns the most. Categories that cannot realistically be recovered should be routed rather than worked.","optionRationales":["Age correlates loosely with deadline but ignores value entirely, and some old denials are already unrecoverable.","Correct. Deadline, then value, with unrecoverable categories set aside.","Reducing the count feels productive but leaves the largest recoverable balances at risk.","Batching calls by payer helps efficiency but should operate within a deadline-and-value ordering, not replace it."]}}]
1c:["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mb-3","children":"Challenge"}],["$","p",null,{"className":"text-lg text-gray-600 leading-relaxed max-w-3xl","children":"Apply what you've learned in this lesson."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"Practice triage, which is most of what denial work actually is."}],["$","ol","1",{"start":"$undefined","className":"list-decimal pl-6 space-y-3 text-gray-700 marker:font-semibold marker:text-primary-600","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Research CARC and RARC code sets. Find the codes for medical necessity, no authorization, and timely filing."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"Given these denials — $2,400 medical necessity with 8 days left to appeal; $180 eligibility with 60 days; $3,100 no authorization with 45 days; $95 timely filing — rank them and justify each position."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Write an appeal letter for the medical necessity denial. State the claim, the denial reason, why the documentation supports the service, and what you are asking for."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"For the same month's denial mix, name the single process change you would recommend and estimate what it would prevent."}]]}]]}]}]]}]

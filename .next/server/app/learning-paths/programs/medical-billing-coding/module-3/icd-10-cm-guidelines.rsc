1e:["$","li","1",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":2}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Confirm both conditions are documented independently."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Excludes2 permits both codes; it does not require them. You still need documentation supporting each condition separately. Coding a second condition because the note allows it, without documentation, is unsupported coding."}]]}]]}]
1f:["$","li","2",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":3}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Report both codes, sequencing by the reason for the encounter."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"The condition chiefly responsible for the visit is listed first. Sequence is not cosmetic — it drives medical necessity determinations and can affect payment and quality reporting."}]]}]]}]
20:["$","li","3",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":4}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"If it had been Excludes1, choose the single code the documentation supports and query if genuinely ambiguous."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Excludes1 means the code set asserts these cannot coexist. Reporting both is a definite rejection. When the documentation truly seems to describe both, that is a question for the provider rather than a coding judgment."}]]}]]}]

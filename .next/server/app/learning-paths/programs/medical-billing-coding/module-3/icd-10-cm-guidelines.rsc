ame":"flex-shrink-0 text-primary-600 font-bold","aria-hidden":"true","children":"✓"}],["$","span",null,{"children":"Sequence a principal or first-listed diagnosis appropriately"}]]}],["$","li","3",{"className":"flex gap-3 text-gray-800 leading-relaxed","children":[["$","span",null,{"className":"flex-shrink-0 text-primary-600 font-bold","aria-hidden":"true","children":"✓"}],["$","span",null,{"children":"Explain why signs and symptoms are not coded alongside a confirmed diagnosis"}]]}]]}]]}],"$undefined","$undefined",["$","div",null,{"className":"mb-12","children":["$","div",null,{"className":"inline-flex items-center gap-2 px-4 py-2 bg-blue-50 border border-blue-200 rounded-full text-blue-700 font-medium text-sm","children":"📘 Reading Lesson"}]}],["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mb-3","children":"Lesson Notes"}],["$","p",null,{"className":"text-lg text-gray-600 leading-relaxed max-w-3xl","children":"Read through the key concepts before you try the challenge."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-12","children":[["$","div","0",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Never code from the index alone"}],["$","div",null,{"className":"space-y-6","children":[["$","div","0",{"className":"rounded-xl border border-amber-200 bg-amber-50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-amber-800 mb-2","children":"On the job"}],"$undefined",["$","p",null,{"className":"text-sm font-medium text-amber-900 mb-2","children":"You are coding under time pressure at Lakeside Medical Associates."}],["$","p",null,{"className":"text-gray-800 leading-relaxed","children":"You look up 'bronchitis' in the Alphabetic Index, find a code, and submit it. It is denied. Had you turned to that code in the Tabular List, you would have seen an instructional note requiring an additional code, and an Excludes1 note that ruled out the code you chose given the patient's documented condition."}],"$L16"]}],"$L17","$L18"]}]]}],"$L19","$L1a"]}]}]]}],false,"$L1b","$undefined","$L1c","$L1d"]}]

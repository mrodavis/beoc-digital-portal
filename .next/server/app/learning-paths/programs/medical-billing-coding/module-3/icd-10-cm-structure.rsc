20:["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"The 7th character must sit in the 7th position. If the code has only five characters before it, X is inserted as a placeholder so the extension lands correctly. A 7th character in the wrong position produces an invalid code."}]
21:["$","p",null,{"className":"mt-5 pt-4 border-t border-primary-200 text-gray-800","children":[["$","span",null,{"className":"font-semibold","children":"Result: "}],"A complete, billable code specifying the bone, the site on that bone, the fracture type, the side, and the encounter type."]}]
22:["$","p",null,{"className":"mt-2 text-gray-900 font-medium","children":[["$","span",null,{"aria-hidden":"true","children":"🔑 "}],"Build from the category outward and check every axis the code set offers — site, type, laterality, encounter. A code that stops short of available specificity is incomplete."]}]

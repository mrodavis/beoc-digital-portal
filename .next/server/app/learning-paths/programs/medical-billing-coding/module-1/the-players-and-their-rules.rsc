17:["$","p","1",{"className":"text-gray-700 leading-relaxed","children":"Healthcare billing is unusual because the person receiving the service is usually not the person paying for it, and the price is set by a contract neither of them read. Untangling that is most of what makes a bill confusing, and being able to explain it plainly is one of the most valuable things a billing specialist does."}]
18:["$","div","2",{"className":"rounded-xl border border-gray-200 bg-white p-6","children":[["$","h4",null,{"className":"text-sm font-semibold uppercase tracking-wide text-gray-500 mb-4","children":"Key terms"}],["$","dl",null,{"className":"space-y-3","children":[["$","div","0",{"className":"sm:flex sm:gap-4","children":[["$","dt",null,{"className":"font-semibold text-gray-900 sm:w-48 sm:flex-shrink-0","children":"Billed amount"}],["$","dd",null,{"className":"text-gray-700 leading-relaxed","children":"What the practice charges. Largely a starting figure — for contracted payers it is rarely what anyone actually pays."}]]}],["$","div","1",{"className":"sm:flex sm:gap-4","children":[["$","dt",null,{"className":"font-semibold text-gray-900 sm:w-48 sm:flex-shrink-0","children":"Allowed amount"}],["$","dd",null,{"className":"text-gray-700 leading-relaxed","children":"The maximum the payer's contract permits for that service. This is the real price."}]]}],["$","div","2",{"className":"sm:flex sm:gap-4","children":[["$","dt",null,{"className":"font-semibold text-gray-900 sm:w-48 sm:flex-shrink-0","children":"Contractual adjustment"}],["$","dd",null,{"className":"text-gray-700 leading-relaxed","children":"The difference between billed and allowed, which an in-network provider agrees to write off and may not bill to the patient."}]]}],["$","div","3",{"className":"sm:flex sm:gap-4","children":[["$","dt",null,{"className":"font-semibold text-gray-900 sm:w-48 sm:flex-shrink-0","children":"Deductible"}],["$","dd",null,{"className":"text-gray-700 leading-relaxed","children":"What the patient pays before the plan begins paying at all, usually reset each plan year."}]]}],["$","div","4",{"className":"sm:flex sm:gap-4","children":[["$","dt",null,{"className":"font-semibold text-gray-900 sm:w-48 sm:flex-shrink-0","children":"Copayment"}],["$","dd",null,{"className":"text-gray-700 leading-relaxed","children":"A fixed amount the patient pays per visit, such as $30 for an office visit."}]]}],["$","div","5",{"className":"sm:flex sm:gap-4","children":[["$","dt",null,{"className":"font-semibold text-gray-900 sm:w-48 sm:flex-shrink-0","children":"Coinsurance"}],["$","dd",null,{"className":"text-gray-700 leading-relaxed","children":"A percentage of the allowed amount the patient pays after the deductible, such as 20%."}]]}],["$","div","6",{"className":"sm:flex sm:gap-4","children":[["$","dt",null,{"className":"font-semibold text-gray-900 sm:w-48 sm:flex-shrink-0","children":"Out-of-pocket maximum"}],["$","dd",null,{"className":"text-gray-700 leading-relaxed","children":"The annual ceiling on the patient's own spending, after which the plan covers 100% of covered services."}]]}]]}]]}]
19:["$","div","3",{"className":"rounded-xl border border-primary-200 bg-primary-50/50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-primary-700 mb-2","children":"Worked example"}],["$","h4",null,{"className":"text-lg font-bold text-gray-900 mb-1","children":"Explaining the four numbers"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-5","children":"Explain to the patient why a $340 charge produced a $37.20 bill, and confirm whether she was overcharged."}],["$","ol",null,{"className":"space-y-4","children":[["$","li","0",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":1}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Start with the allowed amount, not the billed amount."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"The $340 is the practice's standard charge, but the insurer's contract sets the allowed amount at $186. That contract is what governs. Leading with this reframes the conversation from 'why so much' to 'here is what your plan agreed to.'"}]]}]]}],["$","li","1",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":2}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Name the contractual adjustment: $340 − $186 = $154 written off."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"This is money the practice does not collect from anyone. Patients frequently assume they are being billed the full charge, and hearing that $154 was removed by the insurance contract usually resolves most of the concern immediately."}]]}]]}],["$","li","2",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":3}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Split the allowed amount: plan pays $148.80, patient owes $37.20."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"$$37.20 is exactly 20% of $186, so this is 20% coinsurance on a met deductible. Naming the mechanism lets the patient check it against their own plan documents rather than taking your word for it."}]]}]]}],["$","li","3",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":4}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Confirm the answer to what she actually asked."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"She asked whether she was overcharged. The answer is no, and saying so directly matters — walking through arithmetic without answering the question leaves the patient still worried. Then offer to review it again if her plan documents show different cost-sharing."}]]}]]}]]}],["$","p",null,{"className":"mt-5 pt-4 border-t border-primary-200 text-gray-800","children":[["$","span",null,{"className":"font-semibold","children":"Result: "}],"The patient understands the $37.20 is her plan's 20% coinsurance on a contracted rate, and that $154 was written off."]}],["$","p",null,{"className":"mt-2 text-gray-900 font-medium","children":[["$","span",null,{"aria-hidden":"true","children":"🔑 "}],"The allowed amount is the real price. Explain the contractual adjustment early — it is usually the number that resolves the patient's concern."]}]]}]

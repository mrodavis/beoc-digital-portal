e":"flex-shrink-0 text-primary-600 font-bold","aria-hidden":"true","children":"✓"}],["$","span",null,{"children":"Name the parties involved in a healthcare transaction and what each one wants"}]]}],["$","li","3",{"className":"flex gap-3 text-gray-800 leading-relaxed","children":[["$","span",null,{"className":"flex-shrink-0 text-primary-600 font-bold","aria-hidden":"true","children":"✓"}],["$","span",null,{"children":"Explain why coding accuracy is a compliance issue and not only a payment issue"}]]}]]}]]}],"$undefined","$undefined",["$","div",null,{"className":"mb-12","children":["$","div",null,{"className":"inline-flex items-center gap-2 px-4 py-2 bg-blue-50 border border-blue-200 rounded-full text-blue-700 font-medium text-sm","children":"📘 Reading Lesson"}]}],["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mb-3","children":"Lesson Notes"}],["$","p",null,{"className":"text-lg text-gray-600 leading-relaxed max-w-3xl","children":"Read through the key concepts before you try the challenge."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-12","children":[["$","div","0",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Two jobs, one title"}],["$","div",null,{"className":"space-y-6","children":[["$","div","0",{"className":"rounded-xl border border-amber-200 bg-amber-50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-amber-800 mb-2","children":"On the job"}],"$undefined",["$","p",null,{"className":"text-sm font-medium text-amber-900 mb-2","children":"You are starting as a billing specialist at Lakeside Medical Associates."}],["$","p",null,{"className":"text-gray-800 leading-relaxed","children":"A patient sees Dr. Okafor for persistent knee pain. The visit lasts twenty minutes, the provider examines the knee, orders an X-ray, and diagnoses osteoarthritis. Clinically the encounter is finished. Financially nothing has happened at all — and unless someone translates that visit into a specific set of codes and sends it to the right payer in the right format within the right window, the practice will never be paid for it."}],"$L16"]}],"$L17","$L18","$L19"]}]]}],"$L1a","$L1b"]}]}]]}],false,"$L1c","$undefined","$L1d","$L1e"]}]

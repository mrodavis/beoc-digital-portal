1a:["$","div","4",{"className":"rounded-xl border border-gray-200 bg-white p-6","children":[["$","h4",null,{"className":"text-sm font-semibold uppercase tracking-wide text-gray-500 mb-4","children":"Key terms"}],["$","dl",null,{"className":"space-y-3","children":[["$","div","0",{"className":"sm:flex sm:gap-4","children":[["$","dt",null,{"className":"font-semibold text-gray-900 sm:w-48 sm:flex-shrink-0","children":"Rejection"}],["$","dd",null,{"className":"text-gray-700 leading-relaxed","children":"The claim failed a format or data check and never entered adjudication. It is corrected and resubmitted as a new claim — not appealed."}]]}],["$","div","1",{"className":"sm:flex sm:gap-4","children":[["$","dt",null,{"className":"font-semibold text-gray-900 sm:w-48 sm:flex-shrink-0","children":"Denial"}],["$","dd",null,{"className":"text-gray-700 leading-relaxed","children":"The claim was adjudicated and the payer decided not to pay. This is appealed, not resubmitted."}]]}],["$","div","2",{"className":"sm:flex sm:gap-4","children":[["$","dt",null,{"className":"font-semibold text-gray-900 sm:w-48 sm:flex-shrink-0","children":"Clean claim"}],["$","dd",null,{"className":"text-gray-700 leading-relaxed","children":"A claim with no defects requiring the payer to seek more information. It starts the payer's payment clock."}]]}],["$","div","3",{"className":"sm:flex sm:gap-4","children":[["$","dt",null,{"className":"font-semibold text-gray-900 sm:w-48 sm:flex-shrink-0","children":"Clearinghouse"}],["$","dd",null,{"className":"text-gray-700 leading-relaxed","children":"An intermediary that validates claims against payer rules and routes them. Its edits catch problems before the payer sees them."}]]}],["$","div","4",{"className":"sm:flex sm:gap-4","children":[["$","dt",null,{"className":"font-semibold text-gray-900 sm:w-48 sm:flex-shrink-0","children":"NPI"}],["$","dd",null,{"className":"text-gray-700 leading-relaxed","children":"National Provider Identifier — a ten-digit number ident
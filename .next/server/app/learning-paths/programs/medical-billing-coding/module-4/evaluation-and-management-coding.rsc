{"className":"flex-shrink-0 text-primary-600 font-bold","aria-hidden":"true","children":"✓"}],["$","span",null,{"children":"Select a level using total time on the date of the encounter"}]]}],["$","li","3",{"className":"flex gap-3 text-gray-800 leading-relaxed","children":[["$","span",null,{"className":"flex-shrink-0 text-primary-600 font-bold","aria-hidden":"true","children":"✓"}],["$","span",null,{"children":"Distinguish new from established patients"}]]}]]}]]}],"$undefined","$undefined",["$","div",null,{"className":"mb-12","children":["$","div",null,{"className":"inline-flex items-center gap-2 px-4 py-2 bg-blue-50 border border-blue-200 rounded-full text-blue-700 font-medium text-sm","children":"📘 Reading Lesson"}]}],["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mb-3","children":"Lesson Notes"}],["$","p",null,{"className":"text-lg text-gray-600 leading-relaxed max-w-3xl","children":"Read through the key concepts before you try the challenge."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-12","children":[["$","div","0",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"The most-billed codes in outpatient medicine"}],["$","div",null,{"className":"space-y-6","children":[["$","div","0",{"className":"rounded-xl border border-amber-200 bg-amber-50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-amber-800 mb-2","children":"On the job"}],"$undefined",["$","p",null,{"className":"text-sm font-medium text-amber-900 mb-2","children":"You code a primary care day at Lakeside Medical Associates."}],["$","p",null,{"className":"text-gray-800 leading-relaxed","children":"Twenty-two of the day's twenty-four encounters are office visits. Each needs a level assigned — and the level determines payment, so a practice that systematically codes one level too low leaves substantial revenue uncollected, while one that codes too high is submitting false claims."}],"$L16"]}],"$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f"]}]]}]]}]}]]}],false,"$L20","$undefined","$L21","$L22"]}]

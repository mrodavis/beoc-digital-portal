17:["$","p","1",{"className":"text-gray-700 leading-relaxed","children":"Every worker asks for clarification, in every language. What changes is confidence, not need. The phrases below are ordinary professional English — they do not mark you as a learner, and coworkers use them constantly."}]
18:["$","figure","2",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Say"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"When"}],["$","th","2",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Why it works"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Could you say that again, please?"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"You missed it entirely"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Direct and completely normal"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Sorry, I didn't catch the last part."}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"You got most of it"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Shows you were listening and narrows what they repeat"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Do you mean [X] or [Y]?"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"You heard it but it could mean two things"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Gets a one-word answer instead of a repeat"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Let me make sure I have this right — you want me to…"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"It matters that you get it right"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Confirms understanding and catches errors before they happen"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Could you spell that for me?"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"A name, a medication, an address"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Expected and appreciated for anything written down"}]]}],["$","tr","5",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Could you write that down?"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Numbers, times, or several steps"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Reasonable to ask; nobody thinks less of you"}]]}]]}]]}]}],"$L1f"]}]
19:["$","div","3",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-blue-50 border-blue-400","children":[false,"The fourth phrase — 'Let me make sure I have this right' — is the most useful one in the table, and native speakers use it constantly. It is not a sign you did not understand; it is what careful people do before starting something that matters. In healthcare it is called a read-back, and it is required rather than optional."]}]
1a:["$","div","4",{"className":"rounded-xl border border-primary-200 bg-primary-50/50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-primary-700 mb-2","children":"Worked example"}],["$","h4",null,{"className":"text-lg font-bold text-gray-900 mb-1","children":"Reporting a problem to a supervisor"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-5","children":"A machine on your line has stopped and you need to tell your supervisor."}],["$","ol",null,{"className":"space-y-4","children":[["$","li","0",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":1}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Say what is wrong first, in one sentence."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"English workplace reporting puts the main point first, not last. This is genuinely different from many languages, where context comes first and the point arrives at the end — and a supervisor who is busy may stop listening before you reach it."}]]}]]}],["$","li","1",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":2}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Then say what you did about it."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"'The machine on line two stopped. I turned it off and told the others to wait' tells them the situation is contained. It answers the question they were about to ask."}]]}]]}],["$","li","2",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":3}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Then say what you need from them."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"'Do you want me to call maintenance, or will you?' A report with no request leaves them to work out what you want, and that is the part most likely to be misread."}]]}]]}],["$","li","3",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":4}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"If they respond quickly and you miss it, say so immediately."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"'Sorry — call maintenance, or wait for you?' Confirming now costs five seconds. Guessing costs the whole task, and the supervisor would far rather be asked."}]]}]]}]]}],["$","p",null,{"className":"mt-5 pt-4 border-t border-primary-200 text-gray-800","children":[["$","span",null,{"className":"font-semibold","children":"Result: "}],"Three short sentences that tell the supervisor what happened, what you did, and what you need."]}],["$","p",null,{"className":"mt-2 text-gray-900 font-medium","children":[["$","span",null,{"aria-hidden":"true","children":"🔑 "}],"Problem, action, request — in that order. English puts the point first."]}]]}]
1b:["$","$L20","5",{"block":{"type":"knowledge-check","question":"Your supervisor gives you a three-step instruction and you only catch the first two. What is the best thing to say?","options":["Nothing — start the task and work out the third step later","\"Sorry, I didn't catch the last part — could you repeat that?\"","\"I don't understand English very well.\"","\"Yes, okay\" — and ask a coworker afterwards"],"correctIndex":1,"explanation":"It is specific, so the supervisor repeats only the part you need rather than everything. It is also completely ordinary professional English — coworkers who grew up speaking English say exactly this several times a week.","optionRationales":["Starting without the third step means doing it wrong and fixing it later, which costs more than asking.","Correct. Specific, normal, and it gets you exactly the part you missed.","This makes the conversation about your English rather than about the task, and it is not what the supervisor needs to know.","Agreeing when you have not understood is the habit that causes the most trouble at work, and the coworker may be wrong."]}}]
1c:["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mb-3","children":"Challenge"}],["$","p",null,{"className":"text-lg text-gray-600 leading-relaxed max-w-3xl","children":"Apply what you've learned in this lesson."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"Practice out loud. Reading these does not build the reflex; saying them does."}],["$","ol","1",{"start":"$undefined","className":"list-decimal pl-6 space-y-3 text-gray-700 marker:font-semibold marker:text-primary-600","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Say each of the six clarification phrases out loud five times, until they come without thinking."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"Write a three-sentence report of a real problem from your work, using problem, action, request."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Listen to any English conversation — a video, a podcast, coworkers — and count how many times a fluent speaker asks for clarification. Note what they say."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"Next time you are unsure at work, use one of the phrases instead of guessing. Write down what happened."}]]}]]}]}]]}]

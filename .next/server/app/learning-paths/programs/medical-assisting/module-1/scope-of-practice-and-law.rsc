0 border-b border-gray-100 align-top leading-relaxed","children":"What your supervising provider has actually authorized you to do"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Your training and competency"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"What you have been taught and assessed as able to do safely"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"Where scope questions are answered"}]]}]
1e:["$","div","4",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"All five must align before you perform a task. State law may permit it, your employer may allow it, your provider may delegate it — and if you have not been trained and assessed as competent, you still should not do it. Equally, being highly skilled at something your state prohibits does not make it lawful. The most restrictive of the five governs."]}]
1f:["$","figure","5",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Task"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Why"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Telephone triage"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Requires clinical assessment and judgment — nursing or provider function"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Interpreting test results for a patient"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Interpretation is diagnosis"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Independent patient assessment"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Assessment is a licensed nursing function"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Prescribing, or advising on medication changes"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Prescribing is a provider function"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Administering IV medications"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Prohibited for MAs in most states"}]]}],["$","tr","5",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Giving injections"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Permitted in many states under delegation, prohibited in some — check yours"}]]}],["$","tr","6",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Signing off on provider documentation"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Only the author may attest to their own note"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"Commonly outside an MA's scope"}]]}]
20:["$","div","6",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-blue-50 border-blue-400","children":[false,"In New York State, \"medical assistant\" is not a licensed title, and national certification does not change that: a CMA or CCMA is still an unlicensed person. The State Education Department's guidance on using medical assistants (revised December 2023) says unlicensed staff may, with proper training and supervision, measure vital signs, perform ECGs, collect specimens (including phlebotomy, if trained, in a CLIA-waived facility), act as a scribe, and change dressings. They may not triage, administer medications by any route, draw up or give vaccinations or injections of any kind, insert or remove IVs or catheters, or tell a patient about a positive test result."]}]
21:["$","div","7",{"className":"rounded-xl border border-primary-200 bg-primary-50/50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-primary-700 mb-2","children":"Worked example"}],["$","h4",null,{"className":"text-lg font-bold text-gray-900 mb-1","children":"Responding to a request outside your scope"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-5","children":"A provider asks you to administer an immunization, and you are not certain it is permitted in this state or that you have been trained for it here."}],["$","ol",null,{"className":"space-y-4","children":[["$","li","0",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":1}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Do not perform the task while you are uncertain."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Uncertainty is itself the answer for now. Performing a clinical task you are unsure you are authorized for risks patient harm and your own liability, and neither is recoverable by explaining afterwards that you were asked."}]]}]]}],["$","li","1",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":2}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Say so plainly and without apology."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"'I haven't been trained on immunizations here — can someone else give it, or can we get me signed off?' is professional, brief, and offers a path forward. It is not insubordination, and framing it as a training gap rather than a refusal keeps the conversation practical."}]]}]]}],["$","li","2",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":3}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Check the actual authority rather than relying on what you did elsewhere."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Your state's medical board and your employer's written policy are the sources. What was routine at a previous employer in another state tells you nothing about what is lawful here, and this is the mistake experienced MAs make most often after relocating."}]]}]]}],["$","li","3",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":4}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"If it is permitted, get trained and documented before doing it."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Competency assessment should be recorded in your personnel file. That record protects you and the practice, and it is what turns 'I was shown once' into demonstrable authorization."}]]}]]}],["$","li","4",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":5}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"If a request is repeated after you have declined, escalate."}],"$L26"]}]]}]]}],"$L27","$L28"]}]
22:["$","$L29","8",{"block":{"type":"knowledge-check","question":"You performed a clinical task routinely for three years at a practice in another state. At your new job in a different state, may you perform it?","options":["Yes — your experience and competency transfer with you","Not until you confirm your new state permits it, your employer allows it, and you are delegated and assessed here","Yes, provided a physician is somewhere in the building","Only if you hold a national MA certification"],"correctIndex":1,"explanation":"Scope of practice is set by state law and delegation, not by personal experience. A task that was routine elsewhere may be prohibited here. Confirm state law, employer policy, and your own delegation and competency assessment before performing it.","optionRationales":["Competency is necessary but not sufficient. The legal authority to perform the task does not travel with you.","Correct. State law, employer policy, delegation, and documented competency must all align.","Physical presence of a physician does not by itself authorize a delegated task.","National certification demonstrates knowledge but does not grant scope. Scope comes from state law and delegation."]}}]
23:["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Challenge"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Apply what you've learned in this lesson."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"Find your actual scope. This is the most practically useful research in the program."}],["$","ol","1",{"start":"$undefined","className":"list-decimal pl-6 space-y-3 text-gray-700 marker:font-semibold marker:text-primary-600","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Find your state medical board's guidance on delegation to unlicensed personnel. Note whether MAs may administer injections in your state, and under what supervision."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"Find your state nursing board's definition of nursing practice. List three activities it reserves to licensed nurses."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"For each of these, decide whether an MA in your state may perform it and cite your source: taking vital signs; performing a venipuncture; advising a patient their lab results are normal; administering an intramuscular injection."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"Write out, word for word, what you would say to a provider asking you to do something outside your scope. Keep it under three sentences."}]]}]]}]}]]}]

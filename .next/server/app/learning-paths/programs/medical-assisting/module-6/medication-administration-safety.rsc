g-primary-600 text-white flex items-center justify-center text-sm font-bold","children":3}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Document factually what was given, when, and what you observed."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Record the facts without speculation or self-justification. The documentation is for the patient's care and for the incident review, and an accurate record helps both."}]]}]]}],["$","li","3",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":4}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Complete an incident report through the practice's process."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Incident reports exist to identify system problems, not to assign blame. Two similar surnames in adjacent rooms is a system condition, and reporting is how it gets fixed before it catches someone else."}]]}]]}],["$","li","4",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":5}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Do not alter or backdate anything."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Amending the record to obscure an error converts a reportable mistake into falsification, which is far more serious and, in every case, discovered. The error is survivable; the cover-up is not."}]]}]]}]]}],["$","p",null,{"className":"mt-5 pt-4 border-t border-primary-200 text-gray-800","children":["$L20","The patient is assessed and monitored, the provider can intervene, and the system condition is documented."]}],"$L21"]}]
1c:["$","$L22","6",{"block":{"type":"knowledge-check","question":"A colleague has drawn up an injection and asks you to administer it because they are called away. What should you do?","options":["Administer it, since a qualified colleague prepared it","Decline — the person who prepares a medication is the person who administers it","Administer it after confirming the drug name with them","Administer it and document that a colleague prepared it"],"correctIndex":1,"explanation":"You cannot verify the contents of a syringe you did not prepare. Once you administer it, the administration is yours regardless of who drew it up. Prepare and administer, or do neither.","optionRationales":["Their competence is not the issue; you have no way to verify what is in the syringe.","Correct. Preparation and administration belong to the same person.","A verbal confirmation cannot verify the contents or the dose actually drawn.","Documenting the arrangement does not make it safe, and you remain the person who administered it."]}}]
1d:["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mb-3","children":"Challenge"}],["$","p",null,{"className":"text-lg text-gray-600 leading-relaxed max-w-3xl","children":"Apply what you've learned in this lesson."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"Medication administration is a delegated clinical skill requiring hands-on competency assessment. Calculation, however, you can and should practise now."}],["$","ol","1",{"start":"$undefined","className":"list-decimal pl-6 space-y-3 text-gray-700 marker:font-semibold marker:text-primary-600","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Calculate each: order 250 mg, on hand 125 mg/5 mL. Order 0.5 g, on hand 250 mg/mL. Order 40 mg, on hand 10 mg/mL. Show your work."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"Write the rights of medication administration from memory, then check."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Research the correct landmarking for a deltoid intramuscular injection and describe it in three sentences."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"Find out whether MAs may administer injections in your state, under what supervision, and what training is required."}]]}]]}]}]]}]

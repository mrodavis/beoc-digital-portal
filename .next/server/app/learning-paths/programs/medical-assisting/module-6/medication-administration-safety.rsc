18:["$","div","2",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"Never administer a medication someone else prepared, and never prepare one for someone else to give. The person who draws it up is the person who gives it. A prepared syringe handed over is a syringe whose contents you cannot verify — and if it is wrong, you administered it. This rule has no exceptions for busy days."]}]
19:["$","p","3",{"className":"text-gray-700 leading-relaxed","children":"Dosage calculation uses one reliable formula: desired dose divided by dose on hand, multiplied by the quantity that dose comes in. If an order is for 500 mg and the vial contains 250 mg per 5 mL, then 500 divided by 250, times 5 mL, gives 10 mL."}]

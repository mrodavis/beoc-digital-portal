1b:["$","figure","1",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Sign"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"May indicate"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Chest pain or pressure, especially with sweating or nausea"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Cardiac event"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Sudden facial droop, arm weakness, or speech difficulty"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Stroke — note the time last known well"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Difficulty breathing, or speaking in short phrases"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Respiratory distress, anaphylaxis"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Pale, cool, clammy skin with rapid weak pulse"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Shock"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Sudden confusion or altered consciousness"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Many causes, all urgent"}]]}],["$","tr","5",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Hives with swelling of lips, tongue, or throat"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Anaphylaxis"}]]}],["$","tr","6",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Uncontrolled bleeding"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Hemorrhage"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"Signs requiring immediate escalation"}]]}]
1c:["$","p","2",{"className":"text-gray-700 leading-relaxed","children":"Your role in an emergency is recognition, summoning help, and supporting within your scope. That is not a lesser role — a patient whose deterioration is noticed and escalated within a minute has a materially different outcome from one noticed in five."}]
1d:["$","div","3",{"className":"rounded-xl border border-primary-200 bg-primary-50/50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-primary-700 mb-2","children":"Worked example"}],["$","h4",null,{"className":"text-lg font-bold text-gray-900 mb-1","children":"Responding to a patient becoming unwell"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-5","children":"A patient in the waiting room is pale, diaphoretic, and reports feeling faint."}],["$","ol",null,{"className":"space-y-4","children":[["$","li","0",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":1}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Stay with the patient and call for help without leaving them."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Never leave a deteriorating patient to fetch someone. Call out, use the phone, or send another person. Patients who lose consciousness while alone fall, and a head injury on top of the original problem is a far worse situation."}]]}]]}],["$","li","1",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":2}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Help them to a safe position, lying down if possible."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Someone about to faint is safest lying down, where they cannot fall. If they are in a chair and cannot be moved, support them so a collapse is controlled rather than a drop onto a hard floor."}]]}]]}],["$","li","2",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":3}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Take vital signs if you can do so without leaving them."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Objective data helps the responding clinician enormously, and it is squarely within your scope. But taking vitals never comes before summoning help — the clinician needs to be on their way while you measure."}]]}]]}],["$","li","3",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":4}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Report concisely when help arrives."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"'62-year-old, was waiting for a routine visit, became pale and diaphoretic four minutes ago, says she feels faint, BP 88/54, pulse 112' gives the clinician everything in one sentence. A narrative wastes the time the report is meant to save."}]]}]]}],["$","li","4",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":5}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Stay and assist as directed."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"You know where supplies are, you can bring the emergency kit, you can call 911, you can clear the area. Being available and following direction is the most useful thing you can do once a clinician has taken over."}]]}]]}]]}],"$L24","$L25"]}]
1e:["$","div","4",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"Know before an emergency happens: where the emergency kit and AED are, who is trained in BLS, how to call for help internally, and what your practice's emergency protocol says your role is. Learning any of this during an emergency is too late. Emergency kits should be checked on a schedule for expiry and completeness, and that check is frequently an MA responsibility."]}]
1f:["$","div","5",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-blue-50 border-blue-400","children":[false,"Maintain a current BLS certification. Most employers require it, and it is a genuine competency rather than a box to tick. CPR and AED technique changes as guidelines are updated, which is precisely why certification expires."]}]
20:["$","$L26","6",{"block":{"type":"knowledge-check","question":"A patient in the waiting room becomes pale and says they feel faint. You are alone with them. What is your first action?","options":["Go to find a provider immediately","Stay with the patient, call for help without leaving, and help them lie down","Take a full set of vital signs before doing anything else","Move them to an examination room for privacy"],"correctIndex":1,"explanation":"Never leave a patient who may lose consciousness. Call out, use a phone, or send someone else. Getting them safely positioned prevents a fall, which is the immediate risk. Vital signs follow once help is summoned.","optionRationales":["Leaving means they may collapse unattended and sustain a head injury on top of the original problem.","Correct. Stay, summon help without leaving, and position them safely.","Vitals are valuable but come after help is on its way and the patient is safe.","Moving someone who may faint risks a fall in transit. Get help to them instead."]}}]
21:["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Challenge"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Apply what you've learned in this lesson."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"Preparation is what makes an emergency response possible."}],["$","ol","1",{"start":"$undefined","className":"list-decimal pl-6 space-y-3 text-gray-700 marker:font-semibold marker:text-primary-600","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Research the signs of anaphylaxis and write out how it is distinguished from a milder allergic reaction."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"Find out what a typical office emergency kit contains and why each item is included."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Write a concise handoff report for the waiting room scenario, in under twenty-five words."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"Look up BLS certification requirements in your area — who provides it, what it costs, and how often it must be renewed."}]]}]]}]}]]}]

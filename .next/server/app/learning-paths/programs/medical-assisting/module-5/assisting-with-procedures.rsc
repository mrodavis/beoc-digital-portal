1b:["$","p","1",{"className":"text-gray-700 leading-relaxed","children":"Medical asepsis reduces the number of organisms — handwashing, disinfection, clean gloves. Surgical asepsis eliminates them entirely from a defined area, and is required whenever the body's natural barriers are broken."}]
1c:["$","figure","2",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Rule"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Why"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Only sterile items touch sterile items"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Any contact with an unsterile item contaminates"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Keep the field in view at all times"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"An unobserved field must be treated as contaminated"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Never reach across the field"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Anything passing over it may shed onto it"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"The outer 1 inch of a drape is not sterile"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"The border is the boundary; items placed there are contaminated"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"A wet field is a contaminated field"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Moisture wicks organisms up from the surface beneath"}]]}],["$","tr","5",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Anything below waist level is contaminated"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"It cannot be kept in view or controlled"}]]}],["$","tr","6",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Face the field; never turn your back on it"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"You cannot observe what you cannot see"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"Rules of the sterile field"}]]}]
1d:["$","div","3",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"If you contaminate a sterile field, say so immediately. Every person in the room would rather spend two minutes re-setting a field than have a patient develop a surgical site infection. Nobody will thank you for staying quiet, and a contaminated field used knowingly is a patient safety event you participated in. There is no version of this where saying nothing is the better choice."]}]
1e:["$","figure","4",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Stage"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Have ready"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Preparation"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Consent confirmed, patient positioned, field set, lighting adjusted"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Anesthesia"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Syringe, needle, anesthetic, alcohol prep"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"The procedure"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Instruments in order of use, gauze, suture, irrigation"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Specimen"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Labeled container, requisition, fixative if required"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Closure"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Dressing supplies, tape, wound care instructions"}]]}],["$","tr","5",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Afterwards"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Sharps disposed at point of use, specimen routed, documentation"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"Anticipating during a procedure"}]]}]
1f:["$","div","5",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"Label specimen containers in the presence of the patient, immediately after collection, before leaving the room. Labeling later — or labeling several containers in advance — is how specimens get switched, and a mislabeled specimen means a patient receives a result belonging to someone else. This is among the most consequential errors in an outpatient setting and among the easiest to prevent."]}]
20:["$","$L24","6",{"block":{"type":"knowledge-check","question":"During a procedure you realize your sleeve brushed the sterile field. Nobody else noticed. What should you do?","options":["Say nothing — the risk is small and interrupting would be disruptive","State immediately that the field is contaminated so it can be re-established","Quietly move the items that were touched to one side","Mention it after the procedure so it can be noted"],"correctIndex":1,"explanation":"A contaminated field must be re-established, and the only person who knows it happened is you. Saying so immediately costs a few minutes; staying quiet exposes the patient to an infection risk that was entirely preventable. Speaking up about your own error is a core professional obligation.","optionRationales":["The risk is to the patient, and the interruption is trivial by comparison.","Correct. Say it immediately so the field can be re-established before the procedure continues.","Contamination is not confined to the visible point of contact, and moving items does not restore sterility.","Afterwards is too late — the patient has already been exposed."]}}]
21:["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Challenge"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Apply what you've learned in this lesson."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"Sterile technique is psychomotor. This prepares you for supervised practice."}],["$","ol","1",{"start":"$undefined","className":"list-decimal pl-6 space-y-3 text-gray-700 marker:font-semibold marker:text-primary-600","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Write the rules of the sterile field from memory, then check against a reference."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"For each, decide whether the field is contaminated and why: an item placed 1/2 inch from the drape edge; a sterile package opened away from your body; turning to answer a question; saline soaking through the drape."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Research the difference between sterilization, disinfection, and sanitization, and give a clinical example of each."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"Write a labeling procedure for specimens that makes a mix-up structurally difficult rather than merely discouraged."}]]}]]}]}]]}]

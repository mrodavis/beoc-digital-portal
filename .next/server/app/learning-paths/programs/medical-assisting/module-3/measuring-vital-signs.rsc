28:["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Deflating faster than this causes you to miss the true first and last sounds. Fast deflation reliably underestimates systolic and overestimates diastolic."}]
29:["$","li","5",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":6}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Record the arm used, the patient's position, and the cuff size."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"It makes the reading reproducible and comparable at the next visit. A pressure recorded with no context cannot be meaningfully compared to one taken differently."}]]}]]}]
2a:["$","p",null,{"className":"mt-5 pt-4 border-t border-primary-200 text-gray-800","children":[["$","span",null,{"className":"font-semibold","children":"Result: "}],"A reading that reflects the patient's pressure rather than an artifact of the measurement."]}]
2b:["$","p",null,{"className":"mt-2 text-gray-900 font-medium","children":[["$","span",null,{"aria-hidden":"true","children":"🔑 "}],"Rest, cuff size, bare arm at heart level, slow deflation. Each error pushes the number in a predictable direction, and they accumulate."]}]

1a:["$","div","4",{"className":"rounded-xl border border-primary-200 bg-primary-50/50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-primary-700 mb-2","children":"Worked example"}],["$","h4",null,{"className":"text-lg font-bold text-gray-900 mb-1","children":"Taking an accurate blood pressure"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-5","children":"Measure a patient's blood pressure so the reading reflects their actual pressure rather than your technique."}],["$","ol",null,{"className":"space-y-4","children":[["$","li","0",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":1}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Let the patient sit quietly for five minutes, feet flat, back supported."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Rushing this is the most common source of falsely high readings. Crossed legs raise systolic pressure, and an unsupported back raises diastolic. Five quiet minutes costs less than treating hypertension a patient does not have."}]]}]]}],["$","li","1",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":2}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Choose a cuff sized to the arm, not the one already attached."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"The bladder should encircle roughly 80% of the arm and its width should be about 40% of arm circumference. A cuff that is too small reads falsely high — often by 10 to 20 mmHg — and this single error is enough to move a patient into a different category."}]]}]]}],["$","li","2",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":3}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Place the cuff on a bare arm, supported at heart level."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"A sleeve under the cuff distorts the reading, and pushing a sleeve up creates a tourniquet. An arm below heart level reads high; above, low. Support it — a patient holding their own arm up is using muscles, which also raises the reading."}]]}]]}],["$","li","3",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":4}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Position the bladder over the brachial artery and inflate above the estimated systolic."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Palpate the radial pulse, inflate until it disappears, add 30 mmHg. This avoids missing an auscultatory gap, a silent interval in which Korotkoff sounds vanish and reappear — miss it and you record a systolic far below the real one."}]]}]]}],["$","li","4",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":5}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Deflate slowly, about 2-3 mmHg per second."}],"$L20"]}]]}],"$L21"]}],"$L22","$L23"]}]
1b:["$","div","5",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"Certain readings require immediate escalation rather than routine documentation — a blood pressure above 180/120, an oxygen saturation below 90%, a respiratory rate under 12 or over 24 in a patient in distress, or any reading accompanied by symptoms such as chest pain, confusion, or difficulty breathing. Recognizing that a number needs a clinician now is within your role. Deciding what it means is not."]}]
1c:["$","$L24","6",{"block":{"type":"knowledge-check","question":"A blood pressure cuff that is too small for the patient's arm produces what effect?","options":["A falsely low reading, because less pressure is transmitted","A falsely high reading, often by 10 to 20 mmHg","No effect, provided the cuff fastens","An unpredictable reading that may be high or low"],"correctIndex":1,"explanation":"An undersized cuff requires more pressure to occlude the artery, so the measured pressure is higher than the patient's actual pressure. The effect is substantial and consistent, and it is a common cause of patients being labelled hypertensive incorrectly.","optionRationales":["The error runs the other way. An oversized cuff is what produces falsely low readings.","Correct. Undersized cuffs read falsely high, frequently by a clinically significant margin.","Fastening is not the criterion. Bladder dimensions relative to arm circumference determine accuracy.","The direction is predictable: too small reads high, too large reads low."]}}]
1d:["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mb-3","children":"Challenge"}],["$","p",null,{"className":"text-lg text-gray-600 leading-relaxed max-w-3xl","children":"Apply what you've learned in this lesson."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"Vital signs are a hands-on skill. This prepares you for supervised practice; it does not replace it."}],["$","ol","1",{"start":"$undefined","className":"list-decimal pl-6 space-y-3 text-gray-700 marker:font-semibold marker:text-primary-600","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Write out the expected adult ranges for all six vital signs from memory, then check them."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"For each error, state the direction it moves the reading and by roughly how much: cuff too small; arm below heart level; deflating too quickly; patient talking during measurement."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Research the auscultatory gap. Explain in three sentences what it is and how palpating first prevents the error."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"List five readings that would require you to notify a provider immediately rather than simply documenting them."}]]}]]}]}]]}]
1e:["$","$L25",null,{"courseId":"learning-paths/programs/medical-assisting","lessonId":"module-3::measuring-vital-signs","title":"Measuring Vital Signs Accurately"}]
1f:["$","div",null,{"className":"flex justify-between items-center pt-8 border-t border-gray-200 gap-4","children":[["$","div",null,{}],["$","$L15",null,{"href":"/learning-paths/programs/medical-assisting/module-3/patient-intake-and-history","className":"text-primary-600 hover:text-primary-700 font-medium transition-colors text-right","children":["Patient Intake and Medical History"," →"]}]]}]
20:["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Deflating faster than this causes you to miss the true first and last sounds. Fast deflation reliably underestimates systolic and overestimates diastolic."}]
21:["$","li","5",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":6}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Record the arm used, the patient's position, and the cuff size."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"It makes the reading reproducible and comparable at the next visit. A pressure recorded with no context cannot be meaningfully compared to one taken differently."}]]}]]}]
22:["$","p",null,{"className":"mt-5 pt-4 border-t border-primary-200 text-gray-800","children":[["$","span",null,{"className":"font-semibold","children":"Result: "}],"A reading that reflects the patient's pressure rather than an artifact of the measurement."]}]
23:["$","p",null,{"className":"mt-2 text-gray-900 font-medium","children":[["$","span",null,{"aria-hidden":"true","children":"🔑 "}],"Rest, cuff size, bare arm at heart level, slow deflation. Each error pushes the number in a predictable direction, and they accumulate."]}]

y-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Almost always yes — and taking them one at a time is usually the right strategy"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"What does it cost, and is there help?"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"In New York testing is free for eligible residents; elsewhere, many states have vouchers or funded programs"}]]}],["$","tr","5",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Is there a retake policy and a waiting period?"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Affects how you schedule"}]]}],["$","tr","6",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Is a practice test available?"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"The best single predictor of readiness"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"What to establish before you study"}]]}]
1e:["$","div","4",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-blue-50 border-blue-400","children":[false,"The GED lets you take the subjects separately and keeps a passing score while you retake others. This matters strategically: pass the subject you are strongest at first. It is banked, it is done, and it changes how the rest of the process feels. Students who try to prepare for everything at once take longer and quit more often."]}]
1f:["$","figure","5",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Area"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Covers"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Mathematical reasoning"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Number sense, algebra, geometry, and data — mostly applied to real situations"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Reasoning through language arts"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Reading comprehension, grammar and usage, and an extended written response"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Science"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Life, physical, and earth science, with heavy emphasis on reading data and evaluating evidence"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Social studies"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Civics and government, US history, economics, and geography, again with data interpretation"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"The subject areas, in broad terms"}]]}]
20:["$","div","6",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"Note what the science and social studies tests are really assessing. They ask far less about memorized facts than most people expect, and far more about reading a passage, a chart, or a graph and reasoning from it. A student who is strong at reading and weak on dates is often better placed than the reverse — and that changes how you should prepare."]}]
21:["$","$L25","7",{"block":{"type":"knowledge-check","question":"You are strongest at reading and weakest at math. In what order should you take the subject tests?","options":["Math first, to get the hardest one over with","Language arts first — passing scores are banked, and an early pass changes how the rest feels","All on the same day, to finish quickly","The order does not matter"],"correctIndex":1,"explanation":"Passing scores are kept while you work on other subjects, so there is no penalty for sequencing. Passing your strongest subject early banks a real result and gives you evidence the process works, which matters more than it sounds when the remaining subject is the hard one.","optionRationales":["Starting with your weakest risks an early failure that many people do not come back from.","Correct. Bank the strongest first — the score is kept and the confidence is real.","Taking all four at once is exhausting and gives you no chance to learn from the first result.","It affects both your odds and your persistence, which is most of what determines completion."]}}]
22:["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Challenge"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Apply what you've learned in this lesson."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"This is research, and it should take under an hour."}],["$","ol","1",{"start":"$undefined","className":"list-decimal pl-6 space-y-3 text-gray-700 marker:font-semibold marker:text-primary-600","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Confirm which HSE exam your state accepts and write down the official source you found it on. In New York, that is the NYSED High School Equivalency office and GED.com."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"Record the subject areas, the passing score for each, and the cost."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"If you are testing outside New York, find out whether your state offers vouchers, funded preparation, or free retakes."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"Ask your instructor or program about an official practice test. Write down the order you will take the four subjects in, and why."}]]}]]}]}]]}]

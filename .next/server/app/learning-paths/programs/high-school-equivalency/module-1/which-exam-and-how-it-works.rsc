1b:["$","p","1",{"className":"text-gray-700 leading-relaxed","children":"There is no single national high school equivalency exam. Each state chooses which test it accepts, most commonly the GED or the HiSET, and the tests differ in format, scoring, and number of subject tests. In New York State the exam is the GED, which replaced the TASC in 2022, so a TASC study guide describes a test New York no longer gives. Everything else you do depends on this answer, so get it first."}]
1c:["$","figure","2",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Question"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"New York answer"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Which exam?"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"The GED: four subject tests (Reasoning Through Language Arts, Mathematical Reasoning, Science, and Social Studies), taken on a computer at a testing center"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"What does it cost?"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"New York State pays for testing for New York residents who are age eligible"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Who can test?"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"You must have lived in New York for at least 30 days and not already hold a high school or HSE diploma. At 19 or older you can register directly; at 16 to 18 you need an age eligibility form signed by an authorized official"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"What is a passing score?"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"At least 145 on each subject test"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"What if I do not pass?"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Wait 60 days, then retake that subject. Each subject can be taken up to three times in a calendar year, and subjects you passed stay passed"}]]}],["$","tr","5",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Is there another way?"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Yes. Passing Regents exam scores can stand in for matching subject tests, and NYSED also accepts 24 qualifying college credits or the National External Diploma Program (NEDP). An advisor can tell you whether one fits you"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"If you are testing in New York State (checked against NYSED and GED.com)"}]]}]

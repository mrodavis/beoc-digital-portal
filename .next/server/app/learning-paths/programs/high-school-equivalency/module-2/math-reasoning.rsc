16:["$","p","1",{"className":"text-gray-700 leading-relaxed","children":"A large share of HSE math is proportional reasoning: percentages, ratios, rates, unit conversion, and scale. If you can set up and solve a proportion reliably, you have covered a great deal of the test. The rest is basic algebra, geometry formulas that are provided to you, and reading data."}]
17:["$","div","2",{"className":"rounded-xl border border-primary-200 bg-primary-50/50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-primary-700 mb-2","children":"Worked example"}],["$","h4",null,{"className":"text-lg font-bold text-gray-900 mb-1","children":"Setting up a proportion from a word problem"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-5","children":"A car uses 12 gallons of fuel to travel 384 miles. How far can it travel on 18 gallons?"}],["$","ol",null,{"className":"space-y-4","children":[["$","li","0",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":1}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Identify what is being compared, and keep the units in the same positions."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Miles to gallons, both sides. Writing 384/12 on one side and 18/x on the other inverts the relationship and produces a confidently wrong answer. The units are what stop this."}]]}]]}],["$","li","1",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":2}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Write it as two equal fractions: 384/12 = x/18."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Miles on top on both sides, gallons underneath on both sides. Set it up this way and it is nearly impossible to get backwards."}]]}]]}],["$","li","2",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":3}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Cross-multiply: 12x = 384 × 18, so 12x = 6,912."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Cross-multiplication turns a proportion into a one-step equation, which is the only algebra this problem needs."}]]}]]}],["$","li","3",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":4}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Divide: x = 576 miles."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"One operation. The setup was the whole problem, which is true of most proportion questions on this test."}]]}]]}],["$","li","4",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":5}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Sanity-check: 18 gallons is 1.5 times 12, and 576 is 1.5 times 384."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"This takes five seconds and catches an inverted setup immediately. If your answer had been smaller than 384, the setup was backwards."}]]}]]}]]}],["$","p",null,{"className":"mt-5 pt-4 border-t border-primary-200 text-gray-800","children":[["$","span",null,{"className":"font-semibold","children":"Result: "}],"576 miles, checked."]}],["$","p",null,{"className":"mt-2 text-gray-900 font-medium","children":[["$","span",null,{"aria-hidden":"true","children":"🔑 "}],"Keep units in matching positions, cross-multiply, and sanity-check the direction. Setup is the problem; the arithmetic is not."]}]]}]

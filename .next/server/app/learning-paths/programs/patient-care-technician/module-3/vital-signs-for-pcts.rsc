1a:["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Let the patient sit quietly for five minutes, feet flat and back supported."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"This is the step time pressure removes first, and it is the largest single source of falsely high readings. Crossed legs raise systolic pressure and an unsupported back raises diastolic. Five minutes costs less than a patient started on medication they do not need."}]]}]
1b:["$","li","1",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":2}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Size the cuff to the arm rather than using the one already attached."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"The bladder should encircle about 80% of the arm. A cuff that is too small reads high by 10 to 20 mmHg — enough on its own to move a patient into a different category. This is the most common equipment error in the building."}]]}]]}]
1c:["$","li","2",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":3}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Bare arm, supported at heart level."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"A sleeve under the cuff distorts the reading and a pushed-up sleeve becomes a tourniquet. An arm below heart level reads high. And support it yourself — a patient holding their own arm up is using muscle, which also raises the number."}]]}]]}]
1d:["$","li","3",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":4}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Palpate first, then inflate 30 mmHg above where the pulse disappeared."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"This avoids missing an auscultatory gap — a silent interval where the sounds vanish and return. Miss it and you record a systolic far below the real one, which is the error that reads as reassuring."}]]}]]}]
1e:["$","li","4",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":5}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Deflate slowly, 2 to 3 mmHg per second."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Faster deflation misses the true first and last sounds, underestimating systolic and overestimating diastolic. It is the error that feels like efficiency."}]]}]]}]
1f:["$","li","5",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":6}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Record the arm, the position, and the cuff size alongside the number."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"It makes the reading comparable at the next check. A pressure recorded with no context cannot be meaningfully compared to one taken differently, and the trend is usually what matters."}]]}]]}]
20:["$","p",null,{"className":"mt-5 pt-4 border-t border-primary-200 text-gray-800","children":[["$","span",null,{"className":"font-semibold","children":"Result: "}],"A reading that reflects the patient's pressure rather than your technique."]}]
21:["$","p",null,{"className":"mt-2 text-gray-900 font-medium","children":[["$","span",null,{"aria-hidden":"true","children":"🔑 "}],"Rest, cuff size, bare arm at heart level, palpate first, deflate slowly. Every error pushes the number in a predictable direction, and they add up."]}]
22:["$","div","1",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"The trend matters as much as the number"}],["$","div",null,{"className":"space-y-6","children":[["$","div","0",{"className":"rounded-xl border border-amber-200 bg-amber-50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-amber-800 mb-2","children":"On the job"}],"$undefined",["$","p",null,{"className":"text-sm font-medium text-amber-900 mb-2","children":"You take routine vitals on a medical unit at Lakeside Regional."}],["$","p",null,{"className":"text-gray-800 leading-relaxed","children":"A patient's heart rate is 98. That is inside the normal range, so it is easy to record and move on. Their rate has been 62 every shift for three days. A jump of 36 beats in one patient is a change worth reporting, and the normal range conceals it entirely."}],["$","p",null,{"className":"mt-3 pt-3 border-t border-amber-200 text-gray-900","children":[["$","span",null,{"className":"font-semibold","children":"Your task: "}],"Read every measurement against that patient's own baseline, not only against the textbook range."]}]]}],["$","figure","1",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Vital sign"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Range"}],["$","th","2",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Note"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"clas
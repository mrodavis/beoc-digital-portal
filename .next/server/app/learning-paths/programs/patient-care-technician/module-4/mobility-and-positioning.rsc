mary-600 font-bold","aria-hidden":"true","children":"✓"}],["$","span",null,{"children":"Assist with ambulation using a gait belt"}]]}],["$","li","3",{"className":"flex gap-3 text-gray-800 leading-relaxed","children":[["$","span",null,{"className":"flex-shrink-0 text-primary-600 font-bold","aria-hidden":"true","children":"✓"}],["$","span",null,{"children":"Apply range of motion exercises within your scope"}]]}]]}],false,false]}],"$undefined","$undefined",["$","div",null,{"className":"mb-12","children":["$","div",null,{"className":"inline-flex items-center gap-2 px-4 py-2 bg-blue-50 border border-blue-200 rounded-full text-blue-700 font-medium text-sm","children":"📘 Reading Lesson"}]}],["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Lesson Notes"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Read through the key concepts before you try the challenge."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-12","children":[["$","div","0",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Pressure injuries are preventable and largely your responsibility"}],["$","div",null,{"className":"space-y-6","children":[["$","div","0",{"className":"rounded-xl border border-amber-200 bg-amber-50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-amber-800 mb-2","children":"On the job"}],"$undefined",["$","p",null,{"className":"text-sm font-medium text-amber-900 mb-2","children":"You care for an immobile patient at Lakeside Regional."}],["$","p",null,{"className":"text-gray-800 leading-relaxed","children":"A patient who cannot reposition themselves is left on their back for four hours during a busy shift. A reddened area develops over the sacrum. Caught now it resolves in days. Missed, it becomes an open wound that takes months, and it was entirely preventable by turning them."}],"$L1a"]}],"$L1b","$L1c","$L1d","$L1e","$L1f","$L20"]}]]}]]}]}]]}],false,false,"$L21",false,"$undefined","$L22","$L23"]}]

1b:["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Knock, wait, introduce yourself, and say what you are there to do before touching anything."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"It is his room and his body. Announcing the task gives him the chance to say 'not yet' or 'I can do that part', which is the difference between being helped and being handled."}]]}]
1c:["$","li","1",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":2}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Ask what he can do himself, and then let him do it even though it is slower."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Independence lost is rarely regained, and doing it for him because it is faster is how it gets lost. The time you save is measured in minutes; what he loses is measured in months."}]]}]]}]
1d:["$","li","2",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":3}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Close the door and the curtain, and keep him covered except the part you are washing."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Exposure is the most common complaint in personal care and the easiest to prevent. Move the towel rather than the patient wherever you can."}]]}]]}]
1e:["$","li","3",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":4}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Offer real choices — water temperature, which arm first, shirt before trousers."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Small autonomy matters disproportionately to someone who has lost most of theirs. These choices cost nothing and change how the whole interaction feels to him."}]]}]]}]
1f:["$","li","4",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":5}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Use the time to look at his skin, and say what you are doing."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"You are seeing areas nobody else sees, in good light, with your hands on him. Narrating it — 'I'm just checking your back while I'm here' — keeps it care rather than inspection."}]]}]]}]
20:["$","li","5",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":6}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Leave him covered, warm, with the call light in reach before you go."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"The last thirty seconds are what he will remember, and the call light within reach is what prevents him getting up alone later."}]]}]]}]

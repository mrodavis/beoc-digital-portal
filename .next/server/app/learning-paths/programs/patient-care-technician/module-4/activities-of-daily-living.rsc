23:["$","div","1",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Care that keeps a person a person"}],["$","div",null,{"className":"space-y-6","children":[["$","div","0",{"className":"rounded-xl border border-amber-200 bg-amber-50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-amber-800 mb-2","children":"On the job"}],"$undefined",["$","p",null,{"className":"text-sm font-medium text-amber-900 mb-2","children":"You provide morning care on a medical unit at Lakeside Regional."}],["$","p",null,{"className":"text-gray-800 leading-relaxed","children":"A patient who dressed himself every day for seventy years now needs help with a shirt. How that help is given determines whether he experiences it as assistance or as the moment he stopped being an adult. It costs nothing to do it the first way."}],["$","p",null,{"className":"mt-3 pt-3 border-t border-amber-200 text-gray-900","children":[["$","span",null,{"className":"font-semibold","children":"Your task: "}],"Provide personal care in a way that protects dignity, and use the closeness to observe."]}]]}],["$","p","1",{"className":"text-gray-700 leading-relaxed","children":"Personal care is where PCTs spend much of their time and where the role's real character shows. Two people can complete the same task in the same time, and one leaves the patient feeling cared for while the other leaves them feeling processed."}],["$","figure","2",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Do"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Why"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Knock and wait before entering"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"It is their room, temporarily"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Introduce yourself and explain before touching"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Nobody should be touched without knowing why"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Close the door and curtain every time"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Exposure is the most common complaint in personal care"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Keep the patient covered except the area you are working on"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Dignity is maintained by drape, not by speed"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Let them do what they can, even slowly"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Independence lost is rarely regained"}]]}],"$L27","$L28"]}]]}]}],"$L29"]}],"$L2a","$L2b","$L2c"]}]]}]

2a:["$","div","3",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-blue-50 border-blue-400","children":[false,"Personal care is the best opportunity in the whole day to observe skin. You are seeing areas nobody else sees, in good light, with your hands on the patient. New redness, a change in a wound, swelling, bruising, or a patient wincing at a spot they had not mentioned — all of this is observable during a bath and easy to miss otherwise. Report what you find."]}]
2b:["$","figure","4",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Approach"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Why"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Approach from the front; make eye contact"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Approaching from behind startles and can provoke resistance"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"One simple instruction at a time"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Multi-step directions exceed working memory"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Demonstrate rather than only explaining"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Visual cues succeed where words do not"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Allow far more time than seems necessary"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Rushing reliably produces resistance"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"If refused, stop and try again later"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Persisting escalates; a later attempt often succeeds"}]]}],["$","tr","5",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Never argue with a mistaken belief"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Redirect instead — correcting causes distress and changes nothing"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"Adapting for cognitive impairment"}]]}]
2c:["$","$L2e","5",{"block":{"type":"knowledge-check","question":"A patient with dementia becomes agitated and resists during a bath. What should you do?","options":["Continue quickly to get it finished with less distress overall","Stop, leave the patient covered and comfortable, and try again later or ask a colleague to attempt it","Explain firmly why the bath is necessary","Ask another staff member to help hold them still"],"correctIndex":1,"explanation":"Resistance escalates when care is forced, and a bath is almost never urgent. Stopping and trying later — or having a different person attempt it — very often succeeds where persisting would not. Forcing care against resistance risks injury to both of you and is a dignity violation.","optionRationales":["Continuing through resistance escalates distress and risks injury.","Correct. Stop, keep them comfortable, and try again later or with a different approach.","Reasoning does not work with impaired comprehension, and firmness reads as threat.","Restraining someone for a routine bath is a serious violation and a real injury risk."]}}]

1b:["$","p","1",{"className":"text-gray-700 leading-relaxed","children":"A PCT's most valuable contribution is often an observation nobody else was present to make. That value is realized only when the observation is reported in a form a nurse can use — which means specific, measured, and compared to a baseline."}]
1c:["$","figure","2",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Vague"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Actionable"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Seems a bit off"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Respirations 26, up from 16 this morning; quieter than usual; declined lunch"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Didn't eat much"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Ate about 25% of lunch; no breakfast"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Seems confused"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Did not know where she was at 1400; oriented at 0800"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Complained of pain"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Reported 7/10 pain in right hip on repositioning at 1330"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Skin looks bad"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"New 2 cm reddened area over sacrum, does not blanch"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"Vague against actionable"}]]}]
1d:["$","div","3",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"Report a change immediately rather than saving it for handoff, particularly any change in breathing, level of consciousness, or skin color, or a new or worsening pain. You are not deciding whether it matters — that is the nurse's judgment. You are making sure they have the information to make it while there is still time."]}]
1e:["$","figure","4",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Right"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"In practice"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"To be treated with dignity and respect"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Knock, introduce yourself, explain before you touch"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"To privacy and confidentiality"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Curtains and doors closed; no discussion in corridors"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"To refuse care"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"A patient may decline anything; report the refusal, do not override it"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"To be informed"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Explain what you are about to do, every time"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"To be free from abuse and neglect"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Recognize it and report it; you are likely a mandated reporter"}]]}],["$","tr","5",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"To be free from unnecessary restraint"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Restraints require an order and close monitoring"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"Fundamental patient rights"}]]}]
1f:["$","div","5",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"A competent adult may refuse any care, including care that is clearly in their interest. Your role is to explain what you were going to do and why, accept the refusal, and report it to the nurse. Persuading is acceptable; proceeding anyway is battery. This applies to a bath, a repositioning, and a blood draw equally."]}]
20:["$","p","6",{"className":"text-gray-700 leading-relaxed","children":"Abuse and neglect must be recognized and reported. Physical signs include unexplained bruising, particularly in patterns or at various stages of healing. Behavioral signs include fear of specific staff or visitors, withdrawal, or a change in demeanor when someone is present. Neglect shows as poor hygiene, dehydration, untreated pressure injuries, or unmet basic needs. Healthcare workers are mandated reporters in most jurisdictions — report through your facility's process, and reporting is required whether or not you are certain."}]
21:["$","$L25","7",{"block":{"type":"knowledge-check","question":"A competent patient refuses their scheduled bath. What should you do?","options":["Proceed gently, since hygiene is necessary for their health","Accept the refusal, explain why it was offered, and report it to the nurse","Wait an hour and try again without mentioning it","Document that the patient is non-compliant"],"correctIndex":1,"explanation":"A competent adult may refuse any care. Explaining the reason and offering an alternative time is appropriate; proceeding against their refusal is battery regardless of benefit. Report it — a refusal can itself be clinically significant.","optionRationales":["Proceeding against a competent refusal is battery, whatever the health rationale.","Correct. Accept it, explain, offer alternatives, and report.","Trying again later is reasonable; not reporting it is not, since the refusal may be clinically meaningful.","'Non-compliant' is a judgment. Document the refusal factually — the patient exercised a right."]}}]
22:["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Challenge"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Apply what you've learned in this lesson."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"Precision in reporting is learnable and immediately useful."}],["$","ol","1",{"start":"$undefined","className":"list-decimal pl-6 space-y-3 text-gray-700 marker:font-semibold marker:text-primary-600","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Rewrite each as an actionable report: 'She's not herself today.' 'He didn't sleep well.' 'The wound looks worse.' 'He's in a lot of pain.'"}],["$","li","1",{"className":"leading-relaxed pl-1","children":"Research the SBAR communication format. Write an SBAR report for the patient in the opening scenario."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Find your state's mandated reporter requirements for healthcare workers. Note who must report, what, and within what timeframe."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"List four signs of possible abuse and four of neglect, and describe how you would report a concern through a facility process."}]]}]]}]}]]}]

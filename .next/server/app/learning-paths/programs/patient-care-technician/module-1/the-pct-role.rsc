17:["$","p","1",{"className":"text-gray-700 leading-relaxed","children":"Patient care technicians provide direct care under the supervision of licensed nurses. The role combines the personal care duties of a nursing assistant with additional technical skills — commonly phlebotomy, EKG, and point-of-care testing — which is what distinguishes a PCT from a CNA in most facilities."}]
18:["$","figure","2",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Role"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Setting"}],["$","th","2",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Typical additional skills"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"CNA"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Long-term care, hospitals"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Personal care, mobility, vital signs; state certification required"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"PCT"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Hospitals, dialysis, ambulatory"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"CNA duties plus phlebotomy, EKG, point-of-care testing"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Medical assistant"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Outpatient clinics"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Clinical and administrative; works under provider delegation"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"LPN/LVN"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Varied"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Licensed nursing within a defined scope"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"Where the roles differ"}]]}]
19:["$","div","3",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-blue-50 border-blue-400","children":[false,"Titles vary considerably between employers. What one hospital calls a PCT, another calls a Nurse Extern, Patient Care Assistant, or Clinical Technician — and the duties differ with the title. Many states also require CNA certification as the foundation for a PCT position, which involves a state-approved training program with a required number of supervised clinical hours. Check the requirements where you intend to work rather than assuming."]}]
1a:["$","p","4",{"className":"text-gray-700 leading-relaxed","children":"PCTs report to and work under the supervision of a registered nurse. The nurse remains accountable for the patient's nursing care, delegates specific tasks, and relies on you to report back accurately. That reporting relationship is the core of the job — a delegated task performed well but not reported is only half done."}]

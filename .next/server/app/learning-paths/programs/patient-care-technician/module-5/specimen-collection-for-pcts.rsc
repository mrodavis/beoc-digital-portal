1a:["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Take one labeled requisition into one room. Never carry two."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"The mix-up becomes impossible rather than unlikely. If only one patient's paperwork is in your hand, there is nothing to confuse it with — this is a structural fix rather than a reminder to be careful."}]]}]
1b:["$","li","1",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":2}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Check the armband against the requisition, out loud, with the patient."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Two identifiers, name and date of birth, read from the band rather than asked as a leading question. 'Are you Mrs. Alvarez?' gets a yes from someone who is confused or hard of hearing; 'Can you tell me your name and date of birth?' does not."}]]}]]}]
1c:["$","li","2",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":3}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Label the container in the room, immediately after collection, in front of the patient."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"This is the whole procedure. Every mix-up happens in the gap between collection and labeling, and the only reliable fix is to close that gap to zero. Never pre-label and never carry an unlabeled specimen out."}]]}]]}]
1d:["$","li","3",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":4}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Have the patient confirm their name on the label if they are able."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"A second pair of eyes at no cost, and it is the patient's own result at stake. Most people check carefully when asked."}]]}]]}]
1e:["$","li","4",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":5}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Complete and route that specimen before going to the second room."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Finishing one before starting the next keeps only one specimen in play at a time. Batching two collections and labeling afterwards is exactly how two patients receive each other's results."}]]}]]}]

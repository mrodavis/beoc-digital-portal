17:["$","figure","1",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Practice"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Why"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Sit the patient fully upright, at 90 degrees"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Reclining lets food travel toward the airway"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Keep them upright 30 minutes after eating"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Reduces reflux and aspiration risk"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Small bites, and allow time between"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Rushing is the single biggest risk factor"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Confirm each swallow before the next bite"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Watch the throat; do not rely on them telling you"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Follow prescribed diet and thickened liquids exactly"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Consistency is prescribed for a clinical reason"}]]}],["$","tr","5",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Sit at eye level, do not stand over them"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Standing rushes the pace and is undignified"}]]}],["$","tr","6",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Stop if coughing, wet voice, or distress"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Report immediately — these are aspiration signs"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"Safe feeding practice"}]]}]
18:["$","div","2",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"Never give food or fluids to a patient who is NPO, and never alter a prescribed diet texture or liquid thickness because the patient asks or because it seems excessive. Thickened liquids are prescribed after a swallow evaluation. Giving thin liquids to a patient prescribed thickened ones can cause aspiration and death, and 'they said they were fine with water' is not a defence."]}]
19:["$","p","3",{"className":"text-gray-700 leading-relaxed","children":"Intake and output records inform real clinical decisions about fluid balance, kidney function, and medication dosing. Record intake in millilitres, including all oral fluids, ice chips at roughly half their volume, and fluids taken with medications. Record output including urine, emesis, drainage, and liquid stool. Guessing makes the record actively misleading — an inaccurate I&O is worse than none, because it will be trusted."}]
1a:["$","figure","4",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Observation"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"May indicate"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"No urine output in 6-8 hours"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Retention, dehydration, or kidney problem"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Dark, concentrated, or strong-smelling urine"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Dehydration or infection"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Blood in urine or stool"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Always report"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Burning or pain on urination"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Infection"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"New incontinence in a previously continent patient"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Infection, retention with overflow, or neurological change"}]]}],["$","tr","5",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"No bowel movement for three days"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Constipation, possible impaction"}]]}],["$","tr","6",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Black tarry stool"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Upper gastrointestinal bleeding — report urgently"}]]}],["$","tr","7",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Sudden watery diarrhea"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Possible infection; consider precautions"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"Elimination changes worth reporting"}]]}]
1b:["$","div","5",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-blue-50 border-blue-400","children":[false,"Toileting is where dignity is most often lost and where many falls happen. Answer call lights for toileting first — patients who wait get up alone, and the bathroom is where they fall. Provide privacy, stay close enough to help but out of sight if it is safe, and never rush someone or express any reaction to what you are cleaning."]}]
1c:["$","$L20","6",{"block":{"type":"knowledge-check","question":"A patient prescribed thickened liquids asks for a glass of water, saying they swallow fine. What should you do?","options":["Give the water, since the patient knows their own ability","Explain that you can only provide the prescribed consistency, and report the request to the nurse","Give a small amount and watch carefully","Give water only if they are sitting fully upright"],"correctIndex":1,"explanation":"Thickened liquids are prescribed following a swallow evaluation because thin liquids move too fast to control. A patient's subjective sense of swallowing well does not override that assessment. Explain kindly, provide the prescribed consistency, and report the request — the diet may warrant re-evaluation.","optionRationales":["Patients with dysphagia frequently aspirate without any sensation of doing so — silent aspiration is common.","Correct. Provide the prescribed consistency and report the request.","A small amount can still be aspirated, and observation does not prevent it.","Positioning helps but does not make thin liquids safe for someone with a swallowing deficit."]}}]

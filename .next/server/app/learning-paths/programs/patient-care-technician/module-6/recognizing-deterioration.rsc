en for the last four days."}],["$","p",null,{"className":"mt-3 pt-3 border-t border-amber-200 text-gray-900","children":["$L16","Learn to take early, non-specific change seriously and escalate it credibly."]}]]}],"$L17","$L18","$L19","$L1a","$L1b","$L1c"]}]]}]]}]}]]}],false,"$L1d","$undefined","$L1e","$L1f"]}]

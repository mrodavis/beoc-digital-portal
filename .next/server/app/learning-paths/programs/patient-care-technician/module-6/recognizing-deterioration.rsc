23:["$","div","1",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"You will notice it first"}],["$","div",null,{"className":"space-y-6","children":[["$","div","0",{"className":"rounded-xl border border-amber-200 bg-amber-50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-amber-800 mb-2","children":"On the job"}],"$undefined",["$","p",null,{"className":"text-sm font-medium text-amber-900 mb-2","children":"You are working a medical unit at Lakeside Regional."}],["$","p",null,{"className":"text-gray-800 leading-relaxed","children":"A patient who has been chatty all week is quiet this afternoon and says she just feels 'strange.' Her vital signs are within normal limits. Nothing is objectively wrong, and you are the only person who knows how she has been for the last four days."}],["$","p",null,{"className":"mt-3 pt-3 border-t border-amber-200 text-gray-900","children":[["$","span",null,{"className":"font-semibold","children":"Your task: "}],"Learn to take early, non-specific change seriously and escalate it credibly."]}]]}],["$","p","1",{"className":"text-gray-700 leading-relaxed","children":"Serious deterioration is usually preceded by hours of subtle change. Because PCTs spend the most time with patients, they frequently detect it before it appears in the numbers — and a change in mental status or a patient's own sense that something is wrong are among the most reliable early signals."}],["$","figure","2",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Sign"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibol
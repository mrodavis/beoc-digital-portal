1a:["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Hand hygiene, then gloves, before you touch the patient at all."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"The first moment is before contact, not after. Gloves put on over unwashed hands carry whatever was on them into the task, and the glove gives you no protection from something you brought in yourself."}]]}]
1b:["$","li","1",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":2}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Work clean to dirty, top to bottom, and change gloves when you cross that line."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Wash the face and upper body before the perineal area, never the reverse. This is the single ordering rule that prevents most cross-contamination during personal care, and it costs nothing to follow."}]]}]]}]
1c:["$","li","2",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":3}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"After perineal care: remove gloves, perform hand hygiene, put on fresh gloves."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"All three steps, in that order. Changing gloves without hand hygiene between is the common shortcut and it defeats the purpose — hands are contaminated during removal regardless of technique."}]]}]]}]
1d:["$","li","3",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":4}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Only now approach the wound dressing."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Moving from a dirty task to an open wound on the same patient is a direct route to infection. The fact that it is the same person is irrelevant — organisms from the perineum do not belong in a wound."}]]}]]}]
1e:["$","li","4",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold","children":5}],["$","div",null,{"className":"flex-1","children":[["$","p",null,{"className":"font-semibold text-gray-900","children":"Remove gloves and perform hand hygiene before touching the bed rails, the call light, or the chart."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-1","children":"Everything you touch after care becomes a surface the next person touches. This is how an organism leaves the room, and it is the step most often skipped because the task feels finished."}]]}]]}]
1f:["$","p",null,{"className":"mt-5 pt-4 border-t border-primary-200 text-gray-800","children":[["$","span",null,{"className":"font-semibold","children":"Result: "}],"One patient, one bath, one wound check, and nothing carried between them."]}]
20:["$","p",null,{"className":"mt-2 text-gray-900 font-medium","children":[["$","span",null,{"aria-hidden":"true","children":"🔑 "}],"Clean to dirty, and remove-hygiene-reglove as a single unit every time you cross the line."]}]
21:["$","div","1",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Proximity raises the stakes"}],["$","div",null,{"className":"space-y-6","children":[["$","div","0",{"className":"rounded-xl border border-amber-200 bg-amber-50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-amber-800 mb-2","children":"On the job"}],"$undefined",["$","p",null,{"className":"text-sm font-medium text-amber-900 mb-2","children":"You provide direct care on a medical unit at Lakeside Regional."}],["$","p",null,{"className":"text-gray-800 leading-relaxed","children":"Over a shift you bathe patients, assist with toileting, reposition people, change linens, and collect specimens. Every one of those involves close contact with body fluids. Nobody in the building has more opportunities to transmit an organism from one patient to another than you do."}],["$","p",null,{"className":"mt-3 pt-3 border-t border-amber-200 text-gray-900","children":[["$","span",null,{"className":"font-semibold","children":"Your task: "}],"Build infection control habits robust enough to survive a twelve-hour shift under time pressure."]}]]}],["$","p","1",{"className":"text-gray-700 leading-relaxed","children":"Standard Precautions apply to every patient in every encounter: blood, all body fluids except sweat, non-intact skin, and mucous membranes are treated as potentially infectious. In direct care this is not an abstraction — it governs most of what you do all day."}],["$","figure","2",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Moment"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Example"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Before touching a patient"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Before helping someone reposition"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Before a clean or aseptic procedure"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Before catheter care"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"After body fluid exposure risk"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"After assisting with toileting"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"After touching a patient"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"After a bed bath"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"After touching patient surroundings"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"After changing linens or adjusting a bed rail"}]]}]]}]]}]}],"$L25"]}],"$L26","$L27","$L28","$L29","$L2a"]}]]}]

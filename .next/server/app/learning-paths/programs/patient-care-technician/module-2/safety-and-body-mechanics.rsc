1b:["$","figure","1",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Principle"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"In practice"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Wide base of support"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Feet shoulder-width apart, one slightly forward"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Bend at the knees and hips"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Never at the waist"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Keep the load close"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Reaching multiplies the force on your spine"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Push or pull rather than lift"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Sliding uses far less force than lifting"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Never twist"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Turn your whole body by moving your feet"}]]}],["$","tr","5",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Raise the bed to waist height"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Working at a low bed guarantees a bent back"}]]}],["$","tr","6",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Get help or equipment"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Most injuries happen to people working alone"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"Body mechanics principles"}]]}]
1c:["$","div","2",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"Most healthcare back injuries are cumulative rather than the result of one dramatic lift. They come from hundreds of small repositionings done slightly wrong under time pressure. The four minutes spent finding a colleague or a lift is genuinely cheaper than the injury, and this is the single most common reason people leave direct care work."]}]
1d:["$","figure","3",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Factor"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Prevention"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"History of falls"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"The strongest single predictor — flag and monitor closely"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Confusion or altered mental status"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Frequent rounding; consider a low bed"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Medications causing dizziness or sedation"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Assist with all transfers"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Weakness or unsteady gait"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Gait belt; appropriate footwear; assistive device within reach"}]]}],["$","tr","4",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Urgency or frequency of urination"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Proactive toileting rounds"}]]}],["$","tr","5",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Environmental hazards"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Call light in reach, clear floor, adequate lighting, brakes locked"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"Fall risk factors"}]]}]
1e:["$","p","4",{"className":"text-gray-700 leading-relaxed","children":"Purposeful rounding — checking each patient on a schedule and addressing pain, position, toileting, and whether their belongings are in reach — prevents more falls than any single intervention. Most falls happen when a patient tries to do something alone because nobody has come, and the toilet is where a great many of them occur."}]
1f:["$","div","5",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"Restraints require a provider's order, are time-limited, and demand close monitoring — they are never a convenience or a substitute for staffing. They also carry real risk, including strangulation and injury from struggling against them. Side rails count: four raised rails is a restraint, and patients have died trying to climb over them. Exhaust alternatives first — rounding, repositioning, addressing the unmet need driving the behavior."]}]
20:["$","$L24","6",{"block":{"type":"knowledge-check","question":"You are alone and a patient needs repositioning up in bed. Lift equipment is available but on another unit. What should you do?","options":["Reposition them yourself using careful technique","Get help or the equipment, even though it takes several minutes","Ask the patient to help by pulling on the bed rail","Raise the head of the bed and leave it until a colleague is free"],"correctIndex":1,"explanation":"Solo repositioning is the leading cause of cumulative back injury in direct care, and careful technique does not make it safe at the weights involved. Several minutes to get help or equipment is the correct trade. If the patient must be moved urgently, call for immediate help rather than proceeding alone.","optionRationales":["Good technique reduces but does not eliminate the risk; the loads exceed safe solo limits.","Correct. Get help or equipment — the delay is much cheaper than the injury.","Patients pulling on rails risk shoulder injury and a fall, and it does not meaningfully reduce your load.","Leaving a patient sliding down in bed risks skin shear and discomfort. Get help rather than deferring indefinitely."]}}]
21:["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Challenge"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Apply what you've learned in this lesson."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"Transfers are a hands-on skill requiring supervised practice before performing them on patients."}],["$","ol","1",{"start":"$undefined","className":"list-decimal pl-6 space-y-3 text-gray-700 marker:font-semibold marker:text-primary-600","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Write the body mechanics principles from memory, then check."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"Research the Morse Fall Scale. List the factors it scores and what score indicates high risk."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"For a patient who is confused, has fallen once, and takes a sedating medication, write a fall prevention plan of five specific measures."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"Research safe patient handling equipment — sit-to-stand lifts, ceiling lifts, friction-reducing sheets. Describe when each is indicated."}]]}]]}]}]]}]

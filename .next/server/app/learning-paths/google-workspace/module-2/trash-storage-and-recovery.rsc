22:["$","div","2",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Storage"}],["$","div",null,{"className":"space-y-6","children":[["$","ul","0",{"className":"list-disc pl-6 space-y-3 text-gray-700 marker:text-primary-500","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"A free Google account has 15 GB of storage, shared by Gmail, Google Drive, and Google Photos. A work account's storage is set by the organization's plan."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"What counts: Gmail messages and attachments (including Spam and Trash), files in Drive such as PDFs, images, and videos, and items in Drive's Trash."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Google Docs, Sheets, and Slides files created or edited after June 1, 2021 count too. Files someone shared with you count against the owner's storage, not yours."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"To see what uses the most space, click Storage on the left side of Drive, then click Storage used to sort by size."}]]}],["$","p","1",{"className":"text-gray-700 leading-relaxed","children":"When an account runs out of storage, you cannot upload to Drive or create new Docs, Sheets, or Slides files, and Gmail may stop sending and receiving. Deleting large files you no longer need, and then emptying them from Trash, frees space."}]]}]]}]
23:["$","div","3",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Knowledge Check"}],["$","div",null,{"className":"space-y-6","children":[["$","$L26","0",{"block":{"type":"knowledge-check","question":"Andre deleted the pool rules yesterday. What do you do?","options":["Nothing can be done","Open Trash, right-click the file, and choose Restore","Ask Google to rebuild it","Search the Recycle Bin on the computer"],"correctIndex":1,"explanation":"Files stay in Trash for 30 days. Restore puts the file back where it was.","optionRationales":["Files stay in Trash for 30 days, so it can be restored.","Correct. Restore returns it to its folder.","Restoring it from Trash takes seconds.","Drive's Trash is in Drive, not on the computer."]}}],["$","$L26","1",{"block":{"type":"knowledge-check","question":"You remove the Vendor Contact List, which Denise owns, from your Drive. What happens to Denise's copy?","options":["It is deleted for everyone","Nothing. Only the owner can delete it, so Denise and others still have it","It moves to your Trash","Denise loses edit access"],"correctIndex":1,"explanation":"You cannot delete files you do not own. Removing one only takes it out of your Drive.","optionRationales":["Only the owner can delete a file for everyone.","Correct. The file stays for the owner and everyone else with access.","It leaves your view; Denise's file is untouched.","Her access does not change."]}}]]}]]}]

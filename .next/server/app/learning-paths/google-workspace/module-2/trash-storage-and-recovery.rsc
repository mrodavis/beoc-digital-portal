"id":"f2","name":"Laundry Schedule","kind":"doc","parent":"root","modified":"Oct 6, 2026","size":"5 KB"},{"id":"f3","name":"Riverside Pool Rules","kind":"doc","parent":"fdR","modified":"Oct 19, 2026","trashed":true,"size":"6 KB"},{"id":"f4","name":"Old Flyer Draft","kind":"doc","parent":"root","modified":"May 11, 2026","trashed":true,"size":"3 KB"},{"id":"f5","name":"Lobby Video - Full Resolution.mp4","kind":"video","parent":"root","modified":"Jun 3, 2026","size":"1.8 GB"},{"id":"f6","name":"Lobby Video - Web.mp4","kind":"video","parent":"root","modified":"Jun 3, 2026","size":"96 MB"},{"id":"f7","name":"Move-In Photos - River 114.pdf","kind":"pdf","parent":"fdR","modified":"Aug 20, 2026","size":"14 MB"}]},"tasks":[{"instruction":"Move “Copy of Copy of Laundry Schedule” to the trash.","hint":"Click the file once, then click Move to trash (the trash can) in the bar above the list. Right-click › Move to trash, or the Delete key, works too.","steps":[{"action":{"kind":"command","id":"g.trash","value":"f1"}}]},{"instruction":"Open the Trash.","hint":"Click Trash on the left side of Drive.","steps":[{"action":{"kind":"command","id":"g.go","value":"trash"}}]},{"instruction":"Restore “Riverside Pool Rules” so Andre has it back.","hint":"Right-click Riverside Pool Rules › Restore. It goes back to the Riverside Commons folder.","steps":[{"action":{"kind":"command","id":"g.restore","value":"f3"}}]},{"instruction":"Delete “Old Flyer Draft” forever. Nobody needs it.","hint":"In Trash, right-click Old Flyer Draft › Delete forever. This cannot be undone, so check the name first.","steps":[{"action":{"kind":"command","id":"g.deleteForever","value":"f4"}}]},{"instruction":"Open Storage to see which files use the most space.","hint":"Click Storage on the left side. The files are listed by Storage used, largest first.","steps":[{"action":{"kind":"command","id":"g.go","value":"storage"}}]},{"instruction":"Move the largest file, “Lobby Video - Full Resolution.mp4”, to the trash. Parkview keeps the smaller web version.","hint":"Click Lobby Video - Full Resolution.mp4 once, then click Move to trash (or right-click › Move to trash).","steps":[{"action":{"kind":"command","id":"g.trash","value":"f5"}}]}]}}]]}]]}]

1c:["$","div",null,{"id":"practice-simulation","className":"mb-12 scroll-mt-24","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Practice Simulation"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Practice what this lesson taught in a working copy of the app. Tasks appear under the window, just like GMetrix."}]]}],["$","div",null,{"className":"space-y-10","style":{"width":"min(1360px, calc(100vw - 2rem))","marginLeft":"calc((100% - min(1360px, calc(100vw - 2rem))) / 2)"},"children":[["$","$L28","gw-m2-organize",{"sim":{"id":"gw-m2-organize","app":"google","title":"Organize the Elm Street files","scenario":"Files for Elm Street Apartments are loose in My Drive and one is still called Untitled document. Build the folder Denise asked for, move and rename files, and make the important ones easy to find.","fileName":"My Drive - Google Drive","minutes":7,"initial":{"surface":"drive","me":{"name":"Jordan Lee","email":"jlee@parkviewpm.example","color":"#1a73e8"},"org":{"name":"Parkview Property Management","domain":"parkviewpm.example"},"people":[{"name":"Denise Carter","email":"dcarter@parkviewpm.example","color":"#188038"},{"name":"Marcus Reyes","email":"mreyes@parkviewpm.example","color":"#e8710a"},{"name":"Kim Nguyen","email":"knguyen@parkviewpm.example","color":"#9334e6"},{"name":"Priya Shah","email":"pshah@parkviewpm.example","color":"#d93025"},{"name":"Andre Wallace","email":"awallace@parkviewpm.example","color":"#12858a"},{"name":"Tony Russo","email":"tony@russoplumbing.example","color":"#b06000"}],"drive":{"location":"root","layout":"list"},"files":[{"id":"fdE","name":"Elm Street Apartments","kind":"folder","parent":"root","modified":"Oct 9, 2026"},{"id":"fdR","name":"Riverside Commons","kind":"folder","parent":"root","modified":"Oct 9, 2026"},{"id":"f1","name":"Elm Street Tenant List","kind":"sheet","parent":"fdE","modified":"Oct 12, 2026"},{"id":"f2","name":"Elm Street Laundry Schedule","kind":"doc","parent":"root","modified":"Oct 6, 2026","content":{"paragraphs":[{"id":"p1","text":"Laundry Room Schedule"},{"id":"p2","text":"The laundry room is open every day from 7:00 AM to 10:00 PM."}]}},{"id":"f3","name":"Untitled document","kind":"doc","parent":"root","modified":"Oct 16, 2026","content":{"paragraphs":[{"id":"p1","text":"Boiler inspection notes, Elm Street"},{"id":"p2","text":"Pressure normal. Replace the left pump within six months."}]}},{"id":"f4","name":"Vendor Contact List","kind":"sheet","parent":"root","owner":"dcarter@parkviewpm.example","modified":"Sep 28, 2026","sharing":{"people":[{"email":"jlee@parkviewpm.example","role":"Editor"}]}}]},"tasks":[{"instruction":"Inside the Elm Street Apartments folder, create a folder named “Maintenance”.","hint":"Double-click Elm Street Apartments to open it. Click New › New folder, type Maintenance, and click Create.","steps":[{"action":{"kind":"type","target":"newfolder:fdE","value":"Maintenance"}}]},{"instruction":"Go back to My Drive and move “Elm Street Laundry Schedule” into the Elm Street Apartments folder.","hint":"Click My Drive on the left side. Drag Elm Street Laundry Schedule onto the Elm Street Apartments folder, or right-click it › Organize › Move, choose Elm Street Apartments, and click Move.","steps":[{"action":{"kind":"dialog","id":"g.move","values":{"file":"f2","folder":"Elm Street Apartments"}}}]},{"instruction":"Rename “Untitled document” to “Elm Street Boiler Notes”.","hint":"Right-click Untitled document › Rename (or click it once and press F2). Type Elm Street Boiler Notes and click OK.","steps":[{"action":{"kind":"type","target":"rename:f3","value":"Elm Street Boiler Notes"}}]},{"instruction":"Move “Elm Street Boiler Notes” into the new Maintenance folder.","hint":"Right-click Elm Street Boiler Notes › Organize › Move. Open Elm Street Apartments, click Maintenance, and click Move.","steps":[{"action":{"kind":"dialog","id":"g.move","values":{"file":"f3","folder":"Maintenance"}}}]},{"instruction":"Give the Elm Street Apartments folder a green color.","hint":"Right-click Elm Street Apartments › Organize, then click the green color in the folder colors.","steps":[{"action":{"kind":"command","id":"g.color","value":"fdE|#16a765"}}]},{"instruction":"Star the Riverside Commons folder.","hint":"Right-click Riverside Commons › Organize › Add to starred, or click it once and press Ctrl+Alt+S.","steps":[{"action":{"kind":"command","id":"g.star","value":"fdR"}}]},{"instruction":"Add a shortcut to “Vendor Contact List” in the Elm Street Apartments folder, so it stays one list.","hint":"Right-click Vendor Contact List › Organize › Add shortcut. Choose Elm Street Apartments and click Add shortcut.","steps":[{"action":{"kind":"dialog","id":"g.shortcut","values":{"file":"f4","folder":"Elm Street Apartments"}}}]}]}}]]}]]}]

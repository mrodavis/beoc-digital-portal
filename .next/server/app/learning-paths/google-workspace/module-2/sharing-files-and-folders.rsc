le (or open it) and click Share."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"Type a name or email address and choose the person."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Pick a role: Viewer, Commenter, or Editor."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"Leave Notify people checked to send an email, and add a message if it helps. Uncheck it to give access quietly."}],["$","li","4",{"className":"leading-relaxed pl-1","children":"Click Send (or Share)."}]]}],["$","figure","2",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Role"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Can do"}],["$","th","2",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Use it for"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Viewer"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"View and download by default"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"People who only need to read: Priya and the handbook"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Commenter"}],["$","td","1",{"className":"px-4 py-3 text-
26:["$","div","3",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Knowledge Check"}],["$","div",null,{"className":"space-y-6","children":[["$","$L2c","0",{"block":{"type":"knowledge-check","question":"Denise needs to review a draft notice and leave notes, without changing the text herself. Which role do you give her?","options":["Viewer","Commenter","Editor","Owner"],"correctIndex":1,"explanation":"Commenters can comment and suggest edits but cannot change the file directly.","optionRationales":["Viewers cannot comment.","Correct. Commenter lets her leave notes and suggestions.","Editor lets her change the text directly, which she does not need.","Ownership is never needed for a review."]}}],["$","$L2c","1",{"block":{"type":"knowledge-check","question":"You share the Maintenance folder with Tony Russo as a Viewer. What can he open?","options":["Only the folder name","Every file in the folder, including files added later","Only files you share with him one by one","Nothing until you send each file"],"correctIndex":1,"explanation":"Files and folders inside a shared folder inherit its sharing.","optionRationales":["Viewers of a folder can open the files in it.","Correct. Everything inside inherits the folder's access, now and later.","Folder sharing covers the files inside it.","No extra step is needed. That is why you check what is in a folder before sharing it."]}}],["$","$L2c","2",{"block":{"type":"knowledge-check","question":"Which file is safe to share with Anyone with the link?","options":["A tenant's rental application","The rent payment log","The public flyer for an open apartment showing","A lease with a tenant's signature"],"correctIndex":2,"explanation":"Anyone with the link is for information you would post publicly. Personal and financial records are shared with specific people only.","optionRationales":["Applications contain personal information.","Rent records are private.","Correct. A public flyer is meant for anyone.","Signed leases contain personal details."]}}]]}]]}]

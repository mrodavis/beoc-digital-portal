25:["$","div","2",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Folders, changes, and expiration dates"}],["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"When you share a folder, every file and folder inside it gets the same access, including files added later. You cannot give someone less access to a file than they have to the folder it is in. Keep private files out of widely shared folders."}],["$","ul","1",{"className":"list-disc pl-6 space-y-3 text-gray-700 marker:text-primary-500","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Change a role: open Share, click the arrow next to the person's role, and pick a new one."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"Remove someone: click the arrow next to their role, choose Remove access, and click Save."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Turn off link sharing: under General access, choose Restricted, then click Done."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"Expiration (eligible work and school accounts): click the arrow next to a person's role, choose Add expiration, pick a date within one year, and click Save. Their access ends on that date."}],["$","li","4",{"className":"leading-relaxed pl-1","children":"Stop editors from sharing: in Share, click Settings (the gear) and uncheck Editors can change permissions and share."}]]}],["$","div","2",{"className":"rounded-xl border border-primary-200 bg-primary-50/50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-primary-700 mb-2","children":"Worked example"}],["$","h4",null,{"className":"text-lg font-bold text-gray-900 mb-1","children":"Closing the old contractor folder"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-5","children":"The Bright Paint Co. folder is still set to Anyone w
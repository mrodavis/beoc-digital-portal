1b:["$","div",null,{"id":"practice-simulation","className":"mb-12 scroll-mt-24","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Practice Simulation"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Practice what this lesson taught in a working copy of the app. Tasks appear under the window, just like GMetrix."}]]}],["$","div",null,{"className":"space-y-10","style":{"width":"min(1360px, calc(100vw - 2rem))","marginLeft":"calc((100% - min(1360px, calc(100vw - 2rem))) / 2)"},"children":[["$","$L27","gw-m2-share",{"sim":{"id":"gw-m2-share","app":"google","title":"Share Parkview's files the right way","scenario":"Several people need access to Parkview files, each for a different reason, and an old contractor folder is still open to anyone with the link. Give each person the least access they need, and close what nobody needs anymore.","fileName":"My Drive - Google Drive","minutes":8,"initial":{"surface":"drive","me":{"name":"Jordan Lee","email":"jlee@parkviewpm.example","color":"#1a73e8"},"org":{"name":"Parkview Property Management","domain":"parkviewpm.example"},"people":[{"name":"Denise Carter","email":"dcarter@parkviewpm.example","color":"#188038"},{"name":"Marcus Reyes","email":"mreyes@parkviewpm.example","color":"#e8710a"},{"name":"Kim Nguyen","email":"knguyen@parkviewpm.example","color":"#9334e6"},{"name":"Priya Shah","email":"pshah@parkviewpm.example","color":"#d93025"},{"name":"Andre Wallace","email":"awallace@parkviewpm.example","color":"#12858a"},{"name":"Tony Russo","email":"tony@russoplumbing.example","color":"#b06000"},{"name":"Lena Ortiz","email":"lena@brightpaint.example","color":"#e52592"}],"drive":{"location":"root","layout":"list"},"files":[{"id":"f1","name":"Tenant Handbook","kind":"doc","parent":"root","modified":"Oct 16, 2026","content":{"paragraphs":[{"id":"p1","text":"Parkview Tenant Handbook"},{"id":"p2","text":"This handbook explains how to reach the office, report repairs, and use shared spaces."}]}},{"id":"fdM","name":"Maintenance","kind":"folder","parent":"root","modified":"Oct 18, 2026"},{"id":"f2","name":"Faucet Repair Photos - Elm 3B","kind":"folder","parent":"fdM","modified":"Oct 14, 2026"},{"id":"f3","name":"Water Shutoff Notice","kind":"doc","parent":"root","modified":"Oct 15, 2026"},{"id":"fdP","name":"Bright Paint Co. - Hallway Painting","kind":"folder","parent":"root","modified":"Mar 4, 2026","sharing":{"access":"Anyone with the link","linkRole":"Editor","people":[{"email":"lena@brightpaint.example","role":"Editor"}]}},{"id":"f4","name":"Paint Color Choices","kind":"doc","parent":"fdP","modified":"Feb 20, 2026","owner":"lena@brightpaint.example"}]},"tasks":[{"instruction":"Share “Tenant Handbook” with Marcus Reyes as an Editor.","hint":"Click Tenant Handbook once, then click Share (the person with a plus) in the bar above the list. Type Marcus, pick Marcus Reyes, keep the role Editor, and click Send.","steps":[{"action":{"kind":"dialog","id":"g.share","values":{"file":"f1","email":"mreyes@parkviewpm.example","role":"Editor"}}}]},{"instruction":"Share “Tenant Handbook” with Priya Shah as a Viewer.","hint":"Open Share for Tenant Handbook again. Add Priya Shah, change the role on the right to Viewer, and click Send.","steps":[{"action":{"kind":"dialog","id":"g.share","values":{"file":"f1","email":"pshah@parkviewpm.example","role":"Viewer"}}}]},{"instruction":"Share the Maintenance folder with Tony Russo (tony@russoplumbing.example) as a Viewer, so he can see the repair photos.","hint":"Right-click Maintenance › Share › Share. Type tony@russoplumbing.example and press Enter, set the role to Viewer, and click Send. Drive warns that the address is outside Parkview.","steps":[{"action":{"kind":"dialog","id":"g.share","values":{"file":"fdM","email":"tony@russoplumbing.example","role":"Viewer"}}}]},{"instruction":"Set Tony Russo's access to the Maintenance folder to expire on November 30, 2026.","hint":"Open Share for Maintenance. Next to Tony Russo, open the role menu › Add expiration, pick November 30, 2026, and click Save.","steps":[{"action":{"kind":"dialog","id":"g.expiry","values":{"file":"fdM","email":"tony@russoplumbing.example","date":"2026-11-30"}}}]},{"instruction":"Change the general access of “Water Shutoff Notice” so everyone at Parkview Property Management can view it.","hint":"Open Share for Water Shutoff Notice. Under General access, click Restricted and choose Parkview Property Management. Keep the role Viewer.","steps":[{"action":{"kind":"dialog","id":"g.access","values":{"file":"f3","access":"Organization"}}}]},{"instruction":"The Bright Paint Co. folder is still open to anyone with the link. Change its general access to Restricted.","hint":"Right-click Bright Paint Co. - Hallway Painting › Share › Share. Under General access, click Anyone with the link and choose Restricted.","steps":[{"action":{"kind":"dialog","id":"g.access","values":{"file":"fdP","access":"Restricted"}}}]},{"instruction":"Remove Lena Ortiz's access to the Bright Paint Co. folder. The painting job is finished.","hint":"In the folder's Share box, open the role menu next to Lena Ortiz and choose Remove access.","steps":[{"action":{"kind":"dialog","id":"g.permission","values":{"file":"fdP","email":"lena@brightpaint.example","role":"Remove access"}}}]}]}}]]}]]}]

fd2","name":"Riverside Commons","kind":"folder","parent":"root","modified":"Oct 9, 2026"},{"id":"fd3","name":"Forms","kind":"folder","parent":"root","modified":"Oct 13, 2026","sharing":{"people":[{"email":"dcarter@parkviewpm.example","role":"Editor"},{"email":"awallace@parkviewpm.example","role":"Editor"}]}},{"id":"f1","name":"Blank Parking Permit Form","kind":"doc","parent":"fd3","modified":"Sep 3, 2026"},{"id":"f2","name":"Tenant Welcome Letter","kind":"doc","parent":"root","modified":"Oct 15, 2026"},{"id":"f3","name":"Riverside Boiler Inspection.pdf","kind":"pdf","owner":"knguyen@parkviewpm.example","modified":"Oct 17, 2026","modifiedBy":"knguyen@parkviewpm.example","size":"1.1 MB","sharing":{"people":[{"email":"jlee@parkviewpm.example","role":"Viewer"}]}}]},"tasks":[{"instruction":"Open the Forms folder.","hint":"Double-click Forms in the file list (or click it on the left side if you have it there).","steps":[{"action":{"kind":"command","id":"g.go","value":"fd3"}}]},{"instruction":"Upload the scan “Parking Permit - Elm 2C.pdf” from the computer into the Forms folder.","hint":"With Forms open, click New › File upload. Click Parking Permit - Elm 2C.pdf and click Open.","steps":[{"action":{"kind":"command","id":"g.upload","value":"Parking Permit - Elm 2C.pdf"}}]},{"instruction":"Upload “Pet Policy Signed - River 114.pdf” into the Forms folder too.","hint":"New › File upload again, choose Pet Policy Signed - River 114.pdf, and click Open. (On a real computer you can also drag files from the desktop into the open folder.)","steps":[{"action":{"kind":"command","id":"g.upload","value":"Pet Policy Signed - River 114.pdf"}}]},{"instruction":"Switch the folder to grid layout.","hint":"Click Grid layout (the four squares) at the top right of the file list.","steps":[{"action":{"kind":"command","id":"g.layout","value":"grid"}}]},{"instruction":"Select “Parking Permit - Elm 2C.pdf” and open its details.","hint":"Click the file once to select it. Then click View details (the i in a circle) at the top right of the list.","steps":[{"action":{"kind":"command","id":"g.details"},"requires":{"selection":"file:new1"},"selectHint":"Click Parking Permit - Elm 2C.pdf once to select it first."}]},{"instruction":"Kim shared the Riverside boiler inspection with you. Go to Shared with me and open “Riverside Boiler Inspection.pdf”.","hint":"Click Shared with me on the left side, then double-click Riverside Boiler Inspection.pdf. It opens in a preview.","steps":[{"action":{"kind":"command","id":"g.go","value":"shared"}},{"action":{"kind":"command","id":"g.open","value":"f3"}}]}]}}]]}]]}]

1b:["$","div",null,{"id":"practice-simulation","className":"mb-12 scroll-mt-24","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Practice Simulation"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Practice what this lesson taught in a working copy of the app. Tasks appear under the window, just like GMetrix."}]]}],["$","div",null,{"className":"space-y-10","style":{"width":"min(1360px, calc(100vw - 2rem))","marginLeft":"calc((100% - min(1360px, calc(100vw - 2rem))) / 2)"},"children":[["$","$L27","gw-m6-inbox-basics-1",{"sim":{"id":"gw-m6-inbox-basics-1","app":"gmail","title":"Get your inbox under control on day one","scenario":"It's your first morning as the office assistant at Parkview Property Management. Your Gmail inbox already has messages from coworkers, a vendor and a few senders Gmail sorted into tabs.","fileName":"Gmail","minutes":5,"initial":{"surface":"mail","me":{"name":"Jordan Lee","email":"jlee@parkviewpm.example","color":"#1a73e8"},"people":[{"name":"Denise Carter","email":"dcarter@parkviewpm.example","color":"#188038","contact":true},{"name":"Marcus Reyes","email":"mreyes@parkviewpm.example","color":"#e8710a","contact":true},{"name":"Kim Nguyen","email":"knguyen@parkviewpm.example","color":"#9334e6","contact":true},{"name":"Priya Shah","email":"pshah@parkviewpm.example","color":"#d93025","contact":true},{"name":"Andre Wallace","email":"awallace@parkviewpm.example","color":"#12858a","contact":true},{"name":"Tony Russo","email":"tony@russoplumbing.example","color":"#b06000","contact":true},{"name":"Grace Holloway","email":"gholloway@harborviewholdings.example","contact":true},{"name":"Darnell Brooks","email":"dbrooks@example.com","contact":true},{"name":"Rosa Delgado","email":"rdelgado@example.com"},{"name":"Tina Okafor","email":"tokafor@example.com","contact":true},{"name":"Sam Whitfield","email":"swhitfield@example.com","contact":true},{"name":"Bright Clean Services","email":"office@brightclean.example","contact":true},{"name":"City Water Utility","email":"billing@citywater.example"},{"name":"Office Supply Depot","email":"deals@officesupplydepot.example"},{"name":"Neighborly","email":"notifications@neighborly.example"},{"name":"Parkview IT Support","email":"it-support@parkview-pm-help.example"},{"name":"Rewards Center","email":"winner@claim-rewards-now.example"},{"name":"Landlord Learning Hub","email":"news@landlordlearninghub.example"}],"org":{"name":"Parkview Property Management","domain":"parkviewpm.example"},"messages":[{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m1","from":"dcarter@parkviewpm.example","subject":"Welcome aboard, Jordan!","date":"2026-10-21T08:05","starred":false,"unread":true,"important":true,"body":"Hi Jordan,\n\nWelcome to Parkview Property Management! Your first week is about learning our tools. Most of our work happens in Gmail, Calendar, Drive and Meet.\n\nPlease keep an eye on the shared Maintenance and Leasing threads, and ask me anything.\n\nDenise Carter\nOffice Manager"},{"to":["jlee@parkviewpm.example","dcarter@parkviewpm.example"],"box":"inbox","id":"m2","from":"awallace@parkviewpm.example","cc":["knguyen@parkviewpm.example"],"subject":"Showing at Elm Street Apartments moved to Thursday","date":"2026-10-21T09:12","unread":true,"body":"Hi all,\n\nThe prospective tenant for Elm Street Apartments, Unit 2B asked to move Wednesday's showing to Thursday at 4:00 PM. Kim, can someone unlock the side door before then?\n\nThanks,\nAndre"},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m3","from":"pshah@parkviewpm.example","subject":"October rent roll","date":"2026-10-20T16:40","body":"Hi Jordan,\n\nAttached is the October rent roll. Please don't forward it outside the office: it lists every tenant's balance.\n\nPriya","attachments":[{"name":"Rent Roll - October.xlsx","size":"48 KB"}]},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m4","from":"knguyen@parkviewpm.example","subject":"Pest control visit, Riverside Commons","date":"2026-10-20T11:03","body":"FYI, the pest control company will spray the basement at Riverside Commons next Tuesday morning. No action needed from the office.\n\nKim"},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m5","from":"deals@officesupplydepot.example","subject":"30% off printer paper this week","date":"2026-10-21T06:30","category":"Promotions","unread":true,"unsubscribe":true,"body":"Stock up and save: 30% off copy paper, toner and file folders through Sunday."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m6","from":"notifications@neighborly.example","subject":"3 neighbors posted near Elm Street","date":"2026-10-20T19:22","category":"Social","unread":true,"body":"See what your neighbors are saying: a lost cat, a yard sale and a question about recycling day."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m7","from":"billing@citywater.example","subject":"Your October statement is ready","date":"2026-10-19T07:15","category":"Updates","body":"Your October water statement for account 55-1208 (Riverside Commons) is ready to view. Amount due: $412.60."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m8","from":"tony@russoplumbing.example","subject":"Invoice #4471 for Elm Street Apartments","date":"2026-10-19T14:50","body":"Hello,\n\nPlease find attached invoice #4471 for the kitchen sink repair at Elm Street Apartments, Unit 2B, completed October 16.\n\nTony Russo\nRusso Plumbing","attachments":[{"name":"Invoice 4471.pdf","size":"212 KB"}]}],"labels":[],"settings":{"categories":["Primary","Promotions","Social","Updates"]},"view":{"folder":"inbox","tab":"Primary"}},"tasks":[{"instruction":"Open the Promotions tab to see what Gmail sorted there.","hint":"Above the message list, select the Promotions tab.","steps":[{"action":{"kind":"command","id":"gm.tab","value":"Promotions"}}]},{"instruction":"Delete the Office Supply Depot message “30% off printer paper this week.”","hint":"Point to the message and select Delete (trash can) on the right. Or check its box and select Delete at the top.","steps":[{"action":{"kind":"command","id":"gm.delete"},"requires":{"selection":"msg:m5"},"selectHint":"Check the box next to the Office Supply Depot message first, or point to it and use its Delete button."}]},{"instruction":"Go back to the Primary tab and open Denise Carter's message “Welcome aboard, Jordan!”","hint":"Select the Primary tab, then select the message to open it.","steps":[{"action":{"kind":"command","id":"gm.open","value":"m1"}}]},{"instruction":"Star this message so you can find it later.","hint":"In the open message, select the star at the top right, next to the date.","steps":[{"action":{"kind":"command","id":"gm.star","value":"on"},"requires":{"selection":"msg:m1"}}]},{"instruction":"Return to the inbox and archive Kim Nguyen's message “Pest control visit, Riverside Commons.” It needs no action, but you want to keep it.","hint":"Select Back to Inbox (arrow at the top left). Point to the message and select Archive. Or open it and select Archive at the top.","steps":[{"action":{"kind":"command","id":"gm.archive"},"requires":{"selection":"msg:m4"},"selectHint":"Point to the pest control message (or check its box) before you select Archive."}]},{"instruction":"Mark the Russo Plumbing invoice as important.","hint":"On the invoice's row, select the importance marker (the tag shape to the right of the star).","steps":[{"action":{"kind":"command","id":"gm.important","value":"on"},"requires":{"selection":"msg:m8"}}]},{"instruction":"Open All Mail to confirm the archived pest control message is still there.","hint":"In the left menu, select More, then All Mail.","steps":[{"action":{"kind":"command","id":"gm.go","value":"all"}}]}]}}]]}]]}]
1c:["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Challenge"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Apply what you've learned in this lesson."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"Practice in your own Gmail. Use a personal Google Account (you can create one for free at accounts.google.com) or your school account if it includes Gmail."}],["$","ol","1",{"start":"$undefined","className":"list-decimal pl-6 space-y-3 text-gray-700 marker:font-semibold marker:text-primary-600","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Open Gmail at mail.google.com. Write down which inbox tabs you see across the top."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"Open Settings (gear) › Quick settings › Inbox type › Customize. Write down which tabs are checked, then select Cancel (or Save if you changed something on purpose)."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Star one message you want to come back to. Open Starred to see it."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"Archive one message you no longer need in the inbox. Then open More › All Mail and find it."}],["$","li","4",{"className":"leading-relaxed pl-1","children":"Write two sentences: when you would archive a work message, and when you would delete one."}]]}],["$","div","2",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-green-50 border-green-400","children":[false,"Deliverable: Submit your list of tabs, your two sentences, and a screenshot of the archived message in All Mail to your instructor or course folder. If you can't use Gmail on your computer, complete the practice simulation and submit its results page (Print or save results on the finish card)."]}]]}]}]]}]

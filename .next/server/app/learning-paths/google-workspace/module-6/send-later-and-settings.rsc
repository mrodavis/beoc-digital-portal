24:["$","div","2",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Your signature"}],["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"A signature is the text added to the end of your messages: your name, title, company, and work phone. In Gmail on a computer, open Settings (gear) › See all settings. On the General tab, scroll to Signature, create your signature, and type the text. You can set a default signature for new emails and another for replies and forwards. Select Save Changes at the bottom of the page. A signature can be up to 10,000 characters, and images count toward that limit."}],["$","$L29","1",{"block":{"type":"drag-drop","mode":"order","title":"Put the signature steps in order","prompt":"Drag the steps into the order you'd do them.","items":[{"id":"1","text":"Select Settings (gear), then See all settings"},{"id":"2","text":"On the General tab, scroll to Signature and select Create new"},{"id":"3","text":"Name the signature and type your name, title, company, and phone"},{"id":"4","text":"Under Signature defaults, choose it for new emails and for replies and forwards"},{"id":"5","text":"Scroll to the bottom and select Save Changes"}],"explanation":"Settings changes on the See all settings pages don't take effect until you select Save Changes at the bottom."}}],["$","div","2",{"className":"bg-green-50 border-l-4 border-green-400 p-4 rounded-xl text-gray-800 leading-relaxed","children":[["$","span",null,{"aria-hidden":"true","children":"💡 "}],"While writing a message, the Insert signature button (a pen) at the bottom of the compose window lets you switch signatures or remove the signature from that one message."]}]]}]]}]
25:["$","div","3",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"The vacation responder"}],["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"The vacation responder sends an automatic reply while you're away. Open Settings › See all settings. On the General tab, find Vacation responder and select Vacation responder on. Enter the first day, an optional last day, a subject, and a message, and choose whether only people in your Contacts get the reply. Select Save Changes."}],["$","ul","1",{"className":"list-disc pl-6 space-y-3 text-gray-700 marker:text-primary-500","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Most people get the automatic reply only the first time they email you. If they write again more than four days later and the responder is still on, they get it again."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"To stop it early, select End now on the banner across the top of your inbox."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"If you set a last day, it ends at 11:59 PM that day."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"A good away message says when you'll be back and whom to contact instead. Don't announce that your home is empty or share personal details."}]]}],["$","div","2",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-blue-50 border-blue-400","children":[false,"Outlook calls this feature automatic replies. The idea is the same: dates, a message, and an option to limit replies to people you know."]}],["$","$L29","3",{"block":{"type":"drag-drop","mode":"match","title":"Which Gmail feature solves it?","prompt":"Match each problem with the feature that solves it.","items":[{"id":"a","text":"You finished the owner report Wednesday night, but it should arrive Monday at 8:00 AM.","match":"Schedule send"},{"id":"b","text":"You'll be at a training all week and people need to know whom to contact.","match":"Vacation responder"},{"id":"c","text":"Every message you send should end with your name, title, and the office phone.","match":"Signature"},{"id":"d","text":"A note about a vendor's bank details shouldn't be forwarded and should expire.","match":"Confidential mode"},{"id":"e","text":"You want 30 seconds to catch mistakes after selecting Send.","match":"Undo Send setting"}],"explanation":"Each of these is a few clicks once you know where it lives: Schedule send is under the arrow next to Send, confidential mode is in the compose toolbar, and the others are in Settings › See all settings › General."}}]]}]]}]
26:["$","div","4",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Knowledge Check"}],["$","div",null,{"className":"space-y-6","children":[["$","$L2a","0",{"block":{"type":"knowledge-check","question":"You scheduled a message for Monday, but the client asked for it today. What's the quickest fix?","options":["Delete it from Sent","Open it in Scheduled, select Cancel send, then send the draft now","Wait until Monday","Change your computer's clock"],"correctIndex":1,"explanation":"Cancel send returns the scheduled message to Drafts, where you can send it immediately.","optionRationales":["Scheduled messages aren't in Sent yet.","Correct.","The client wanted it today.","Gmail schedules on its servers; your clock doesn't matter."]}}],["$","$L2a","1",{"block":{"type":"knowledge-check","question":"Which is true about confidential mode?","options":["Recipients can't take screenshots","It turns off forwarding, copying, printing, and downloading, but recipients can still take screenshots","It encrypts the message so no one at Google can see it","It only works with an SMS passcode"],"correctIndex":1,"explanation":"Confidential mode limits what recipients can do in Gmail, but it can't stop screenshots or photos.","optionRationales":["Google warns that screenshots and photos are still possible.","Correct.","That's not what confidential mode promises; it limits recipient actions.","No SMS passcode is an option too."]}}],["$","$L2a","2",{"block":{"type":"knowledge-check","question":"Your vacation responder is on. A tenant emails you Monday and again Tuesday. How many automatic replies do they get?","options":["Two, one per message","One; most people get it only the first time, and again only after four days","None; tenants aren't in your Contacts","One per hour"],"correctIndex":1,"explanation":"Gmail replies once, then again only if the person writes after four days while the responder is still on (or after you edit the reply).","optionRationales":["Gmail avoids replying to every message.","Correct.","Only if you checked the Contacts-only option and they aren't a contact.","Gmail doesn't reply hourly."]}}]]}]]}]

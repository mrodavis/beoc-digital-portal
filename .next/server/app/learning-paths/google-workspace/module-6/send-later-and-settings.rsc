1b:["$","div",null,{"id":"practice-simulation","className":"mb-12 scroll-mt-24","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Practice Simulation"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Practice what this lesson taught in a working copy of the app. Tasks appear under the window, just like GMetrix."}]]}],["$","div",null,{"className":"space-y-10","style":{"width":"min(1360px, calc(100vw - 2rem))","marginLeft":"calc((100% - min(1360px, calc(100vw - 2rem))) / 2)"},"children":[["$","$L27","gw-m6-send-later-and-settings-1",{"sim":{"id":"gw-m6-send-later-and-settings-1","app":"gmail","title":"Schedule, protect and sign your mail","scenario":"Denise wants owner reports to arrive at the start of the week, bank details handled carefully, and every message from the office signed the same way.","fileName":"Gmail","minutes":8,"initial":{"surface":"mail","me":{"name":"Jordan Lee","email":"jlee@parkviewpm.example","color":"#1a73e8"},"people":[{"name":"Denise Carter","email":"dcarter@parkviewpm.example","color":"#188038","contact":true},{"name":"Marcus Reyes","email":"mreyes@parkviewpm.example","color":"#e8710a","contact":true},{"name":"Kim Nguyen","email":"knguyen@parkviewpm.example","color":"#9334e6","contact":true},{"name":"Priya Shah","email":"pshah@parkviewpm.example","color":"#d93025","contact":true},{"name":"Andre Wallace","email":"awallace@parkviewpm.example","color":"#12858a","contact":true},{"name":"Tony Russo","email":"tony@russoplumbing.example","color":"#b06000","contact":true},{"name":"Grace Holloway","email":"gholloway@harborviewholdings.example","contact":true},{"name":"Darnell Brooks","email":"dbrooks@example.com","contact":true},{"name":"Rosa Delgado","email":"rdelgado@example.com"},{"name":"Tina Okafor","email":"tokafor@example.com","contact":true},{"name":"Sam Whitfield","email":"swhitfield@example.com","contact":true},{"name":"Bright Clean Services","email":"office@brightclean.example","contact":true},{"name":"City Water Utility","email":"billing@citywater.example"},{"name":"Office Supply Depot","email":"deals@officesupplydepot.example"},{"name":"Neighborly","email":"notifications@neighborly.example"},{"name":"Parkview IT Support","email":"it-support@parkview-pm-help.example"},{"name":"Rewards Center","email":"winner@claim-rewards-now.example"},{"name":"Landlord Learning Hub","email":"news@landlordlearninghub.example"}],"org":{"name":"Parkview Property Management","domain":"parkviewpm.example"},"messages":[{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m1","from":"dcarter@parkviewpm.example","subject":"Welcome aboard, Jordan!","date":"2026-10-21T08:05","starred":false,"unread":true,"important":true,"body":"Hi Jordan,\n\nWelcome to Parkview Property Management! Your first week is about learning our tools. Most of our work happens in Gmail, Calendar, Drive and Meet.\n\nPlease keep an eye on the shared Maintenance and Leasing threads, and ask me anything.\n\nDenise Carter\nOffice Manager"},{"to":["jlee@parkviewpm.example","dcarter@parkviewpm.example"],"box":"inbox","id":"m2","from":"awallace@parkviewpm.example","cc":["knguyen@parkviewpm.example"],"subject":"Showing at Elm Street Apartments moved to Thursday","date":"2026-10-21T09:12","unread":true,"body":"Hi all,\n\nThe prospective tenant for Elm Street Apartments, Unit 2B asked to move Wednesday's showing to Thursday at 4:00 PM. Kim, can someone unlock the side door before then?\n\nThanks,\nAndre"},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m3","from":"pshah@parkviewpm.example","subject":"October rent roll","date":"2026-10-20T16:40","body":"Hi Jordan,\n\nAttached is the October rent roll. Please don't forward it outside the office: it lists every tenant's balance.\n\nPriya","attachments":[{"name":"Rent Roll - October.xlsx","size":"48 KB"}]},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m4","from":"knguyen@parkviewpm.example","subject":"Pest control visit, Riverside Commons","date":"2026-10-20T11:03","body":"FYI, the pest control company will spray the basement at Riverside Commons next Tuesday morning. No action needed from the office.\n\nKim"},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m5","from":"deals@officesupplydepot.example","subject":"30% off printer paper this week","date":"2026-10-21T06:30","category":"Promotions","unread":true,"unsubscribe":true,"body":"Stock up and save: 30% off copy paper, toner and file folders through Sunday."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m6","from":"notifications@neighborly.example","subject":"3 neighbors posted near Elm Street","date":"2026-10-20T19:22","category":"Social","unread":true,"body":"See what your neighbors are saying: a lost cat, a yard sale and a question about recycling day."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m7","from":"billing@citywater.example","subject":"Your October statement is ready","date":"2026-10-19T07:15","category":"Updates","body":"Your October water statement for account 55-1208 (Riverside Commons) is ready to view. Amount due: $412.60."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m8","from":"tony@russoplumbing.example","subject":"Invoice #4471 for Elm Street Apartments","date":"2026-10-19T14:50","body":"Hello,\n\nPlease find attached invoice #4471 for the kitchen sink repair at Elm Street Apartments, Unit 2B, completed October 16.\n\nTony Russo\nRusso Plumbing","attachments":[{"name":"Invoice 4471.pdf","size":"212 KB"}]}],"labels":[],"settings":{"categories":["Primary","Promotions","Social","Updates"]},"view":{"folder":"inbox","tab":"Primary"}},"tasks":[{"instruction":"Write to Grace Holloway with the subject “October owner report” and the message “Your October report is ready in the shared folder.” Schedule it to send Monday morning.","hint":"Compose › fill in To, Subject and message › select the arrow next to Send (More send options) › Schedule send › Monday morning.","steps":[{"action":{"kind":"type","target":"send:new","value":"To: gholloway@harborviewholdings.example\nSubject: October owner report\nSend: Scheduled Mon, Oct 26, 8:00 AM\nBody: Your October report is ready in the shared folder.","match":"includes"},"alt":[{"kind":"type","target":"send:new","value":["To: gholloway@harborviewholdings.example","Subject: October owner report","Send: Scheduled Mon, Oct 26, 8:00 AM"],"match":"all"}]}]},{"instruction":"Open the Scheduled folder to check that the message is waiting there.","hint":"In the left menu, select More, then Scheduled.","steps":[{"action":{"kind":"command","id":"gm.go","value":"scheduled"}}]},{"instruction":"Grace asked for the report today instead. Open the scheduled message and cancel the send so it goes back to Drafts.","hint":"In Scheduled, open the message and select Cancel send.","steps":[{"action":{"kind":"command","id":"gm.cancelSend"}}]},{"instruction":"Send Priya Shah a message in confidential mode that expires in 1 week, with No SMS passcode. Subject: “Russo Plumbing bank details changed”. Message: “Russo Plumbing sent new bank details. Please call them at the number on file to confirm before you pay.”","hint":"Compose › fill it in › Toggle confidential mode (lock and clock icon) › Set expiration: Expires in 1 week › No SMS passcode › Save › Send.","steps":[{"action":{"kind":"type","target":"send:new","value":"To: pshah@parkviewpm.example\nSubject: Russo Plumbing bank details changed\nConfidential: Expires in 1 week; No SMS passcode\nSend: Now\nBody: Russo Plumbing sent new bank details. Please call them at the number on file to confirm before you pay.","match":"includes"},"alt":[{"kind":"type","target":"send:new","value":["To: pshah@parkviewpm.example","Confidential: Expires in 1 week; No SMS passcode","confirm before you pay"],"match":"all"}]}]},{"instruction":"Create a signature named “Office” with the text “Jordan Lee | Office Assistant | Parkview Property Management”. Use it for new emails and for replies and forwards, then save.","hint":"Settings (gear) › See all settings › General › Signature › Create new › name it Office › Create › type the text › under Signature defaults choose Office in both boxes › Save Changes at the bottom.","steps":[{"action":{"kind":"type","target":"settings:general","value":"Undo Send: 5 seconds\nDefault reply behavior: Reply\nSignature: Office = Jordan Lee | Office Assistant | Parkview Property Management\nFor new emails use: Office\nOn reply/forward use: Office\nVacation responder: off","match":"includes"},"alt":[{"kind":"type","target":"settings:general","value":["Signature: Office = Jordan Lee","Office Assistant","For new emails use: Office","On reply/forward use: Office"],"match":"all"}]}]},{"instruction":"You'll be at a training October 26–30. Turn on the vacation responder: first day October 26, 2026, last day October 30, 2026, subject “Out of the office October 26–30”, and the message “I'm away until November 2. For urgent requests, please email Denise Carter at dcarter@parkviewpm.example.” Then save.","hint":"Settings (gear) › See all settings › General › Vacation responder › Vacation responder on › First day and Last day › Subject › Message › Save Changes.","steps":[{"action":{"kind":"type","target":"settings:general","value":"Undo Send: 5 seconds\nDefault reply behavior: Reply\nFor new emails use: Office\nOn reply/forward use: Office\nVacation responder: on\nFirst day: Oct 26, 2026\nLast day: Oct 30, 2026\nSubject: Out of the office October 26–30\nMessage: I'm away until November 2. For urgent requests, please email Denise Carter at dcarter@parkviewpm.example.\nOnly send a response to people in my Contacts: no","match":"includes"},"alt":[{"kind":"type","target":"settings:general","value":["Vacation responder: on","First day: Oct 26, 2026","Last day: Oct 30, 2026","Subject: Out of the office","dcarter@parkviewpm.example"],"match":"all"}]}]}]}}]]}]]}]
1c:["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Challenge"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Apply what you've learned in this lesson."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"Use your own Gmail account for these steps, and send practice messages only to yourself."}],["$","ol","1",{"start":"$undefined","className":"list-decimal pl-6 space-y-3 text-gray-700 marker:font-semibold marker:text-primary-600","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Create a signature with your name and the line “BEOC Office Assistant student”. Set it as the default for new emails and select Save Changes."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"Compose a message to yourself and schedule it for tomorrow morning. Open Scheduled and take a screenshot. Then cancel the send."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Compose a message to yourself in confidential mode that expires in 1 day. Send it, open it from your inbox, and notice what's missing (for example, the Forward option)."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"Turn on the vacation responder for any future date range with a short professional message. Take a screenshot of the settings, then turn it off and select Save Changes."}]]}],["$","div","2",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-green-50 border-green-400","children":[false,"Deliverable: Submit your three screenshots (Scheduled, the confidential message, and the vacation responder settings) to your instructor or course folder. If you can't use Gmail, complete the practice simulation and submit its results page."]}]]}]}]]}]

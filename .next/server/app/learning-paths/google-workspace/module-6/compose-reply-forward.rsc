1a:["$","div",null,{"id":"practice-simulation","className":"mb-12 scroll-mt-24","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Practice Simulation"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Practice what this lesson taught in a working copy of the app. Tasks appear under the window, just like GMetrix."}]]}],["$","div",null,{"className":"space-y-10","style":{"width":"min(1360px, calc(100vw - 2rem))","marginLeft":"calc((100% - min(1360px, calc(100vw - 2rem))) / 2)"},"children":[["$","$L27","gw-m6-compose-reply-forward-1",{"sim":{"id":"gw-m6-compose-reply-forward-1","app":"gmail","title":"Answer, forward and send without losing a step","scenario":"Andre needs the team to know a showing moved, a vendor invoice needs to reach the bookkeeper, and a tenant needs a repair notice.","fileName":"Gmail","minutes":7,"initial":{"surface":"mail","me":{"name":"Jordan Lee","email":"jlee@parkviewpm.example","color":"#1a73e8"},"people":[{"name":"Denise Carter","email":"dcarter@parkviewpm.example","color":"#188038","contact":true},{"name":"Marcus Reyes","email":"mreyes@parkviewpm.example","color":"#e8710a","contact":true},{"name":"Kim Nguyen","email":"knguyen@parkviewpm.example","color":"#9334e6","contact":true},{"name":"Priya Shah","email":"pshah@parkviewpm.example","color":"#d93025","contact":true},{"name":"Andre Wallace","email":"awallace@parkviewpm.example","color":"#12858a","contact":true},{"name":"Tony Russo","email":"tony@russoplumbing.example","color":"#b06000","contact":true},{"name":"Grace Holloway","email":"gholloway@harborviewholdings.example","contact":true},{"name":"Darnell Brooks","email":"dbrooks@example.com","contact":true},{"name":"Rosa Delgado","email":"rdelgado@example.com"},{"name":"Tina Okafor","email":"tokafor@example.com","contact":true},{"name":"Sam Whitfield","email":"swhitfield@example.com","contact":true},{"name":"Bright Clean Services","email":"office@brightclean.example","contact":true},{"name":"City Water Utility","email":"billing@citywater.example"},{"name":"Office Supply Depot","email":"deals@officesupplydepot.example"},{"name":"Neighborly","email":"notifications@neighborly.example"},{"name":"Parkview IT Support","email":"it-support@parkview-pm-help.example"},{"name":"Rewards Center","email":"winner@claim-rewards-now.example"},{"name":"Landlord Learning Hub","email":"news@landlordlearninghub.example"}],"org":{"name":"Parkview Property Management","domain":"parkviewpm.example"},"messages":[{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m1","from":"dcarter@parkviewpm.example","subject":"Welcome aboard, Jordan!","date":"2026-10-21T08:05","starred":false,"unread":true,"important":true,"body":"Hi Jordan,\n\nWelcome to Parkview Property Management! Your first week is about learning our tools. Most of our work happens in Gmail, Calendar, Drive and Meet.\n\nPlease keep an eye on the shared Maintenance and Leasing threads, and ask me anything.\n\nDenise Carter\nOffice Manager"},{"to":["jlee@parkviewpm.example","dcarter@parkviewpm.example"],"box":"inbox","id":"m2","from":"awallace@parkviewpm.example","cc":["knguyen@parkviewpm.example"],"subject":"Showing at Elm Street Apartments moved to Thursday","date":"2026-10-21T09:12","unread":true,"body":"Hi all,\n\nThe prospective tenant for Elm Street Apartments, Unit 2B asked to move Wednesday's showing to Thursday at 4:00 PM. Kim, can someone unlock the side door before then?\n\nThanks,\nAndre"},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m3","from":"pshah@parkviewpm.example","subject":"October rent roll","date":"2026-10-20T16:40","body":"Hi Jordan,\n\nAttached is the October rent roll. Please don't forward it outside the office: it lists every tenant's balance.\n\nPriya","attachments":[{"name":"Rent Roll - October.xlsx","size":"48 KB"}]},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m4","from":"knguyen@parkviewpm.example","subject":"Pest control visit, Riverside Commons","date":"2026-10-20T11:03","body":"FYI, the pest control company will spray the basement at Riverside Commons next Tuesday morning. No action needed from the office.\n\nKim"},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m5","from":"deals@officesupplydepot.example","subject":"30% off printer paper this week","date":"2026-10-21T06:30","category":"Promotions","unread":true,"unsubscribe":true,"body":"Stock up and save: 30% off copy paper, toner and file folders through Sunday."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m6","from":"notifications@neighborly.example","subject":"3 neighbors posted near Elm Street","date":"2026-10-20T19:22","category":"Social","unread":true,"body":"See what your neighbors are saying: a lost cat, a yard sale and a question about recycling day."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m7","from":"billing@citywater.example","subject":"Your October statement is ready","date":"2026-10-19T07:15","category":"Updates","body":"Your October water statement for account 55-1208 (Riverside Commons) is ready to view. Amount due: $412.60."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m8","from":"tony@russoplumbing.example","subject":"Invoice #4471 for Elm Street Apartments","date":"2026-10-19T14:50","body":"Hello,\n\nPlease find attached invoice #4471 for the kitchen sink repair at Elm Street Apartments, Unit 2B, completed October 16.\n\nTony Russo\nRusso Plumbing","attachments":[{"name":"Invoice 4471.pdf","size":"212 KB"}]}],"labels":[],"settings":{"categories":["Primary","Promotions","Social","Updates"]},"view":{"folder":"inbox","tab":"Primary"},"computer":[{"name":"Unit 4B Repair Notice.pdf","size":"96 KB","mb":0.1},{"name":"Move-in Walkthrough.mp4","size":"180 MB","mb":180},{"name":"Lobby Photo.jpg","size":"2.4 MB","mb":2.4},{"name":"Late Fee Policy.docx","size":"31 KB","mb":0.03}]},"tasks":[{"instruction":"Open Andre Wallace's message “Showing at Elm Street Apartments moved to Thursday.”","hint":"Select the message in the inbox.","steps":[{"action":{"kind":"command","id":"gm.open","value":"m2"}}]},{"instruction":"Everyone on this thread needs the update. Reply all with: “Thanks, Andre. I'll add Thursday at 4:00 PM to the showing calendar.”","hint":"Below the message, select Reply all. Type the text, then select Send.","steps":[{"action":{"kind":"type","target":"send:replyAll:m2","value":"To: awallace@parkviewpm.example\nTo: dcarter@parkviewpm.example\nCc: knguyen@parkviewpm.example\nSubject: Re: Showing at Elm Street Apartments moved to Thursday\nSend: Now\nBody: Thanks, Andre. I'll add Thursday at 4:00 PM to the showing calendar.","match":"includes"},"alt":[{"kind":"type","target":"send:replyAll:m2","value":["To: awallace@parkviewpm.example","To: dcarter@parkviewpm.example","Cc: knguyen@parkviewpm.example","showing calendar"],"match":"all"}]}]},{"instruction":"Forward the Russo Plumbing invoice (#4471) to Priya Shah with the note “Please process this invoice.”","hint":"Back to Inbox › open the invoice message › Forward (below the message). In To, type Priya and pick her name. Type the note, then Send.","steps":[{"action":{"kind":"type","target":"send:forward:m8","value":"To: pshah@parkviewpm.example\nSubject: Fwd: Invoice #4471 for Elm Street Apartments\nAttachment: Invoice 4471.pdf\nSend: Now\nBody: Please process this invoice.","match":"includes"},"alt":[{"kind":"type","target":"send:forward:m8","value":["To: pshah@parkviewpm.example","Attachment: Invoice 4471.pdf","process this invoice"],"match":"all"}]}]},{"instruction":"Reply only to Denise's welcome message: “Thank you, Denise. I'm excited to get started.”","hint":"Open “Welcome aboard, Jordan!” › Reply (not Reply all) › type › Send.","steps":[{"action":{"kind":"type","target":"send:reply:m1","value":"To: dcarter@parkviewpm.example\nSubject: Re: Welcome aboard, Jordan!\nSend: Now\nBody: Thank you, Denise. I'm excited to get started.","match":"includes"},"alt":[{"kind":"type","target":"send:reply:m1","value":["To: dcarter@parkviewpm.example","excited to get started"],"match":"all"}]}]},{"instruction":"Write a new message to Darnell Brooks and Cc Kim Nguyen. Subject: “Plumbing repair scheduled for Unit 4B”. Attach Unit 4B Repair Notice.pdf from the computer. Message: “Hi Darnell, Russo Plumbing will repair your kitchen sink on Friday morning. The notice is attached.”","hint":"Compose › To: Darnell › select Cc and add Kim › Subject › type the message › Attach files (paper clip) › Unit 4B Repair Notice.pdf › Open › Send.","steps":[{"action":{"kind":"type","target":"send:new","value":"To: dbrooks@example.com\nCc: knguyen@parkviewpm.example\nSubject: Plumbing repair scheduled for Unit 4B\nAttachment: Unit 4B Repair Notice.pdf\nSend: Now\nBody: Hi Darnell, Russo Plumbing will repair your kitchen sink on Friday morning. The notice is attached.","match":"includes"},"alt":[{"kind":"type","target":"send:new","value":["To: dbrooks@example.com","Cc: knguyen@parkviewpm.example","Subject: Plumbing repair scheduled for Unit 4B","Attachment: Unit 4B Repair Notice.pdf","Friday morning"],"match":"all"}]}]},{"instruction":"You spot a mistake right after sending. Undo sending that message.","hint":"In the “Message sent” notice at the bottom left, select Undo. Do it quickly: the notice only stays for a few seconds in real Gmail.","steps":[{"action":{"kind":"command","id":"gm.undoSend"}}]},{"instruction":"In the reopened message, change “Friday morning” to “Friday at 9:00 AM” and send it again.","hint":"Edit the text in the reopened compose window, then select Send.","steps":[{"action":{"kind":"type","target":"send:new","value":"To: dbrooks@example.com\nCc: knguyen@parkviewpm.example\nSubject: Plumbing repair scheduled for Unit 4B\nAttachment: Unit 4B Repair Notice.pdf\nSend: Now\nBody: Hi Darnell, Russo Plumbing will repair your kitchen sink on Friday at 9:00 AM. The notice is attached.","match":"includes"},"alt":[{"kind":"type","target":"send:new","value":["To: dbrooks@example.com","Friday at 9:00 AM"],"match":"all"}]}]}]}}],"$L28"]}]]}]
1b:["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Challenge"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Apply what you've learned in this lesson."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"Use your own Gmail account. Send these messages to yourself (put your own address in To) so no one else receives practice mail."}],["$","ol","1",{"start":"$undefined","className":"list-decimal pl-6 space-y-3 text-gray-700 marker:font-semibold marker:text-primary-600","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Compose a message to yourself with the subject “Practice: attachment” and attach any small file from your computer. Send it."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"Compose another message to yourself with the subject “Practice: Drive link”. Use Insert files using Drive to insert any file from your Google Drive (create a blank Google Doc first if your Drive is empty). Send it."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Open Settings › See all settings and set Undo Send to 30 seconds. Select Save Changes."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"Send yourself a third message and select Undo in the “Message sent” notice. Notice that the message reopens. Then discard it."}],["$","li","4",{"className":"leading-relaxed pl-1","children":"Open your Sent folder and take a screenshot that shows the two practice messages."}]]}],["$","div","2",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-green-50 border-green-400","children":[false,"Deliverable: Submit the screenshot of your Sent folder and one sentence explaining when you would send a Drive link instead of an attachment. If you can't use Gmail, complete the practice simulations and submit their results pages."]}]]}]}]]}]

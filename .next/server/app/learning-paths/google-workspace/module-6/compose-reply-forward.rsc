23:["$","div","1",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Reply, Reply all, or Forward"}],["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"Open a message, and below it you'll see Reply, Reply all (when there's more than one recipient), and Forward. Reply sends your answer only to the sender. Reply all sends it to the sender and everyone in the To and Cc lines. Forward sends the message, with its attachments, to someone new, and you can add a note at the top."}],["$","$L2a","1",{"block":{"type":"drag-drop","mode":"match","title":"Pick the right button","prompt":"Drag the right choice onto each situation.","items":[{"id":"a","text":"Andre wrote to you, Denise, and Kim that a showing moved, and everyone needs your confirmation.","match":"Reply all"},{"id":"b","text":"Denise welcomed you by email and copied the whole office. You want to thank her.","match":"Reply"},{"id":"c","text":"A vendor sent you an invoice that Priya, the bookkeeper, must pay.","match":"Forward"},{"id":"d","text":"You need to tell a tenant about a new parking rule, and there's no earlier email about it.","match":"Compose a new message"}],"explanation":"Reply all only when everyone on the thread needs your answer. A thank-you goes to one person. Forward when someone who wasn't on the message needs it. A new topic gets a new message with its own clear subject."}}],["$","div","2",{"className":"bg-green-50 border-l-4 border-green-400 p-4 rounded-xl text-gray-800 leading-relaxed","children":[["$","span",null,{"aria-hidden":"true","children":"💡 "}],"Before you select Reply all, look at who is on the message. A reply meant for one person that goes to the whole office is one of the most common workplace email mistakes. You can change which button is the default in Settings › See all settings › General › Default reply behavior."]}]]}]]}]
24:["$","div","2",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Attachments and Google Drive links"}],["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"To attach a file from your computer, select Attach files (the paper clip) at the bottom of the compose window, choose the file, and select Open. In a personal Gmail account, attachments can total up to 25 MB; in a work or school account, your Google Workspace administrator sets the limit. If a file is larger than the limit, Gmail doesn't attach it. It adds a Google Drive link instead."}],["$","p","1",{"className":"text-gray-700 leading-relaxed","children":"To share a file that's already in Google Drive, select Insert files using Drive (the Drive icon), pick the file, and select Insert. A Drive link works for any file in Drive, including Google Docs, Sheets, Slides, and Forms. Sending a Drive file as an attachment works only for files that weren't created in Docs, Sheets, Slides, or Forms. When you send, Gmail checks whether your recipients can open the file. If they can't, it prompts you to change the file's sharing settings first. If you choose Anyone with the link, you pick whether people can view, comment in, or edit the file; to limit access to the people on the email, select More options."}],["$","figure","2",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":""}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Attachment"}],["$","th","2",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Google Drive link"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"What the recipient gets"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Their own copy of the file"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"A link to the one file in your Drive"}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Edits after you send"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Your later changes don't reach them"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"They always see the current version"}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Size"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Up to 25 MB in personal Gmail"}],["$","td","2",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Works for large files"}]]}],["$","tr","3",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Access"}],"$L2b","$L2c"]}]]}]]}]}],"$L2d"]}],"$L2e"]}]]}]
25:["$","div","3",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Undo Send"}],["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"Right after you select Send, a “Message sent” notice appears at the bottom left with Undo and View message. Select Undo and Gmail cancels the send and reopens your message so you can fix it. You only have a few seconds. To give yourself more time, go to Settings › See all settings and, next to Undo Send, choose a cancellation period of 5, 10, 20, or 30 seconds, then select Save Changes at the bottom."}],["$","div","1",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-blue-50 border-blue-400","children":[false,"Undo Send works because Gmail waits those few seconds before it actually sends. Once the period is over, the message is gone and can't be pulled back, so read it once more before you select Send."]}]]}]]}]
26:["$","div","4",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Knowledge Check"}],["$","div",null,{"className":"space-y-6","children":[["$","$L2f","0",{"block":{"type":"knowledge-check","question":"You need to email 12 tenants about a parking lot repaving. They don't know each other. How should you address it?","options":["Put all 12 in To","Put all 12 in Cc","Put your own address in To and the 12 tenants in Bcc","Send 12 separate copies with Forward"],"correctIndex":2,"explanation":"Bcc keeps each tenant's address private, and Reply all from a tenant won't reach the others.","optionRationales":["Everyone in To can see everyone else's address.","Cc addresses are visible to everyone too.","Correct. Bcc protects their privacy.","Forward is for passing along a message you received. It's also slow and easy to get wrong."]}}],["$","$L2f","1",{"block":{"type":"knowledge-check","question":"In your personal Gmail, you attach a 180 MB video. What happens?","options":["Gmail refuses to send anything","Gmail adds a Google Drive link instead of an attachment","Gmail shrinks the video to 25 MB","The video is split into several emails"],"correctIndex":1,"explanation":"Files over the 25 MB limit are sent as Google Drive links.","optionRationales":["Gmail offers Drive instead of failing.","Correct.","Gmail doesn't compress files.","Gmail doesn't split files across messages."]}}],["$","$L2f","2",{"block":{"type":"knowledge-check","question":"Andre emailed you and Denise, with Kim in Cc. Only Andre needs your answer. Which button?","options":["Reply","Reply all","Forward","Compose"],"correctIndex":0,"explanation":"Reply goes only to the sender. Reply all would send your answer to Denise and Kim too.","optionRationales":["Correct.","Reply all includes everyone in To and Cc.","Forward sends the message to someone new.","A new message loses the thread's context."]}}]]}]]}]
28:["$","$L27","gw-m6-compose-reply-forward-2",{"sim":{"id":"gw-m6-compose-reply-forward-2","app":"gmail","title":"Send notices with Bcc, large files and Drive links","scenario":"Three tenants need the same water shutoff notice, Denise needs a video that's too big to attach, and a new applicant needs the Tenant Handbook from Google Drive.","fileName":"Gmail","minutes":6,"initial":{"surface":"mail","me":"$1a:props:children:1:props:children:0:props:sim:initial:me","people":"$1a:props:children:1:props:children:0:props:sim:initial:people","org":"$1a:props:children:1:props:children:0:props:sim:initial:org","messages":[{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m1","from":"dcarter@parkviewpm.example","subject":"Welcome aboard, Jordan!","date":"2026-10-21T08:05","starred":false,"unread":true,"important":true,"body":"Hi Jordan,\n\nWelcome to Parkview Property Management! Your first week is about learning our tools. Most of our work happens in Gmail, Calendar, Drive and Meet.\n\nPlease keep an eye on the shared Maintenance and Leasing threads, and ask me anything.\n\nDenise Carter\nOffice Manager"},{"to":["jlee@parkviewpm.example","dcarter@parkviewpm.example"],"box":"inbox","id":"m2","from":"awallace@parkviewpm.example","cc":["knguyen@parkviewpm.example"],"subject":"Showing at Elm Street Apartments moved to Thursday","date":"2026-10-21T09:12","unread":true,"body":"Hi all,\n\nThe prospective tenant for Elm Street Apartments, Unit 2B asked to move Wednesday's showing to Thursday at 4:00 PM. Kim, can someone unlock the side door before then?\n\nThanks,\nAndre"},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m3","from":"pshah@parkviewpm.example","subject":"October rent roll","date":"2026-10-20T16:40","body":"Hi Jordan,\n\nAttached is the October rent roll. Please don't forward it outside the office: it lists every tenant's balance.\n\nPriya","attachments":[{"name":"Rent Roll - October.xlsx","size":"48 KB"}]},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m4","from":"knguyen@parkviewpm.example","subject":"Pest control visit, Riverside Commons","date":"2026-10-20T11:03","body":"FYI, the pest control company will spray the basement at Riverside Commons next Tuesday morning. No action needed from the office.\n\nKim"},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m5","from":"deals@officesupplydepot.example","subject":"30% off printer paper this week","date":"2026-10-21T06:30","category":"Promotions","unread":true,"unsubscribe":true,"body":"Stock up and save: 30% off copy paper, toner and file folders through Sunday."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m6","from":"notifications@neighborly.example","subject":"3 neighbors posted near Elm Street","date":"2026-10-20T19:22","category":"Social","unread":true,"body":"See what your neighbors are saying: a lost cat, a yard sale and a question about recycling day."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m7","from":"billing@citywater.example","subject":"Your October statement is ready","date":"2026-10-19T07:15","category":"Updates","body":"Your October water statement for account 55-1208 (Riverside Commons) is ready to view. Amount due: $412.60."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m8","from":"tony@russoplumbing.example","subject":"Invoice #4471 for Elm Street Apartments","date":"2026-10-19T14:50","body":"Hello,\n\nPlease find attached invoice #4471 for the kitchen sink repair at Elm Street Apartments, Unit 2B, completed October 16.\n\nTony Russo\nRusso Plumbing","attachments":[{"name":"Invoice 4471.pdf","size":"212 KB"}]}],"labels":[],"settings":{"categories":["Primary","Promotions","Social","Updates"]},"view":{"folder":"inbox","tab":"Primary"},"computer":"$1a:props:children:1:props:children:0:props:sim:initial:computer","drive":[{"name":"Tenant Handbook","kind":"doc","sharedWith":["dcarter@parkviewpm.example","awallace@parkviewpm.example","pshah@parkviewpm.example","knguyen@parkviewpm.example"]},{"name":"Lease Renewal Checklist","kind":"doc","sharedWith":["dcarter@parkviewpm.example","awallace@parkviewpm.example"]},{"name":"Maintenance Request Log","kind":"sheet","sharedWith":["knguyen@parkviewpm.example"]},{"name":"Owner Report - October.pdf","kind":"pdf"}]},"tasks":[{"instruction":"Send one message to Darnell Brooks, Tina Okafor and Sam Whitfield without showing their addresses to each other: put yourself (jlee@parkviewpm.example) in To and the three tenants in Bcc. Subject: “Water shutoff Tuesday 9-11 AM at Riverside Commons”. Message: “The water will be off Tuesday from 9 to 11 AM for a valve repair.”","hint":"Compose › To: your own address › select Bcc › add Darnell, Tina and Sam › Subject › message › Send.","steps":[{"action":{"kind":"type","target":"send:new","value":"To: jlee@parkviewpm.example\nBcc: dbrooks@example.com\nBcc: tokafor@example.com\nBcc: swhitfield@example.com\nSubject: Water shutoff Tuesday 9-11 AM at Riverside Commons\nSend: Now\nBody: The water will be off Tuesday from 9 to 11 AM for a valve repair.","match":"includes"},"alt":[{"kind":"type","target":"send:new","value":["To: jlee@parkviewpm.example","Bcc: dbrooks@example.com","Bcc: tokafor@example.com","Bcc: swhitfield@example.com","Subject: Water shutoff","valve repair"],"match":"all"}]}]},{"instruction":"Send Denise Carter the file Move-in Walkthrough.mp4 (180 MB) from the computer with the subject “Move-in walkthrough video”.","hint":"Compose › To: Denise › Subject › Attach files › Move-in Walkthrough.mp4 › Open. Gmail turns files over 25 MB into a Google Drive link. Then Send.","steps":[{"action":{"kind":"type","target":"send:new","value":"To: dcarter@parkviewpm.example\nSubject: Move-in walkthrough video\nDrive link: Move-in Walkthrough.mp4\nSend: Now\nBody: Here is the walkthrough video.","match":"includes"},"alt":[{"kind":"type","target":"send:new","value":["To: dcarter@parkviewpm.example","Drive link: Move-in Walkthrough.mp4"],"match":"all"}]}]},{"instruction":"Send Rosa Delgado the Tenant Handbook from Google Drive as a Drive link. Only the people on the email should be able to open it, and they can view it but not edit. Subject: “Tenant Handbook”.","hint":"Compose › To: Rosa › Subject › Insert files using Drive (Drive icon) › Tenant Handbook › Insert › Send. When Gmail prompts you to change the sharing settings, select More options, choose the email's recipients (not Anyone with the link), keep Viewer, and select Send.","steps":[{"action":{"kind":"type","target":"send:new","value":"To: rdelgado@example.com\nSubject: Tenant Handbook\nDrive link: Tenant Handbook\nDrive access: Viewer\nSend: Now\nBody: Here is our Tenant Handbook.","match":"includes"},"alt":[{"kind":"type","target":"send:new","value":["To: rdelgado@example.com","Drive link: Tenant Handbook","Drive access: Viewer"],"match":"all"}]}]}]}}]

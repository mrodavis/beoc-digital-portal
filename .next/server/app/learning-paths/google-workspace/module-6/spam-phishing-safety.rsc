1b:["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-12","children":[["$","div","0",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"What phishing looks like"}],["$","div",null,{"className":"space-y-6","children":[["$","div","0",{"className":"rounded-xl border border-amber-200 bg-amber-50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-amber-800 mb-2","children":"On the job"}],"$undefined",["$","p",null,{"className":"text-sm font-medium text-amber-900 mb-2","children":"You check the Parkview mailbox first thing every morning."}],["$","p",null,{"className":"text-gray-800 leading-relaxed","children":"Today there's a message from “Parkview IT Support” saying your mailbox will be deactivated in 24 hours unless you verify your account. There's also a gift card prize, a landlord newsletter you signed up for months ago, and a missing water bill that Priya is asking about."}],["$","p",null,{"className":"mt-3 pt-3 border-t border-amber-200 text-gray-900","children":[["$","span",null,{"className":"font-semibold","children":"Your task: "}],"Decide which messages are dangerous, report them correctly, and make sure the real bill isn't lost in Spam."]}]]}],["$","p","1",{"className":"text-gray-700 leading-relaxed","children":"Phishing is email (or a text or call) designed to trick you into giving away a password, money, or personal information, or into opening a harmful link or file. Gmail checks for phishing and warns you about many dangerous messages, but some get through, so you are the last line of defense. Google's own rule is simple: Gmail will never ask for your password or other personal information by email."}],["$","figure","2",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border
25:["$","div","2",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"If you clicked"}],["$","div",null,{"className":"space-y-6","children":[["$","ul","0",{"className":"list-disc pl-6 space-y-3 text-gray-700 marker:text-primary-500","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"If a page asks for your password, don't enter it. Close it and go to the real website by typing its address yourself."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"If you already typed your password, change it right away from the real site (for a Google Account, at myaccount.google.com)."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Review your recent security activity at myaccount.google.com/notifications."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"Turn on 2-Step Verification so a stolen password alone can't open your account."}],["$","li","4",{"className":"leading-relaxed pl-1","children":"At work, tell your manager or IT contact right away. Reporting quickly protects the whole office."}]]}]]}]]}]
26:["$","div","3",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Knowledge Check"}],["$","div",null,{"className":"space-y-6","children":[["$","$L2b","0",{"block":{"type":"knowledge-check","question":"A message from “Gmail Team” says your account will close unless you reply with your password. What do you do?","options":["Reply with your password","Report phishing","Unsubscribe","Forward it to coworkers to warn them"],"correctIndex":1,"explanation":"Gmail never asks for your password by email. Report it as phishing.","optionRationales":["Never send a password by email.","Correct.","Unsubscribing from a scam can confirm your address is active.","Forwarding spreads the dangerous message. Report it, and tell IT or your manager."]}}],["$","$L2b","1",{"block":{"type":"knowledge-check","question":"Priya says the water bill never arrived. Where should you look first?","options":["Trash","Spam","Sent","Drafts"],"correctIndex":1,"explanation":"Real mail sometimes lands in Spam. If it's there, mark it Not spam.","optionRationales":["Trash only holds mail someone deleted.","Correct.","Sent holds mail you sent.","Drafts holds your unsent messages."]}}],["$","$L2b","2",{"block":{"type":"knowledge-check","question":"Which is the safest way to stop a newsletter you subscribed to on purpose?","options":["Report phishing","Unsubscribe next to the sender's name","Delete every issue","Reply STOP"],"correctIndex":1,"explanation":"For mail you signed up for, Unsubscribe is the right tool.","optionRationales":["It isn't phishing; you signed up.","Correct.","Deleting doesn't stop new issues.","Replying usually doesn't unsubscribe you."]}}]]}]]}]
2a:["$","p","2",{"className":"text-gray-700 leading-relaxed","children":"Check Spam now and then. When a real message is there, such as a bill or a reply from a new tenant, mark it Not spam. That moves it to your inbox and helps Gmail sort similar mail correctly."}]

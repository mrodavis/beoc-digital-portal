1c:["$","div",null,{"id":"practice-simulation","className":"mb-12 scroll-mt-24","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Practice Simulation"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Practice what this lesson taught in a working copy of the app. Tasks appear under the window, just like GMetrix."}]]}],["$","div",null,{"className":"space-y-10","style":{"width":"min(1360px, calc(100vw - 2rem))","marginLeft":"calc((100% - min(1360px, calc(100vw - 2rem))) / 2)"},"children":[["$","$L27","gw-m6-spam-phishing-safety-1",{"sim":{"id":"gw-m6-spam-phishing-safety-1","app":"gmail","title":"Handle suspicious mail safely","scenario":"A message claims your mailbox will be shut down, a prize offer showed up, a newsletter you no longer want keeps coming, and a real bill landed in Spam.","fileName":"Gmail","minutes":6,"initial":{"surface":"mail","me":{"name":"Jordan Lee","email":"jlee@parkviewpm.example","color":"#1a73e8"},"people":[{"name":"Denise Carter","email":"dcarter@parkviewpm.example","color":"#188038","contact":true},{"name":"Marcus Reyes","email":"mreyes@parkviewpm.example","color":"#e8710a","contact":true},{"name":"Kim Nguyen","email":"knguyen@parkviewpm.example","color":"#9334e6","contact":true},{"name":"Priya Shah","email":"pshah@parkviewpm.example","color":"#d93025","contact":true},{"name":"Andre Wallace","email":"awallace@parkviewpm.example","color":"#12858a","contact":true},{"name":"Tony Russo","email":"tony@russoplumbing.example","color":"#b06000","contact":true},{"name":"Grace Holloway","email":"gholloway@harborviewholdings.example","contact":true},{"name":"Darnell Brooks","email":"dbrooks@example.com","contact":true},{"name":"Rosa Delgado","email":"rdelgado@example.com"},{"name":"Tina Okafor","email":"tokafor@example.com","contact":true},{"name":"Sam Whitfield","email":"swhitfield@example.com","contact":true},{"name":"Bright Clean Services","email":"office@brightclean.example","contact":true},{"name":"City Water Utility","email":"billing@citywater.example"},{"name":"Office Supply Depot","email":"deals@officesupplydepot.example"},{"name":"Neighborly","email":"notifications@neighborly.example"},{"name":"Parkview IT Support","email":"it-support@parkview-pm-help.example"},{"name":"Rewards Center","email":"winner@claim-rewards-now.example"},{"name":"Landlord Learning Hub","email":"news@landlordlearninghub.example"}],"org":{"name":"Parkview Property Management","domain":"parkviewpm.example"},"messages":[{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m1","from":"dcarter@parkviewpm.example","subject":"Welcome aboard, Jordan!","date":"2026-10-21T08:05","starred":false,"unread":true,"important":true,"body":"Hi Jordan,\n\nWelcome to Parkview Property Management! Your first week is about learning our tools. Most of our work happens in Gmail, Calendar, Drive and Meet.\n\nPlease keep an eye on the shared Maintenance and Leasing threads, and ask me anything.\n\nDenise Carter\nOffice Manager"},{"to":["jlee@parkviewpm.example","dcarter@parkviewpm.example"],"box":"inbox","id":"m2","from":"awallace@parkviewpm.example","cc":["knguyen@parkviewpm.example"],"subject":"Showing at Elm Street Apartments moved to Thursday","date":"2026-10-21T09:12","unread":true,"body":"Hi all,\n\nThe prospective tenant for Elm Street Apartments, Unit 2B asked to move Wednesday's showing to Thursday at 4:00 PM. Kim, can someone unlock the side door before then?\n\nThanks,\nAndre"},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m3","from":"pshah@parkviewpm.example","subject":"October rent roll","date":"2026-10-20T16:40","body":"Hi Jordan,\n\nAttached is the October rent roll. Please don't forward it outside the office: it lists every tenant's balance.\n\nPriya","attachments":[{"name":"Rent Roll - October.xlsx","size":"48 KB"}]},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m4","from":"knguyen@parkviewpm.example","subject":"Pest control visit, Riverside Commons","date":"2026-10-20T11:03","body":"FYI, the pest control company will spray the basement at Riverside Commons next Tuesday morning. No action needed from the office.\n\nKim"},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m5","from":"deals@officesupplydepot.example","subject":"30% off printer paper this week","date":"2026-10-21T06:30","category":"Promotions","unread":true,"unsubscribe":true,"body":"Stock up and save: 30% off copy paper, toner and file folders through Sunday."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m6","from":"notifications@neighborly.example","subject":"3 neighbors posted near Elm Street","date":"2026-10-20T19:22","category":"Social","unread":true,"body":"See what your neighbors are saying: a lost cat, a yard sale and a question about recycling day."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m7","from":"billing@citywater.example","subject":"Your October statement is ready","date":"2026-10-19T07:15","category":"Updates","body":"Your October water statement for account 55-1208 (Riverside Commons) is ready to view. Amount due: $412.60."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m8","from":"tony@russoplumbing.example","subject":"Invoice #4471 for Elm Street Apartments","date":"2026-10-19T14:50","body":"Hello,\n\nPlease find attached invoice #4471 for the kitchen sink repair at Elm Street Apartments, Unit 2B, completed October 16.\n\nTony Russo\nRusso Plumbing","attachments":[{"name":"Invoice 4471.pdf","size":"212 KB"}]},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"p1","from":"it-support@parkview-pm-help.example","subject":"Action required: your mailbox will be deactivated","date":"2026-10-21T09:55","unread":true,"body":"Dear user,\n\nYour mailbox has exceeded its storage limit and will be DEACTIVATED within 24 hours. To keep your email, verify your account now:\n\n[Verify your account](http://parkview-pm-help.example/verify-login)\n\nParkview IT Support"},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"p2","from":"winner@claim-rewards-now.example","subject":"You've won a $500 gift card!","date":"2026-10-21T08:41","unread":true,"body":"Congratulations! Claim your $500 gift card today. Just pay a $4.99 processing fee: [Claim now](http://claim-rewards-now.example/claim)"},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"p3","from":"news@landlordlearninghub.example","subject":"This week: fair housing basics for small landlords","date":"2026-10-20T12:00","category":"Primary","unsubscribe":true,"body":"Join our free webinar on fair housing basics. You are receiving this because you signed up at landlordlearninghub.example."},{"to":["jlee@parkviewpm.example"],"box":"spam","id":"p4","from":"billing@citywater.example","subject":"Past-due notice: Elm Street Apartments water account","date":"2026-10-18T07:30","body":"Our records show the water account for Elm Street Apartments (account 55-1311) has a past-due balance of $96.40. Please pay by the due date on your statement."}],"labels":[],"settings":{"categories":["Primary","Promotions","Social","Updates"]},"view":{"folder":"inbox","tab":"Primary"}},"tasks":[{"instruction":"Open the message “Action required: your mailbox will be deactivated.”","hint":"Select the message in the inbox.","steps":[{"action":{"kind":"command","id":"gm.open","value":"p1"}}]},{"instruction":"Look at the sender's address: it isn't from parkviewpm.example. Report the message as phishing.","hint":"In the message, next to Reply, select More (three dots) › Report phishing. Confirm in the box that opens.","steps":[{"action":{"kind":"command","id":"gm.phishing"},"requires":{"selection":"msg:p1"}}]},{"instruction":"Report the “You've won a $500 gift card!” message as spam.","hint":"Check the box next to the message (or open it) › Report spam (stop-sign icon) at the top.","steps":[{"action":{"kind":"command","id":"gm.spam"},"requires":{"selection":"msg:p2"},"selectHint":"Check the box next to the gift card message first."}]},{"instruction":"You signed up for the Landlord Learning Hub newsletter but don't want it anymore. Unsubscribe from it.","hint":"Open the newsletter › select Unsubscribe next to the sender's name › Unsubscribe.","steps":[{"action":{"kind":"command","id":"gm.unsubscribe"},"requires":{"selection":"msg:p3"}}]},{"instruction":"Open the Spam folder.","hint":"In the left menu, select More, then Spam.","steps":[{"action":{"kind":"command","id":"gm.go","value":"spam"}}]},{"instruction":"The City Water past-due notice is a real bill that landed in Spam by mistake. Mark it as not spam.","hint":"In Spam, check the box next to the City Water message (or open it) › Not spam.","steps":[{"action":{"kind":"command","id":"gm.notSpam"},"requires":{"selection":"msg:p4"},"selectHint":"Check the box next to the City Water message first."}]}]}}]]}]]}]

21:["$","div","3",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Knowledge Check"}],["$","div",null,{"className":"space-y-6","children":[["$","$L24","0",{"block":{"type":"knowledge-check","question":"Kim and Marcus are both in the log. Marcus wants to see only Riverside rows without changing Kim's screen. What should he use?","options":["Data › Create a filter","Data › Create filter view","Sort the sheet by building","Delete the Elm Street rows"],"correctIndex":1,"explanation":"A filter view changes only Marcus's view.","optionRationales":["A filter changes the sheet for everyone, including Kim.","Correct. A filter view affects only the person using it.","Sorting reorders the rows for everyone and still shows Elm Street.","Deleting data is never the way to hide it."]}}],["$","$L24","1",{"block":{"type":"knowledge-check","question":"You want every High priority cell to turn red automatically, now and when new requests are added. What do you use?","options":["Fill color on each cell","A conditional formatting rule","A filter","Bold"],"correctIndex":1,"explanation":"A conditional formatting rule checks the cells for you and keeps working as data changes.","optionRationales":["Manual fill must be redone for every new request.","Correct. Text is exactly High with a red fill keeps working automatically.","A filter hides rows; it does not color them.","Bold is manual formatting too."]}}]]}]]}]

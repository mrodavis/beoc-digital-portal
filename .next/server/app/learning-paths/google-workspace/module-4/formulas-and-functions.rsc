2a:["$","div","3",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Knowledge Check"}],["$","div",null,{"className":"space-y-6","children":[["$","$L2e","0",{"block":{"type":"knowledge-check","question":"You copy =C2+D2 from E2 down to E3. What is the formula in E3?","options":["=C2+D2","=C3+D3","=$C$3+$D$3","=E2"],"correctIndex":1,"explanation":"Relative references move with the formula: one row down, so row 2 becomes row 3.","optionRationales":["That would happen only with absolute references ($C$2).","Correct. Relative references adjust to the new row.","Copying does not add dollar signs.","The fill handle copies the formula, not a reference to the cell above."]}}],["$","$L2e","1",{"block":{"type":"knowledge-check","question":"Every row must compare its total with the limit in H2. Which reference do you use for the limit?","options":["H2","$$H$2","H$","=H2"],"correctIndex":1,"explanation":"$$H$2 stays the same in every row when the formula is copied.","optionRationales":["H2 would become H3, H4, and so on as you fill down.","Correct. The dollar signs lock both the column and the row.","That is not a valid reference.","The equals sign starts a formula; it does not lock a reference."]}}]]}]]}]

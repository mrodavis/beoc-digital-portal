28:["$","$L2d","2",{"block":{"type":"drag-drop","mode":"match","title":"Which function?","prompt":"Match each question to the function that answers it.","items":[{"id":"fx1","text":"What did all the repairs cost together?","match":"SUM"},{"id":"fx2","text":"What does a typical repair cost?","match":"AVERAGE"},{"id":"fx3","text":"What was the most expensive repair?","match":"MAX"},{"id":"fx4","text":"Was this repair over the limit?","match":"IF"},{"id":"fx5","text":"How many repairs went over the limit?","match":"COUNTIF"}],"explanation":"SUM adds, AVERAGE finds the typical value, MAX finds the largest, IF makes a yes-or-no decision, and COUNTIF counts how many match."}}]

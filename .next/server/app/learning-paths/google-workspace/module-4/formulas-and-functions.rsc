fmt":{"bold":true}},"D1":{"v":"Labor","fmt":{"bold":true}},"E1":{"v":"Total","fmt":{"bold":true}},"F1":{"v":"Limit check","fmt":{"bold":true}},"A2":{"v":"Kitchen faucet"},"B2":{"v":"Elm 3B"},"C2":{"v":42},"D2":{"v":95},"A3":{"v":"Heater fan"},"B3":{"v":"River 210"},"C3":{"v":180},"D3":{"v":160},"A4":{"v":"Mailbox lock"},"B4":{"v":"Elm 1A"},"C4":{"v":28},"D4":{"v":45},"A5":{"v":"Dishwasher pump"},"B5":{"v":"River 114"},"C5":{"v":135},"D5":{"v":190},"A6":{"v":"Bathroom fan"},"B6":{"v":"Elm 2C"},"C6":{"v":64},"D6":{"v":80},"A7":{"v":"Window latch"},"B7":{"v":"River 305"},"C7":{"v":18},"D7":{"v":40},"A8":{"v":"Garbage disposal"},"B8":{"v":"Elm 2A"},"C8":{"v":120},"D8":{"v":110},"A10":{"v":"Total","fmt":{"bold":true}},"A11":{"v":"Average","fmt":{"bold":true}},"A12":{"v":"Highest","fmt":{"bold":true}},"F10":{"v":""},"H1":{"v":"Limit per repair","fmt":{"bold":true}},"H2":{"v":300,"fmt":{"numFmt":"Currency"}}},"colWidths":{"A":140,"B":90,"C":70,"D":70,"E":80,"F":100,"H":130}}]},"owner":"knguyen@parkviewpm.example","sharing":{"people":[{"email":"jlee@parkviewpm.example","role":"Editor"}]}}]},"tasks":[{"instruction":"In E2, enter a formula that adds the parts and labor: “=C2+D2”.","hint":"Click E2, type =C2+D2, and press Enter. You can click C2 and D2 while typing instead of typing the references.","steps":[{"action":{"kind":"type","target":"E2","value":["=C2+D2","=D2+C2","=SUM(C2:D2)"],"match":"formula"}}]},{"instruction":"Fill the formula in E2 down through E8.","hint":"Click E2 and drag the small blue square at its bottom right corner down to E8. Or select E2:E8 and press Ctrl+D.","steps":[{"action":{"kind":"command","id":"excel.fill","value":"E2:E8"},"requires":{"selection":"E2"},"selectHint":"Click E2, the cell with the formula, first.","alt":[{"kind":"command","id":"home.fillSeries","value":"Down","requires":{"selection":"E2:E8"}}]}]},{"instruction":"In E10, total the repair costs with SUM.","hint":"Click E10, type =SUM(E2:E8), and press Enter.","steps":[{"action":{"kind":"type","target":"E10","value":"=SUM(E2:E8)","match":"formula"}}]},{"instruction":"In E11, find the average repair cost.","hint":"Click E11, type =AVERAGE(E2:E8), and press Enter.","steps":[{"action":{"kind":"type","target":"E11","value":"=AVERAGE(E2:E8)","match":"formula"}}]},{"instruction":"In E12, find the highest repair cost.","hint":"Click E12, type =MAX(E2:E8), and press Enter.","steps":[{"action":{"kind":"type","target":"E12","value":"=MAX(E2:E8)","match":"formula"}}]},{"instruction":"In F2, enter “=IF(E2>$H$2,\"Over\",\"OK\")” so the limit in H2 stays locked when you copy the formula.","hint":"Click F2 and type =IF(E2>$H$2,\"Over\",\"OK\") exactly, with the dollar signs (press F4 after typing H2 to add them). Press Enter.","steps":[{"action":{"kind":"type","target":"F2","value":"=IF(E2>$H$2,\"Over\",\"OK\")","match":"formula","strictRefs":true}}]},{"instruction":"Fill the formula in F2 down through F8.","hint":"Click F2 and drag its fill handle (the blue square) down to F8, or select F2:F8 and press Ctrl+D.","steps":[{"action":{"kind":"command","id":"excel.fill","value":"F2:F8"},"requires":{"selection":"F2"},"selectHint":"Click F2 first.","alt":[{"kind":"command","id":"home.fillSeries","value":"Down","requires":{"selection":"F2:F8"}}]}]},{"instruction":"In F10, count how many repairs are over the limit with COUNTIF.","hint":"Click F10, type =COUNTIF(F2:F8,\"Over\"), and press Enter.","steps":[{"action":{"kind":"type","target":"F10","value":"=COUNTIF(F2:F8,\"Over\")","match":"formula"}}]}]}}]]}]]}]

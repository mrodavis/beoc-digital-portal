20:["$","$L25","3",{"block":{"type":"drag-drop","mode":"sort","title":"Which tool fits?","prompt":"Sort each request.","buckets":[{"id":"dropdown","label":"Dropdown"},{"id":"protect","label":"Protected range"},{"id":"note","label":"Note"},{"id":"comment","label":"Comment"}],"items":[{"id":"d1","text":"Everyone must pick the category from the same three choices","bucket":"dropdown"},{"id":"d2","text":"Nobody but you should change the Total formulas","bucket":"protect"},{"id":"d3","text":"Explain that a price is higher because the vendor changed","bucket":"note"},{"id":"d4","text":"Ask Priya whether the order needs approval","bucket":"comment"}],"explanation":"Dropdowns control what people enter, protection stops accidental edits, notes explain, and comments start a conversation."}}]
21:["$","div","2",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Sharing and downloading"}],["$","div",null,{"className":"space-y-6","children":[["$","ul","0",{"className":"list-disc pl-6 space-y-3 text-gray-700 marker:text-primary-500","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Share a sheet the same way as any file: Share at the top right, add people, pick Viewer, Commenter, or Editor."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"File › Download › Microsoft Excel (.xlsx) downloads every sheet as an Excel workbook."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"File › Download › Comma Separated Values (.csv) saves plain data for another system. A CSV file holds one sheet of data with no formatting, so open the sheet you need first."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"File › Version history shows earlier versions. Restoring a spreadsheet version clears the cell-by-cell edit history for earlier changes; make a copy instead if you need to keep that history."}]]}]]}]]}]
22:["$","div","3",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Knowledge Check"}],["$","div",null,{"className":"space-y-6","children":[["$","$L26","0",{"block":{"type":"knowledge-check","question":"You protected the Total column so only you can edit it. Can a coworker who can view the sheet copy those cells into another file?","options":["No, protection blocks copying","Yes. Protection stops edits, not copying, printing, or exporting","Only if they are an Editor","Only on a phone"],"correctIndex":1,"explanation":"Protection prevents accidental changes. It is not a way to keep data private.","optionRationales":["Copying is still possible.","Correct. Share only with people who should see the data.","Viewers can copy too.","Device does not matter."]}}],["$","$L26","1",{"block":{"type":"knowledge-check","question":"Priya's accounting system needs the current sheet as plain data. Which download?","options":["PDF","Comma Separated Values (.csv)","Microsoft Excel (.xlsx)","Web page"],"correctIndex":1,"explanation":"A CSV file is plain data, one sheet with no formatting, that most systems can import.","optionRationales":["A PDF is a picture of the page, not data a system can import.","Correct. CSV is plain data for other systems.","Excel keeps formatting and every sheet; use it when the person works in Excel.","A web page is for publishing, not importing."]}}]]}]]}]

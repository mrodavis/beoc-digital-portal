1b:["$","div",null,{"id":"practice-simulation","className":"mb-12 scroll-mt-24","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Practice Simulation"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Practice what this lesson taught in a working copy of the app. Tasks appear under the window, just like GMetrix."}]]}],["$","div",null,{"className":"space-y-10","style":{"width":"min(1360px, calc(100vw - 2rem))","marginLeft":"calc((100% - min(1360px, calc(100vw - 2rem))) / 2)"},"children":[["$","$L23","gw-m4-protect-share",{"sim":{"id":"gw-m4-protect-share","app":"google","title":"Make the supply order sheet hard to break","scenario":"Four people add items to the monthly supply order. Categories get typed in different ways, and someone typed over the Total formulas last month. Add a dropdown and checkboxes, protect the formulas, leave a note, share it with Priya, and download a copy for her accounting system.","fileName":"Supply Order - November","minutes":7,"initial":{"surface":"sheets","open":"f1","tabs":["f1"],"me":{"name":"Jordan Lee","email":"jlee@parkviewpm.example","color":"#1a73e8"},"org":{"name":"Parkview Property Management","domain":"parkviewpm.example"},"people":[{"name":"Denise Carter","email":"dcarter@parkviewpm.example","color":"#188038"},{"name":"Marcus Reyes","email":"mreyes@parkviewpm.example","color":"#e8710a"},{"name":"Kim Nguyen","email":"knguyen@parkviewpm.example","color":"#9334e6"},{"name":"Priya Shah","email":"pshah@parkviewpm.example","color":"#d93025"},{"name":"Andre Wallace","email":"awallace@parkviewpm.example","color":"#12858a"},{"name":"Tony Russo","email":"tony@russoplumbing.example","color":"#b06000"}],"files":[{"id":"f1","name":"Supply Order - November","kind":"sheet","parent":"root","modified":"Oct 19, 2026","content":{"active":"Order","sheets":[{"name":"Order","cells":{"A1":{"v":"Item","fmt":{"bold":true}},"B1":{"v":"Category","fmt":{"bold":true}},"C1":{"v":"Quantity","fmt":{"bold":true}},"D1":{"v":"Unit Cost","fmt":{"bold":true}},"E1":{"v":"Total","fmt":{"bold":true}},"F1":{"v":"Ordered","fmt":{"bold":true}},"A2":{"v":"Mop heads"},"C2":{"v":6},"D2":{"v":7.5,"fmt":{"numFmt":"Currency"}},"A3":{"v":"Light bulbs (pack)"},"C3":{"v":4},"D3":{"v":11.25,"fmt":{"numFmt":"Currency"}},"A4":{"v":"Printer paper (case)"},"C4":{"v":2},"D4":{"v":42,"fmt":{"numFmt":"Currency"}},"A5":{"v":"Trash bags (box)"},"C5":{"v":5},"D5":{"v":18,"fmt":{"numFmt":"Currency"}},"A6":{"v":"Furnace filters"},"C6":{"v":10},"D6":{"v":9.4,"fmt":{"numFmt":"Currency"}},"A7":{"v":"Glass cleaner"},"C7":{"v":6},"D7":{"v":4.25,"fmt":{"numFmt":"Currency"}},"A8":{"v":"Sticky notes"},"C8":{"v":12},"D8":{"v":1.5,"fmt":{"numFmt":"Currency"}},"E2":{"f":"=C2*D2","fmt":{"numFmt":"Currency"}},"E3":{"f":"=C3*D3","fmt":{"numFmt":"Currency"}},"E4":{"f":"=C4*D4","fmt":{"numFmt":"Currency"}},"E5":{"f":"=C5*D5","fmt":{"numFmt":"Currency"}},"E6":{"f":"=C6*D6","fmt":{"numFmt":"Currency"}},"E7":{"f":"=C7*D7","fmt":{"numFmt":"Currency"}},"E8":{"f":"=C8*D8","fmt":{"numFmt":"Currency"}},"A9":{"v":"Order total","fmt":{"bold":true}},"E9":{"f":"=SUM(E2:E8)","fmt":{"numFmt":"Currency","bold":true}}},"colWidths":{"A":170,"B":110,"C":80,"D":90,"E":90,"F":80}}]}}]},"tasks":[{"instruction":"Add a dropdown to B2:B8 with the options “Cleaning”, “Maintenance”, and “Office”, in that order.","hint":"Select B2:B8, then Insert › Dropdown (or Data › Data validation › Add rule). Keep Dropdown as the criteria, type each option in its own box (Add another item gives you a third), and click Done.","steps":[{"action":{"kind":"dialog","id":"g.validation","values":{"range":"B2:B8","criteria":"Dropdown","items":"Cleaning, Maintenance, Office"}}}]},{"instruction":"Insert checkboxes in F2:F8, so people can check off what has been ordered.","hint":"Select F2:F8, then Insert › Checkbox.","steps":[{"action":{"kind":"command","id":"g.checkbox"},"requires":{"selection":"F2:F8"},"selectHint":"Select F2:F8 first."}]},{"instruction":"Protect the Total formulas in E2:E9 so that only you can edit them.","hint":"Select E2:E9, then Data › Protect sheets and ranges. Click Add a sheet or range, check the range, click Set permissions, keep Restrict who can edit this range with Only you, and click Done.","steps":[{"action":{"kind":"dialog","id":"g.protect","values":{"range":"E2:E9","mode":"Restrict who can edit this range"}}}]},{"instruction":"Add the note “Price went up in October.” to D6.","hint":"Right-click D6 › Insert note (or click D6 and press Shift+F2). Type the note and click Done.","steps":[{"action":{"kind":"type","target":"note:D6","value":"Price went up in October."}}]},{"instruction":"Share the spreadsheet with Priya Shah as a Commenter.","hint":"Click Share at the top right. Add Priya Shah, change the role to Commenter, and click Send.","steps":[{"action":{"kind":"dialog","id":"g.share","values":{"file":"f1","email":"pshah@parkviewpm.example","role":"Commenter"}}}]},{"instruction":"Download the order sheet as a CSV file for Priya's accounting system.","hint":"With the Order sheet open, choose File › Download › Comma Separated Values (.csv).","steps":[{"action":{"kind":"command","id":"g.download","value":"Comma Separated Values (.csv)"}}]}]}}]]}]]}]

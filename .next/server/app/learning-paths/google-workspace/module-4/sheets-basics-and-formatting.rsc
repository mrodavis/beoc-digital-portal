"v":"Lease Ends"},"A2":{"v":"Elm 1A"},"B2":{"v":"Rosa Delgado"},"C2":{"v":1325},"D2":{"v":1},"E2":{"v":"3/31/2027"},"A3":{"v":"Elm 1B"},"B3":{"v":"Sam Whitfield"},"C3":{"v":1450},"D3":{"v":2},"E3":{"v":"6/30/2027"},"A4":{"v":"Elm 2A"},"B4":{"v":"Grace Lin"},"C4":{"v":1325},"D4":{"v":1},"E4":{"v":"1/31/2027"},"A5":{"v":"Elm 2B"},"B5":{"v":"Omar Haddad"},"C5":{"v":1475},"D5":{"v":2},"E5":{"v":"8/31/2027"},"A6":{"v":"Elm 2C"},"B6":{"v":"Tina Okafor"},"C6":{"v":1400},"D6":{"v":2},"E6":{"v":"10/31/2027"},"A7":{"v":"Elm 3A"},"B7":{"v":"Luis Ortega"},"C7":{"v":1295},"D7":{"v":1},"E7":{"v":"12/31/2026"},"A8":{"v":"Elm 3B"},"B8":{"v":"Hannah Price"},"C8":{"v":1500},"D8":{"v":2},"E8":{"v":"5/31/2027"}},"colWidths":{"A":90,"B":130,"C":110,"D":80,"E":100}}]},"owner":"pshah@parkviewpm.example","sharing":{"people":[{"email":"jlee@parkviewpm.example","role":"Editor"}]}}]},"tasks":[{"instruction":"In row 9, add the new tenant: type “Elm 3C” in A9, then “Kevin Brooks” in B9.","hint":"Click A9, type Elm 3C, and press Tab to move to B9. Type Kevin Brooks and press Enter.","anyOrder":false,"steps":[{"action":{"kind":"type","target":"A9","value":"Elm 3C"}},{"action":{"kind":"type","target":"B9","value":"Kevin Brooks"}}]},{"instruction":"Bold the header row, A1 through E1.","hint":"Click row number 1 (or drag from A1 to E1), then click Bold on the toolbar or press Ctrl+B.","steps":[{"action":{"kind":"command","id":"home.bold"},"requires":{"selection":["A1:E1","1:1"]},"selectHint":"Select A1:E1 (or all of row 1) first."}]},{"instruction":"Give the header row the fill color light gray 2.","hint":"With row 1 selected, click Fill color (the paint bucket) and choose light gray 2 in the top row of colors.","steps":[{"action":{"kind":"command","id":"home.fill","value":"#efefef"},"requires":{"selection":["A1:E1","1:1"]},"selectHint":"Select A1:E1 (or all of row 1) first."}]},{"instruction":"Format the rents in C2:C9 as currency.","hint":"Select C2:C9, then click Format as currency ($) on the toolbar, or press Ctrl+Shift+4.","steps":[{"action":{"kind":"command","id":"home.numberFormat","value":"Currency"},"requires":{"selection":["C2:C9","C:C"]},"selectHint":"Select C2:C9 first (drag from C2 to C9)."}]},{"instruction":"Freeze the header row so it stays visible when you scroll.","hint":"View › Freeze › 1 row.","steps":[{"action":{"kind":"command","id":"g.freeze","value":"1 row"}}]},{"instruction":"Rename the sheet tab “Sheet1” to “Elm Street”.","hint":"Double-click the Sheet1 tab at the bottom (or right-click it › Rename), type Elm Street, and press Enter.","steps":[{"action":{"kind":"type","target":"sheet:Sheet1","value":"Elm Street"}}]},{"instruction":"Add a new sheet and name it “Riverside Commons”.","hint":"Click + (Add Sheet) at the bottom left. Then double-click the new Sheet2 tab, type Riverside Commons, and press Enter.","steps":[{"action":{"kind":"command","id":"sheet.add"}},{"action":{"kind":"type","target":"sheet:Sheet2","value":"Riverside Commons"}}]}]}}]]}]]}]

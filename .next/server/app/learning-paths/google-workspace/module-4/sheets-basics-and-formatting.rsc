28:["$","div","3",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Knowledge Check"}],["$","div",null,{"className":"space-y-6","children":[["$","$L2d","0",{"block":{"type":"knowledge-check","question":"C4 shows $1,450.00. What does the formula bar show when you click C4?","options":["$$1,450.00","1450","C4","Currency"],"correctIndex":1,"explanation":"The formula bar shows the value in the cell. Currency is only how it is displayed.","optionRationales":["That is the display. The formula bar shows the stored value.","Correct. The value is 1450; the format adds the dollar sign and decimals.","C4 is the cell's name, shown in the name box.","Currency is the format, not the content."]}}],["$","$L2d","1",{"block":{"type":"knowledge-check","question":"The header row disappears when you scroll to row 80. What fixes it?","options":["Bold the header row","View › Freeze › 1 row","Sort the sheet","Insert a new sheet"],"correctIndex":1,"explanation":"Freezing keeps rows on screen while the rest scrolls.","optionRationales":["Bold makes the header stand out but does not keep it on screen.","Correct. Freeze 1 row keeps the header visible.","Sorting reorders data; it does not keep the header visible.","A new sheet does not change scrolling."]}}]]}]]}]

rue}},"A2":{"v":"June"},"B2":{"v":14},"A3":{"v":"July"},"B3":{"v":19},"A4":{"v":"August"},"B4":{"v":23},"A5":{"v":"September"},"B5":{"v":17},"A6":{"v":"October"},"B6":{"v":26}},"colWidths":{"A":110,"B":90}},{"name":"Rent Roll","cells":{"A1":{"v":"Building","fmt":{"bold":true}},"B1":{"v":"Apartment","fmt":{"bold":true}},"C1":{"v":"Rent","fmt":{"bold":true}},"D1":{"v":"Status","fmt":{"bold":true}},"A2":{"v":"Elm Street"},"B2":{"v":"Elm 1A"},"C2":{"v":1325,"fmt":{"numFmt":"Currency"}},"D2":{"v":"Paid"},"A3":{"v":"Elm Street"},"B3":{"v":"Elm 1B"},"C3":{"v":1450,"fmt":{"numFmt":"Currency"}},"D3":{"v":"Paid"},"A4":{"v":"Elm Street"},"B4":{"v":"Elm 2A"},"C4":{"v":1325,"fmt":{"numFmt":"Currency"}},"D4":{"v":"Late"},"A5":{"v":"Elm Street"},"B5":{"v":"Elm 2B"},"C5":{"v":1475,"fmt":{"numFmt":"Currency"}},"D5":{"v":"Paid"},"A6":{"v":"Elm Street"},"B6":{"v":"Elm 2C"},"C6":{"v":1400,"fmt":{"numFmt":"Currency"}},"D6":{"v":"Paid"},"A7":{"v":"Elm Street"},"B7":{"v":"Elm 3A"},"C7":{"v":1295,"fmt":{"numFmt":"Currency"}},"D7":{"v":"Late"},"A8":{"v":"Riverside"},"B8":{"v":"River 114"},"C8":{"v":1550,"fmt":{"numFmt":"Currency"}},"D8":{"v":"Paid"},"A9":{"v":"Riverside"},"B9":{"v":"River 118"},"C9":{"v":1500,"fmt":{"numFmt":"Currency"}},"D9":{"v":"Paid"},"A10":{"v":"Riverside"},"B10":{"v":"River 210"},"C10":{"v":1650,"fmt":{"numFmt":"Currency"}},"D10":{"v":"Late"},"A11":{"v":"Riverside"},"B11":{"v":"River 220"},"C11":{"v":1625,"fmt":{"numFmt":"Currency"}},"D11":{"v":"Paid"},"A12":{"v":"Riverside"},"B12":{"v":"River 305"},"C12":{"v":1700,"fmt":{"numFmt":"Currency"}},"D12":{"v":"Paid"},"A13":{"v":"Riverside"},"B13":{"v":"River 310"},"C13":{"v":1700,"fmt":{"numFmt":"Currency"}},"D13":{"v":"Late"}},"colWidths":{"A":110,"B":100,"C":90,"D":80}}]},"owner":"mreyes@parkviewpm.example","sharing":{"people":[{"email":"jlee@parkviewpm.example","role":"Editor"}]}}]},"tasks":[{"instruction":"Select A1:B6 on the Repairs by Month sheet and insert a chart.","hint":"Drag from A1 to B6, then Insert › Chart (or click Insert chart on the toolbar). The chart editor opens on the right.","steps":[{"action":{"kind":"command","id":"insert.chart"},"requires":{"sheet":"Repairs by Month","selection":"A1:B6"},"selectHint":"Select A1:B6 on the Repairs by Month sheet first."}]},{"instruction":"Change the chart to a line chart, so the trend over the months shows.","hint":"In the chart editor, on the Setup tab, open Chart type and choose Line chart. (Double-click the chart if the editor closed.)","steps":[{"action":{"kind":"command","id":"chart.type","value":"Line chart"},"requires":{"selection":"chart:c1"},"selectHint":"Click the chart first."}]},{"instruction":"Give the chart the title “Repair requests by month”.","hint":"In the chart editor, click the Customize tab. Under Chart & axis title, type Repair requests by month in Title text and press Enter.","steps":[{"action":{"kind":"type","target":"chart:c1.title","value":"Repair requests by month"}}]},{"instruction":"Go to the Rent Roll sheet and create a pivot table from A1:D13 on a new sheet.","hint":"Click the Rent Roll tab and select A1:D13 (or click any cell in the data). Insert › Pivot table, keep New sheet, and click Create.","steps":[{"action":{"kind":"dialog","id":"g.pivot","values":{"insert":"New sheet"}},"requires":{"sheet":"Rent Roll"}}]},{"instruction":"In the pivot table editor, add Building to Rows.","hint":"Next to Rows, click Add and choose Building.","steps":[{"action":{"kind":"command","id":"pivot.area","value":"Building>Rows"}}]},{"instruction":"Add Rent to Values, so the pivot table totals the rent for each building.","hint":"Next to Values, click Add and choose Rent. It is summarized with SUM.","steps":[{"action":{"kind":"command","id":"pivot.area","value":"Rent>Values"}}]},{"instruction":"Add Status to Columns, so paid and late rent show side by side.","hint":"Next to Columns, click Add and choose Status.","steps":[{"action":{"kind":"command","id":"pivot.area","value":"Status>Columns"}}]}]}}]]}]]}]

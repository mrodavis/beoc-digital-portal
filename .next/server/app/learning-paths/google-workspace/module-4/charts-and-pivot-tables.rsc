23:["$","div","1",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Pivot tables"}],["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"A pivot table summarizes a long list: total rent by building, number of repairs by type, average cost by vendor. You do not write formulas; you choose which column to group by and which to add up."}],["$","ol","1",{"start":"$undefined","className":"list-decimal pl-6 space-y-3 text-gray-700 marker:font-semibold marker:text-primary-600","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Select the data. Every column needs a header."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"Insert › Pivot table. Check the data range, choose New sheet, and click Create."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"In the pivot table editor on the right, next to Rows, click Add and pick a column to group by (Building)."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"Next to Values, click Add and pick the column to summarize (Rent). Sheets adds it up with SUM; choose another way, like AVERAGE or COUNTA, under Summarize by."}],["$","li","4",{"className":"leading-relaxed pl-1","children":"Add a field under Columns to split the summary across the top (Status)."}],["$","li","5",{"className":"leading-relaxed pl-1","children":"The pivot table updates when the source data changes. Click it and choose Edit to reopen the editor."}]]}],["$","div","2",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-blue-50 border-blue-400","children":[false,"Sheets may show Suggested pivot tables in the editor. They can be a good start; check that they answer your question."]}]]}]]}]
24:["$","div","2",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Knowledge Check"}],["$","div",null,{"className":"space-y-6","children":[["$","$L28","0",{"block":{"type":"knowledge-check","question":"Marcus needs total rent for each building from a 40-row rent roll. What is fastest?","options":["Add the rents on a calculator","A pivot table with Building in Rows and Rent in Values","A pie chart","Sort the sheet"],"correctIndex":1,"explanation":"A pivot table groups the rows by building and adds the rents for you.","optionRationales":["Slow, and the result would not update.","Correct. Rows group by building; Values sums the rent.","A chart shows numbers; it does not compute the totals by building table.","Sorting groups rows but does not total them."]}}],["$","$L28","1",{"block":{"type":"knowledge-check","question":"Where do you change a chart's title?","options":["Setup tab","Customize tab › Chart & axis title","Format › Number","Data › Sort range"],"correctIndex":1,"explanation":"Titles and fonts are on the Customize tab of the chart editor.","optionRationales":["Setup is for the chart type and the data range.","Correct. Customize › Chart & axis title.","Number formats change cells, not the chart title.","Sorting changes the data order."]}}]]}]]}]

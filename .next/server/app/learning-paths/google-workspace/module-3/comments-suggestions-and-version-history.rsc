21:["$","div","3",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Knowledge Check"}],["$","div",null,{"className":"space-y-6","children":[["$","$L25","0",{"block":{"type":"knowledge-check","question":"You want Denise to decide whether to change a sentence in her document. What do you use?","options":["Edit it directly","Suggesting mode","Delete the sentence","Version history"],"correctIndex":1,"explanation":"A suggestion shows your change without making it, and Denise accepts or rejects it.","optionRationales":["Editing changes her text without asking.","Correct. Suggesting mode lets her decide.","Deleting changes the text directly.","Version history restores old versions; it is not for proposing changes."]}}],["$","$L25","1",{"block":{"type":"knowledge-check","question":"Someone pasted over half of the policy by mistake. How do you get the old text back?","options":["Press Ctrl+S","Open version history and restore the earlier version","Ask Google to recover it","It cannot be recovered"],"correctIndex":1,"explanation":"Version history keeps earlier versions. Restoring one keeps the current text as a version too.","optionRationales":["Docs has no Save to undo; changes are already saved.","Correct. Restore this version brings back the earlier text.","You can do it yourself in seconds.","Version history makes it recoverable."]}}]]}]]}]

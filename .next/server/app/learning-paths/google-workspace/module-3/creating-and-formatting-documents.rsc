28:["$","ul","1",{"className":"list-disc pl-6 space-y-3 text-gray-700 marker:text-primary-500","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Select first, then format. Click in a paragraph to format the whole paragraph (alignment, spacing, lists); select words to format only those words (bold, color)."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"The same commands are in the Format menu: Format › Text, Format › Align & indent, Format › Line & paragraph spacing, Format › Bullets & numbering."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Shortcuts match Word: Ctrl+B, Ctrl+I, Ctrl+U, Ctrl+Shift+E (center), Ctrl+Shift+7 (numbered list), Ctrl+Shift+8 (bulleted list)."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"If the toolbar is too narrow, the rest of the buttons are under More (the three dots) at its right end."}]]}]
29:["$","$L2d","2",{"block":{"type":"drag-drop","mode":"match","title":"Match the button to the job","prompt":"Drag each toolbar control onto the job it does.","items":[{"id":"b1","text":"Make the shutoff time stand out","match":"Bold"},{"id":"b2","text":"Put the title in the middle of the line","match":"Center align"},{"id":"b3","text":"Turn three instructions into a list","match":"Bulleted list"},{"id":"b4","text":"Give tenants boxes to check off","match":"Checklist"},{"id":"b5","text":"Copy the heading's look to another heading","match":"Paint format"}],"explanation":"Character formatting (bold, color) acts on the words you select. Paragraph formatting (alignment, lists, spacing) acts on the whole paragraph you click in."}}]

1b:["$","div",null,{"id":"practice-simulation","className":"mb-12 scroll-mt-24","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Practice Simulation"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Practice what this lesson taught in a working copy of the app. Tasks appear under the window, just like GMetrix."}]]}],["$","div",null,{"className":"space-y-10","style":{"width":"min(1360px, calc(100vw - 2rem))","marginLeft":"calc((100% - min(1360px, calc(100vw - 2rem))) / 2)"},"children":[["$","$L23","gw-m3-format-notice",{"sim":{"id":"gw-m3-format-notice","app":"google","title":"Format the water shutoff notice","scenario":"Marcus typed the water shutoff notice as plain text. Tenants will skim it on the lobby board, so format it until the time and the instructions jump out.","fileName":"Water Shutoff Notice","minutes":6,"initial":{"surface":"docs","open":"f1","tabs":["f1"],"me":{"name":"Jordan Lee","email":"jlee@parkviewpm.example","color":"#1a73e8"},"org":{"name":"Parkview Property Management","domain":"parkviewpm.example"},"people":[{"name":"Denise Carter","email":"dcarter@parkviewpm.example","color":"#188038"},{"name":"Marcus Reyes","email":"mreyes@parkviewpm.example","color":"#e8710a"},{"name":"Kim Nguyen","email":"knguyen@parkviewpm.example","color":"#9334e6"},{"name":"Priya Shah","email":"pshah@parkviewpm.example","color":"#d93025"},{"name":"Andre Wallace","email":"awallace@parkviewpm.example","color":"#12858a"},{"name":"Tony Russo","email":"tony@russoplumbing.example","color":"#b06000"}],"files":[{"id":"f1","name":"Water Shutoff Notice","kind":"doc","parent":"root","modified":"Oct 19, 2026","content":{"paragraphs":[{"id":"p1","text":"Water Shutoff Notice"},{"id":"p2","runs":[{"text":"The city will shut off the water at Elm Street Apartments to repair a main pipe. "},{"id":"r2","text":"Water will be off on Thursday from 9:00 AM to 1:00 PM."}]},{"id":"p3","text":"Before the shutoff:"},{"id":"p4","text":"Fill a pitcher or pot with drinking water."},{"id":"p5","text":"Run the dishwasher and washing machine the night before."},{"id":"p6","text":"Keep faucets closed so water does not spray when it comes back on."},{"id":"p7","runs":[{"text":"Questions? "},{"id":"r2","text":"Call the office at (555) 019-2400."}]},{"id":"p8","text":"After the water is back on:"},{"id":"p9","text":"Run cold water for one minute"},{"id":"p10","text":"Report any leaks to the office"}]}}]},"tasks":[{"instruction":"Center the title “Water Shutoff Notice”.","hint":"Click in the title. Then click Align on the toolbar and choose Center align, or press Ctrl+Shift+E.","steps":[{"action":{"kind":"command","id":"home.alignCenter"},"requires":{"selection":"p1"},"selectHint":"Click in the title “Water Shutoff Notice” first."}]},{"instruction":"Make the title 24 point.","hint":"With the title selected, click the font size box on the toolbar (it shows 11), type 24, and press Enter.","steps":[{"action":{"kind":"command","id":"home.fontSize","value":"24"},"requires":{"selection":"p1"},"selectHint":"Click in the title first."}]},{"instruction":"Bold the sentence “Water will be off on Thursday from 9:00 AM to 1:00 PM.”","hint":"Click the sentence to select it, then click Bold on the toolbar or press Ctrl+B.","steps":[{"action":{"kind":"command","id":"home.bold"},"requires":{"selection":"p2.r2"},"selectHint":"Click the sentence “Water will be off on Thursday…” first."}]},{"instruction":"Change the color of “Call the office at (555) 019-2400.” to red.","hint":"Click the sentence. Click Text color (the A with a colored bar) on the toolbar, then click red in the second row of colors.","steps":[{"action":{"kind":"command","id":"home.fontColor","value":"#ff0000"},"requires":{"selection":"p7.r2"},"selectHint":"Click the sentence “Call the office at (555) 019-2400.” first."}]},{"instruction":"Turn the three lines under “Before the shutoff:” into a bulleted list.","hint":"Click “Fill a pitcher or pot…”, then Shift+click “Keep faucets closed…” to select all three lines. Click Bulleted list on the toolbar (or press Ctrl+Shift+8).","steps":[{"action":{"kind":"command","id":"home.bullets"},"requires":{"selection":"p4,p5,p6"},"selectHint":"Select the three lines from “Fill a pitcher…” to “Keep faucets closed…” first (click the first, Shift+click the last)."}]},{"instruction":"Turn the two lines under “After the water is back on:” into a checklist.","hint":"Click “Run cold water for one minute”, Shift+click “Report any leaks to the office”, then click Checklist on the toolbar.","steps":[{"action":{"kind":"command","id":"g.checklist"},"requires":{"selection":"p9,p10"},"selectHint":"Select the last two lines first (click the first, Shift+click the second)."}]},{"instruction":"Set the whole notice to 1.5 line spacing.","hint":"Press Ctrl+A to select everything. Then click Line & paragraph spacing on the toolbar and choose 1.5.","steps":[{"action":{"kind":"command","id":"home.lineSpacing","value":"1.5"},"requires":{"selection":"all"},"selectHint":"Select the whole document first (Ctrl+A)."}]}]}}]]}]]}]

22:["$","div","3",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Knowledge Check"}],["$","div",null,{"className":"space-y-6","children":[["$","$L2c","0",{"block":{"type":"knowledge-check","question":"You click inside a paragraph without selecting anything and click Center align. What gets centered?","options":["Nothing, you must select text first","The whole paragraph","Only the word you clicked","The whole document"],"correctIndex":1,"explanation":"Alignment is paragraph formatting. Clicking anywhere in a paragraph is enough.","optionRationales":["Paragraph formatting does not need a selection.","Correct. Alignment applies to the whole paragraph.","Alignment never applies to single words.","Only the paragraph with the cursor (or the selected paragraphs) changes."]}}],["$","$L2c","1",{"block":{"type":"knowledge-check","question":"You want three headings to look like the first one you formatted. What is the fastest way?","options":["Format each heading again by hand","Double-click Paint format, then click each heading","Copy and paste the first heading three times","Use Clear formatting"],"correctIndex":1,"explanation":"Double-clicking Paint format keeps it on so you can apply the formatting several times. (Even better for headings: paragraph styles, in the next lesson.)","optionRationales":["That works, but it is slow and easy to get slightly wrong.","Correct. Double-click keeps Paint format on until you click it again or press Esc.","Pasting copies the words too, not only the look.","Clear formatting removes formatting instead of copying it."]}}]]}]]}]

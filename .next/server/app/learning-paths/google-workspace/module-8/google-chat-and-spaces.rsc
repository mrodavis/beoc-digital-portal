23:["$","div","5",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Knowledge Check"}],["$","div",null,{"className":"space-y-6","children":[["$","$L2e","0",{"block":{"type":"knowledge-check","question":"You @mention Andre in a space he isn't in yet, and you want him to see the conversation. Which option do you choose?","options":["Send message only","Add member and send","Delete the message","Start a new email"],"correctIndex":1,"explanation":"Add member and send adds Andre to the space and notifies him.","optionRationales":["That sends the message without adding Andre, so he won't be in the space.","Correct.","You don't need to delete anything; Chat asks what to do.","Email would split the conversation into two places."]}}],["$","$L2e","1",{"block":{"type":"knowledge-check","question":"Where should a project's ongoing team conversation go?","options":["A group email that everyone replies all to","A space with the project's team","A direct message with each person separately","A comment in a spreadsheet"],"correctIndex":1,"explanation":"A space keeps the conversation, members, and shared files together, and new members can catch up.","optionRationales":["Reply-all threads get long and people drop off them.","Correct.","Separate messages mean everyone sees a different part of the story.","Comments are for a specific part of a file, not a whole project."]}}],["$","$L2e","2",{"block":{"type":"knowledge-check","question":"You share a Drive file in Chat, and Chat says some members can't open it. What does that mean?","options":["The file is broken","You need to choose the type of access to give them, or they won't be able to open it","Chat can only share files from your computer","Members must request access by email first"],"correctIndex":1,"explanation":"Chat checks the file's sharing and asks you to select the type of access for people who don't have it.","optionRationales":["The file is fine; it just isn't shared with everyone yet.","Correct.","Chat can share Drive files and files from your computer.","You can give access right from Chat."]}}]]}]]}]

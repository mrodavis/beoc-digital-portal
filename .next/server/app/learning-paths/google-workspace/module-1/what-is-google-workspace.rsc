32:["$","$L37","2",{"block":{"type":"drag-drop","mode":"sort","title":"Personal or work account?","prompt":"Drag each statement to the kind of account it describes.","buckets":[{"id":"personal","label":"Personal Google account"},{"id":"work","label":"Work or school account"}],"items":[{"id":"a","text":"Jordan created it at home with an @gmail.com address","bucket":"personal"},{"id":"b","text":"The administrator turned off sharing outside the company","bucket":"work"},{"id":"c","text":"Its 15 GB of free storage is shared by Gmail, Drive, and Photos","bucket":"personal"},{"id":"d","text":"The files stay with the company when the employee leaves","bucket":"work"},{"id":"e","text":"The address ends in @parkviewpm.example","bucket":"work"},{"id":"f","text":"Only the account holder decides which features are on","bucket":"personal"}],"explanation":"Ask who set up the account. If you created it, it is personal and you control it. If your employer or school created it, it is a work or school account, the organization controls it, and work files belong there, not in your personal account."}}]
33:["$","div","3",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"Keep work files in your work account. Do not download company files to your personal Google account or share them from it, even to work from home. If you need access from home, ask how your employer wants you to sign in."]}]

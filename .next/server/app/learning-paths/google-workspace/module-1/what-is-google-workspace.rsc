19:["$","$L1f",null,{"slides":[{"src":"/images/google-workspace/module-1/what-is-google-workspace/slide-01.jpg","alt":"What Google Workspace is: Google's apps for work, all in the browser"},{"src":"/images/google-workspace/module-1/what-is-google-workspace/slide-02.jpg","alt":"The apps you will use: Gmail and Calendar, Drive, Docs, Sheets, Slides, Meet and Chat"},{"src":"/images/google-workspace/module-1/what-is-google-workspace/slide-03.jpg","alt":"Personal Google account or work account: who sets it up and what changes"},{"src":"/images/google-workspace/module-1/what-is-google-workspace/slide-04.jpg","alt":"Google Workspace and Microsoft 365, app by app"},{"src":"/images/google-workspace/module-1/what-is-google-workspace/slide-05.jpg","alt":"Three habits of cloud apps: automatic saving, sharing a link, any computer"},{"src":"/images/google-workspace/module-1/what-is-google-workspace/slide-06.jpg","alt":"Quick check: which app would you open?"}]}]
1a:["$","div",null,{"className":"mb-12","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Lesson Notes"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Read through the key concepts before you try the challenge."}]]}],["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-12","children":[["$","div","0",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Your first day at Parkview"}],["$","div",null,{"className":"space-y-6","children":[["$","div","0",{"className":"rounded-xl border border-amber-200 bg-amber-50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-amber-800 mb-2","children":"On the job"}],"$undefined",["$","p",null,{"className":"text-sm font-medium text-amber-900 mb-2","children":"You are Jordan Lee, the new office assistant at Parkview Property Management."}],["$","p",null,{"className":"text-gray-800 leading-relaxed","children":"Parkview manages two apartment buildings, Elm Street Apartments and Riverside Commons. The office runs on Google Workspace: tenant letters are in Google Docs, the maintenance request log is a Google Sheet, and the staff talks over Gmail and Google Meet. Your manager, Denise Carter, set up your work account (jlee@parkviewpm.example) and wants you to know your way around before your first tenant walks in."}],["$","p",null,{"className":"mt-3 pt-3 border-t border-amber-200 text-gray-900","children":[["$","span",null,{"className":"font-semibold","children":"Your task: "}],"Know what each Google Workspace app is for, what kind of account you have, and how the Google apps compare with Microsoft Office."]}]]}],["$","p","1",{"className":"text-gray-700 leading-relaxed","children":"Google Workspace is Google's set of apps for work and school: Gmail, Google Calendar, Google Drive, Google Docs, Google Sheets, Google Slides, Google Meet, Google Chat, Google Forms, and more. They run in a web browser, so there is nothing to install on the computer. You sign in with one Google account and every app is there."}],["$","div","2",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-blue-50 border-blue-400","children":[false,"Google Workspace was called G Suite until October 2020. If a coworker or a job posting says G Suite, they mean the same apps."]}],["$","div","3",{"className":"rounded-xl border border-gray-200 bg-white p-6","children":[["$","h4",null,{"className":"text-sm font-semibold uppercase tracking-wide text-gray-500 mb-4","children":"Key terms"}],["$","dl",null,{"className":"space-y-3","children":[["$","div","0",{"className":"sm:flex sm:gap-4","children":[["$","dt",null,{"className":"font-semibold text-gray-900 sm:w-48 sm:flex-shrink-0","children":"Google account"}],["$","dd",null,{"className":"text-gray-700 leading-relaxed","children":"The sign-in you use for every Google app. It can be a personal account you create yourself or a work or school account your organization gives you."}]]}],["$","div","1",{"className":"sm:flex sm:gap-4","children":[["$","dt",null,{"className":"font-semibold text-gray-900 sm:w-48 sm:flex-shrink-0","children":"Google Workspace"}],["$","dd",null,{"className":"text-gray-700 leading-relaxed","children":"Google's apps for work and school (Gmail, Calendar, Drive, Docs, Sheets, Slides, Meet, Chat, Forms, and others), managed by an organization."}]]}],["$","div","2",{"className":"sm:flex sm:gap-4","children":[["$","dt",null,{"className":"font-semibold text-gray-900 sm:w-48 sm:flex-shrink-0","children":"Cloud app"}],"$L20"]}],"$L21","$L22"]}]]}]]}]]}],"$L23","$L24","$L25","$L26","$L27"]}]}]]}]
1b:["$","div",null,{"id":"practice-simulation","className":"mb-12 scroll-mt-24","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Practice Simulation"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Practice what this lesson taught in a working copy of the app. Tasks appear under the window, just like GMetrix."}]]}],["$","div",null,{"className":"space-y-10","style":{"width":"min(1360px, calc(100vw - 2rem))","marginLeft":"calc((100% - min(1360px, calc(100vw - 2rem))) / 2)"},"children":[["$","$L28","gw-m1-apps-tour",{"sim":{"id":"gw-m1-apps-tour","app":"google","title":"Find your way around Parkview's apps","scenario":"It is your first morning at Parkview Property Management. Denise Carter wants you to move between Drive, Sheets, and Docs without hunting. Use the Google apps menu and the app home screens to open the files you will use every day.","fileName":"My Drive - Google Drive","minutes":5,"initial":{"surface":"drive","me":{"name":"Jordan Lee","email":"jlee@parkviewpm.example","color":"#1a73e8"},"org":{"name":"Parkview Property Management","domain":"parkviewpm.example"},"people":[{"name":"Denise Carter","email":"dcarter@parkviewpm.example","color":"#188038"},{"name":"Marcus Reyes","email":"mreyes@parkviewpm.example","color":"#e8710a"},{"name":"Kim Nguyen","email":"knguyen@parkviewpm.example","color":"#9334e6"},{"name":"Priya Shah","email":"pshah@parkviewpm.example","color":"#d93025"},{"name":"Andre Wallace","email":"awallace@parkviewpm.example","color":"#12858a"},{"name":"Tony Russo","email":"tony@russoplumbing.example","color":"#b06000"}],"drive":{"location":"root","layout":"list"},"files":[{"id":"fd1","name":"Elm Street Apartments","kind":"folder","parent":"root","modified":"Oct 9, 2026"},{"id":"fd2","name":"Riverside Commons","kind":"folder","parent":"root","modified":"Oct 9, 2026"},{"id":"f1","name":"Tenant Welcome Letter","kind":"doc","parent":"root","modified":"Oct 15, 2026","content":{"paragraphs":[{"id":"p1","text":"Welcome to Parkview Property Management"},{"id":"p2","text":"We are glad you chose to live at Elm Street Apartments. This letter explains how to reach the office, report a repair, and pay rent."},{"id":"p3","text":"Office hours are Monday through Friday, 9:00 AM to 5:00 PM."}]}},{"id":"f2","name":"Maintenance Request Log","kind":"sheet","parent":"root","owner":"knguyen@parkviewpm.example","modifiedBy":"knguyen@parkviewpm.example","modified":"Oct 19, 2026","sharing":{"people":[{"email":"jlee@parkviewpm.example","role":"Editor"}]},"content":{"active":"Requests","sheets":[{"name":"Requests","cells":{"A1":{"v":"Date","fmt":{"bold":true}},"B1":{"v":"Apartment","fmt":{"bold":true}},"C1":{"v":"Problem","fmt":{"bold":true}},"D1":{"v":"Status","fmt":{"bold":true}},"A2":{"v":"10/14"},"B2":{"v":"Elm 3B"},"C2":{"v":"Leaking kitchen faucet"},"D2":{"v":"Done"},"A3":{"v":"10/16"},"B3":{"v":"River 210"},"C3":{"v":"Heater not working"},"D3":{"v":"In progress"},"A4":{"v":"10/19"},"B4":{"v":"Elm 1A"},"C4":{"v":"Broken mailbox lock"},"D4":{"v":"New"}},"colWidths":{"A":70,"B":90,"C":200,"D":100}}]}},{"id":"f3","name":"Parkview Orientation","kind":"slides","parent":"root","modified":"Oct 2, 2026"},{"id":"f4","name":"Vendor Contact List","kind":"sheet","parent":"root","modified":"Sep 28, 2026"}]},"tasks":[{"instruction":"Open Google Sheets from the Google apps menu.","hint":"Click the Google apps button (the grid of dots at the top right, next to your profile picture), then click Sheets.","steps":[{"action":{"kind":"command","id":"g.app","value":"Sheets"}}]},{"instruction":"Open the spreadsheet “Maintenance Request Log” from your recent spreadsheets.","hint":"On the Sheets home screen, look under Recent spreadsheets and click Maintenance Request Log. It opens in its own browser tab.","steps":[{"action":{"kind":"command","id":"g.open","value":"f2"}}]},{"instruction":"Go back to the Sheets home screen.","hint":"Click the Sheets logo (the green icon) at the top left of the spreadsheet.","steps":[{"action":{"kind":"command","id":"g.app","value":"Sheets"}}]},{"instruction":"Use the Google apps menu to switch to Google Docs.","hint":"Click the Google apps button at the top right of the Sheets home screen, then click Docs.","steps":[{"action":{"kind":"command","id":"g.app","value":"Docs"}}]},{"instruction":"Open “Tenant Welcome Letter” from your recent documents.","hint":"On the Docs home screen, click Tenant Welcome Letter under Recent documents.","steps":[{"action":{"kind":"command","id":"g.open","value":"f1"}}]},{"instruction":"Star the letter so you can find it quickly later.","hint":"Click the star next to the document name at the top left. Starred files appear under Starred in Drive.","steps":[{"action":{"kind":"command","id":"g.star","value":"f1"}}]},{"instruction":"Go back to the first browser tab and open Google Drive from the Google apps menu.","hint":"Click the first tab at the top of the window (Google Docs). Then click the Google apps button at the top right and click Drive.","steps":[{"action":{"kind":"command","id":"g.app","value":"Drive"}}]}]}}]]}]]}]

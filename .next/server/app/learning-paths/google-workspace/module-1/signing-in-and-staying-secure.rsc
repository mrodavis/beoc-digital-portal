21:["$","ul","2",{"className":"list-disc pl-6 space-y-3 text-gray-700 marker:text-primary-500","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"To turn it on in a personal account: go to myaccount.google.com, select Security & sign-in, and under How you sign in to Google, choose Turn on 2-Step Verification. Follow the steps on the screen."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"In a work or school account, your administrator may already require it or may manage it for you. If the steps do not work, contact your administrator."}]]}]
22:["$","div","3",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"If a sign-in prompt appears on your phone and you are not signing in, tap No, it's not me. A prompt you did not start means someone may know your password. Change your password and tell your supervisor or IT. Never approve a prompt because a caller or a text message tells you to."]}]
23:["$","div","2",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Shared and public computers"}],["$","div",null,{"className":"space-y-6","children":[["$","figure","0",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Computer"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"What to do when you finish"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Your own computer"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"You can stay signed in. Lock the screen when you step away (Windows key + L)."}]]}],["$","tr","1",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"A shared work computer, like the front desk"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Sign out: click your profile picture at the top right, then Sign out. Do not let the browser save your password."}]]}],["$","tr","2",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"A public computer, like a library"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"Sign in only in a private browsing window (Incognito in Chrome, InPrivate in Edge). When you finish, close every private window and you are signed out."}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"What to do on each kind of computer"}]]}],["$","p","1",{"className":"text-gray-700 leading-relaxed","children":"Forgot to sign out somewhere? Go to your Google Account, open Your devices, and use Manage devices to remove the computer you no longer use. If your password could have been saved on someone else's computer, change it."}],["$","$L1f","2",{"block":{"type":"drag-drop","mode":"sort","title":"Safe or risky?","prompt":"Sort each habit.","buckets":[{"id":"safe","label":"Safe habit"},{"id":"risky","label":"Risky habit"}],"items":[{"id":"h1","text":"Signing out of the front desk computer before you go to lunch","bucket":"safe"},{"id":"h2","text":"Clicking Save password on the shared front desk computer","bucket":"risky"},{"id":"h3","text":"Tapping No, it's not me on a sign-in prompt you did not start","bucket":"safe"},{"id":"h4","text":"Approving a sign-in prompt because a caller says he is from IT","bucket":"risky"},{"id":"h5","text":"Using an Incognito window to check your account at the library","bucket":"safe"},{"id":"h6","text":"Using the same password for your Google account and a shopping site","bucket":"risky"}],"explanation":"Safe habits keep other people from working as you: sign out, do not save passwords on shared computers, use private windows on public ones, and never approve a sign-in you did not start."}}],["$","div","3",{"className":"bg-green-50 border-l-4 border-green-400 p-4 rounded-xl text-gray-800 leading-relaxed","children":[["$","span",null,{"aria-hidden":"true","children":"💡 "}],"Use a long password you do not use anywhere else. A short sentence of unrelated words is easier to remember and harder to guess than a short word with symbols."]}]]}]]}]
24:["$","div","3",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Knowledge Check"}],["$","div",null,{"className":"space-y-6","children":[["$","$L27","0",{"block":{"type":"knowledge-check","question":"You are not signing in anywhere, and your phone shows a Google prompt: Are you trying to sign in? What should you do?","options":["Tap Yes so the prompt goes away","Ignore it","Tap No, it's not me, then change your password and tell IT","Turn off 2-Step Verification"],"correctIndex":2,"explanation":"A prompt you did not start means someone has your password and is trying to get in. Block it, change your password, and report it.","optionRationales":["Tapping Yes lets the other person into your account.","Ignoring it leaves your password in someone else's hands.","Correct. Block the sign-in, change the password, and report it.","2-Step Verification just stopped the intruder. Turning it off makes things worse."]}}],["$","$L27","1",{"block":{"type":"knowledge-check","question":"You checked the shared calendar on the front desk computer. What do you do before you leave the desk?","options":["Close the browser tab","Sign out: profile picture, then Sign out","Minimize the browser","Nothing, the next person uses the same account"],"correctIndex":1,"explanation":"Closing a tab or minimizing the window can leave you signed in. Sign out from your profile picture so the next person cannot work as you.","optionRationales":["Closing a tab often leaves you signed in for the next person.","Correct. Signing out ends your session on that computer.","Minimizing hides the window. You are still signed in.","Everyone has their own account. Sharing one account hides who did what."]}}]]}]]}]

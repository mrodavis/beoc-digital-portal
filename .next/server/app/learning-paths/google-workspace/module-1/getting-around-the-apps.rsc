1b:["$","div",null,{"id":"practice-simulation","className":"mb-12 scroll-mt-24","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Practice Simulation"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Practice what this lesson taught in a working copy of the app. Tasks appear under the window, just like GMetrix."}]]}],["$","div",null,{"className":"space-y-10","style":{"width":"min(1360px, calc(100vw - 2rem))","marginLeft":"calc((100% - min(1360px, calc(100vw - 2rem))) / 2)"},"children":[["$","$L2a","gw-m1-new-files",{"sim":{"id":"gw-m1-new-files","app":"google","title":"Start your first Parkview files","scenario":"Denise asked for a letter to Russo Plumbing and a supply order spreadsheet. Start each file from the right home screen, name it clearly, and use Search the menus to find a command you cannot see.","fileName":"Google Docs","minutes":5,"initial":{"surface":"home","homeApp":"docs","me":{"name":"Jordan Lee","email":"jlee@parkviewpm.example","color":"#1a73e8"},"org":{"name":"Parkview Property Management","domain":"parkviewpm.example"},"people":[{"name":"Denise Carter","email":"dcarter@parkviewpm.example","color":"#188038"},{"name":"Marcus Reyes","email":"mreyes@parkviewpm.example","color":"#e8710a"},{"name":"Kim Nguyen","email":"knguyen@parkviewpm.example","color":"#9334e6"},{"name":"Priya Shah","email":"pshah@parkviewpm.example","color":"#d93025"},{"name":"Andre Wallace","email":"awallace@parkviewpm.example","color":"#12858a"},{"name":"Tony Russo","email":"tony@russoplumbing.example","color":"#b06000"}],"drive":{"location":"root","layout":"list"},"files":[{"id":"f1","name":"Tenant Welcome Letter","kind":"doc","parent":"root","modified":"Oct 15, 2026","content":{"paragraphs":[{"id":"p1","text":"Welcome to Parkview Property Management"},{"id":"p2","text":"We are glad you chose to live at Elm Street Apartments. This letter explains how to reach the office, report a repair, and pay rent."},{"id":"p3","text":"Office hours are Monday through Friday, 9:00 AM to 5:00 PM."}]}},{"id":"f2","name":"Office Procedures","kind":"doc","parent":"root","owner":"dcarter@parkviewpm.example","modified":"Sep 30, 2026"},{"id":"f3","name":"Vendor Contact List","kind":"sheet","parent":"root","modified":"Sep 28, 2026"}]},"tasks":[{"instruction":"Start a new document from the Letter template.","hint":"On the Docs home screen, under Start a new document, click Letter. (Template gallery at the right shows all templates.)","steps":[{"action":{"kind":"command","id":"g.template","value":"Letter"}}]},{"instruction":"Rename the document “Russo Plumbing Letter”.","hint":"Click the file name (Letter) at the top left, type Russo Plumbing Letter, and press Enter. File › Rename works too.","steps":[{"action":{"kind":"type","target":"rename:new1","value":"Russo Plumbing Letter"}}]},{"instruction":"Use Search the menus to open Word count.","hint":"Click Search the menus (the magnifying glass at the left of the toolbar) or press Alt+/, type word count, and press Enter. Tools › Word count and Ctrl+Shift+C open it too.","steps":[{"action":{"kind":"command","id":"g.pane","value":"Word count"}}]},{"instruction":"Close Word count, then go back to the Docs home screen.","hint":"Click OK to close Word count. Then click the Docs logo (the blue icon) at the top left.","steps":[{"action":{"kind":"command","id":"g.app","value":"Docs"}}]},{"instruction":"Open Google Sheets from the Google apps menu and start a blank spreadsheet.","hint":"Click the Google apps button (the grid of dots) at the top right and click Sheets. Then click Blank spreadsheet under Start a new spreadsheet.","steps":[{"action":{"kind":"command","id":"g.app","value":"Sheets"}},{"action":{"kind":"command","id":"g.new","value":"Google Sheets"}}]},{"instruction":"Rename the spreadsheet “Parkview Supply Order”.","hint":"Click Untitled spreadsheet at the top left, type Parkview Supply Order, and press Enter.","steps":[{"action":{"kind":"type","target":"rename:new2","value":"Parkview Supply Order"}}]}]}}]]}]]}]

29:["$","div","4",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Knowledge Check"}],["$","div",null,{"className":"space-y-6","children":[["$","$L31","0",{"block":{"type":"knowledge-check","question":"You started a document from the Docs home screen and it is called Untitled document. What is the fastest way to rename it?","options":["File › Save as","Click the name at the top left, type the new name, press Enter","Download it with a new name","Close the tab and rename it in File Explorer"],"correctIndex":1,"explanation":"The file name at the top left is a box you can click and type in. The new name is saved right away.","optionRationales":["Google's editors do not have Save as. Use the name box or File › Rename.","Correct. Click the name, type, and press Enter.","Downloading makes a copy on the computer. The file in Drive keeps the old name.","Google files live in Drive, not in File Explorer."]}}],["$","$L31","1",{"block":{"type":"knowledge-check","question":"You need Page setup but cannot find it. What is the quickest way?","options":["Press Alt+/ and type page setup","Look on every toolbar button","Reinstall Google Docs","Ask a coworker to do it"],"correctIndex":0,"explanation":"Search the menus (Alt+/) finds any command by name.","optionRationales":["Correct. Search the menus finds the command and runs it.","Page setup is in the File menu, not on the toolbar. Searching is faster.","Google Docs runs in the browser, so there is nothing to install.","You can find it yourself in seconds with Search the menus."]}}]]}]]}]

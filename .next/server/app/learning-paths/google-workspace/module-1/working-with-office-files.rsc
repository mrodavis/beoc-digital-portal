","modified":"Oct 19, 2026","size":"38 KB","content":{"paragraphs":[{"id":"p1","text":"Lease Renewal Notice"},{"id":"p2","text":"Dear Resident,"},{"id":"p3","text":"Your lease at Elm Street Apartments ends soon. To renew, sign the enclosed renewal form and return it to the Parkview office."},{"id":"p4","text":"Questions? Call the office at (555) 019-2400."}]}},{"id":"x1","name":"Russo Plumbing Invoice.xlsx","kind":"excel","parent":"root","modified":"Oct 18, 2026","size":"21 KB","content":{"active":"Invoice","sheets":[{"name":"Invoice","cells":{"A1":{"v":"Service","fmt":{"bold":true}},"B1":{"v":"Amount","fmt":{"bold":true}},"A2":{"v":"Repair kitchen faucet, Elm 3B"},"B2":{"v":185,"fmt":{"numFmt":"Currency"}}},"colWidths":{"A":240,"B":100}}]}},{"id":"d1","name":"Move-In Checklist","kind":"doc","parent":"root","modified":"Sep 22, 2026","content":{"paragraphs":[{"id":"p1","text":"Move-In Checklist"},{"id":"p2","text":"Check every room and write down anything that is damaged before you move in."}]}}]},"tasks":[{"instruction":"Open the Word file “Lease Renewal Notice.docx”.","hint":"Double-click Lease Renewal Notice.docx in My Drive. It opens in Google Docs, with a .DOCX chip next to the name.","steps":[{"action":{"kind":"command","id":"g.open","value":"w1"}}]},{"instruction":"Apply the Title style to the first line, “Lease Renewal Notice”.","hint":"Click the first line. Then open the styles box on the toolbar (it shows Normal text) and choose Title.","steps":[{"action":{"kind":"command","id":"home.style","value":"Title"},"requires":{"selection":"p1"},"selectHint":"Click the line “Lease Renewal Notice” first."}]},{"instruction":"Convert the notice to a Google Docs file so Parkview can keep it.","hint":"File › Save as Google Docs. The Google copy opens in a new tab, and the Word file stays in Drive.","steps":[{"action":{"kind":"command","id":"g.saveAsGoogle"}}]},{"instruction":"Download the Google Doc as a PDF for a tenant to print.","hint":"In the Google Doc, choose File › Download › PDF Document (.pdf).","steps":[{"action":{"kind":"command","id":"g.download","value":"PDF Document (.pdf)"}}]},{"instruction":"Open “Move-In Checklist” and download it as a Microsoft Word file.","hint":"Click the first browser tab (My Drive) and double-click Move-In Checklist. Then choose File › Download › Microsoft Word (.docx).","steps":[{"action":{"kind":"command","id":"g.open","value":"d1"}},{"action":{"kind":"command","id":"g.download","value":"Microsoft Word (.docx)"}}]}]}}]]}]]}]

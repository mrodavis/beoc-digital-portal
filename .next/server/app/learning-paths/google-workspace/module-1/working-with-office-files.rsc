20:["$","div","3",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Knowledge Check"}],["$","div",null,{"className":"space-y-6","children":[["$","$L27","0",{"block":{"type":"knowledge-check","question":"You open Russo Plumbing Invoice.xlsx from Drive and fix a typo. What happens?","options":["The change is lost because Sheets cannot edit Excel files","The change is saved in the original Excel file","Drive makes a Google Sheets copy automatically","You must download the file to save the change"],"correctIndex":1,"explanation":"Office editing saves your changes back to the Office file in its original format.","optionRationales":["Sheets edits Excel files directly with Office editing.","Correct. The .XLSX chip shows it is still an Excel file, and your change is saved in it.","A Google copy is made only when you choose File › Save as Google Sheets.","Changes save automatically. Downloading is only for sending a copy."]}}],["$","$L27","1",{"block":{"type":"knowledge-check","question":"You chose File › Save as Google Docs on a Word file. What is in Drive now?","options":["Only the Google Doc","Only the Word file","Both: the original Word file and a new Google Doc","A PDF"],"correctIndex":2,"explanation":"Converting makes a copy. The Word file stays, and the Google Doc opens in a new tab.","optionRationales":["The original is not deleted when you convert.","Converting adds a Google Doc next to the Word file.","Correct. You now have two files. Remove or rename the one you do not need.","PDF is a download format, not what Save as Google Docs makes."]}}]]}]]}]

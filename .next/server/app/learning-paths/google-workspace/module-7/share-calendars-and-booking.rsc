1b:["$","div",null,{"id":"practice-simulation","className":"mb-12 scroll-mt-24","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Practice Simulation"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Practice what this lesson taught in a working copy of the app. Tasks appear under the window, just like GMetrix."}]]}],["$","div",null,{"className":"space-y-10","style":{"width":"min(1360px, calc(100vw - 2rem))","marginLeft":"calc((100% - min(1360px, calc(100vw - 2rem))) / 2)"},"children":[["$","$L26","gw-m7-share-calendars-and-booking-1",{"sim":{"id":"gw-m7-share-calendars-and-booking-1","app":"gmail","title":"Share the showings calendar and open tenant office hours","scenario":"Andre needs to see every showing, Kim needs to update them, and Denise wants tenants to book short office-hours calls without trading emails.","fileName":"Google Calendar","minutes":7,"initial":{"surface":"calendar","me":{"name":"Jordan Lee","email":"jlee@parkviewpm.example","color":"#1a73e8"},"people":[{"name":"Denise Carter","email":"dcarter@parkviewpm.example","color":"#188038","contact":true},{"name":"Marcus Reyes","email":"mreyes@parkviewpm.example","color":"#e8710a","contact":true},{"name":"Kim Nguyen","email":"knguyen@parkviewpm.example","color":"#9334e6","contact":true},{"name":"Priya Shah","email":"pshah@parkviewpm.example","color":"#d93025","contact":true},{"name":"Andre Wallace","email":"awallace@parkviewpm.example","color":"#12858a","contact":true},{"name":"Tony Russo","email":"tony@russoplumbing.example","color":"#b06000","contact":true},{"name":"Grace Holloway","email":"gholloway@harborviewholdings.example","contact":true},{"name":"Darnell Brooks","email":"dbrooks@example.com","contact":true},{"name":"Rosa Delgado","email":"rdelgado@example.com"},{"name":"Tina Okafor","email":"tokafor@example.com","contact":true},{"name":"Sam Whitfield","email":"swhitfield@example.com","contact":true},{"name":"Bright Clean Services","email":"office@brightclean.example","contact":true},{"name":"City Water Utility","email":"billing@citywater.example"},{"name":"Office Supply Depot","email":"deals@officesupplydepot.example"},{"name":"Neighborly","email":"notifications@neighborly.example"},{"name":"Parkview IT Support","email":"it-support@parkview-pm-help.example"},{"name":"Rewards Center","email":"winner@claim-rewards-now.example"},{"name":"Landlord Learning Hub","email":"news@landlordlearninghub.example"}],"org":{"name":"Parkview Property Management","domain":"parkviewpm.example"},"messages":[{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m1","from":"dcarter@parkviewpm.example","subject":"Welcome aboard, Jordan!","date":"2026-10-21T08:05","starred":false,"unread":true,"important":true,"body":"Hi Jordan,\n\nWelcome to Parkview Property Management! Your first week is about learning our tools. Most of our work happens in Gmail, Calendar, Drive and Meet.\n\nPlease keep an eye on the shared Maintenance and Leasing threads, and ask me anything.\n\nDenise Carter\nOffice Manager"},{"to":["jlee@parkviewpm.example","dcarter@parkviewpm.example"],"box":"inbox","id":"m2","from":"awallace@parkviewpm.example","cc":["knguyen@parkviewpm.example"],"subject":"Showing at Elm Street Apartments moved to Thursday","date":"2026-10-21T09:12","unread":true,"body":"Hi all,\n\nThe prospective tenant for Elm Street Apartments, Unit 2B asked to move Wednesday's showing to Thursday at 4:00 PM. Kim, can someone unlock the side door before then?\n\nThanks,\nAndre"},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m3","from":"pshah@parkviewpm.example","subject":"October rent roll","date":"2026-10-20T16:40","body":"Hi Jordan,\n\nAttached is the October rent roll. Please don't forward it outside the office: it lists every tenant's balance.\n\nPriya","attachments":[{"name":"Rent Roll - October.xlsx","size":"48 KB"}]},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m4","from":"knguyen@parkviewpm.example","subject":"Pest control visit, Riverside Commons","date":"2026-10-20T11:03","body":"FYI, the pest control company will spray the basement at Riverside Commons next Tuesday morning. No action needed from the office.\n\nKim"},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m5","from":"deals@officesupplydepot.example","subject":"30% off printer paper this week","date":"2026-10-21T06:30","category":"Promotions","unread":true,"unsubscribe":true,"body":"Stock up and save: 30% off copy paper, toner and file folders through Sunday."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m6","from":"notifications@neighborly.example","subject":"3 neighbors posted near Elm Street","date":"2026-10-20T19:22","category":"Social","unread":true,"body":"See what your neighbors are saying: a lost cat, a yard sale and a question about recycling day."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m7","from":"billing@citywater.example","subject":"Your October statement is ready","date":"2026-10-19T07:15","category":"Updates","body":"Your October water statement for account 55-1208 (Riverside Commons) is ready to view. Amount due: $412.60."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m8","from":"tony@russoplumbing.example","subject":"Invoice #4471 for Elm Street Apartments","date":"2026-10-19T14:50","body":"Hello,\n\nPlease find attached invoice #4471 for the kitchen sink repair at Elm Street Apartments, Unit 2B, completed October 16.\n\nTony Russo\nRusso Plumbing","attachments":[{"name":"Invoice 4471.pdf","size":"212 KB"}]}],"labels":[],"settings":{"categories":["Primary","Promotions","Social","Updates"]},"view":{"folder":"inbox","calView":"Week","calDate":"2026-10-21"},"tabs":["calendar"],"calendars":[{"id":"main","name":"Jordan Lee","color":"#039be5","mine":true},{"id":"leasing","name":"Leasing Showings","color":"#33b679","mine":true,"description":"Apartment showings for all buildings"},{"id":"holidays","name":"Holidays in United States","color":"#0b8043"},{"id":"denise","name":"Denise Carter","color":"#8e24aa"}],"events":[{"id":"c1","title":"Staff huddle","day":"2026-10-19","start":"09:00","end":"09:30","calendar":"main","organizer":"dcarter@parkviewpm.example","myResponse":"Yes","repeat":"Weekly on Monday","guests":[{"email":"jlee@parkviewpm.example","response":"Yes"},{"email":"awallace@parkviewpm.example","response":"Yes"},{"email":"pshah@parkviewpm.example","response":"Yes"},{"email":"knguyen@parkviewpm.example","response":"Yes"}]},{"id":"c2","title":"Showing: Elm Street Apartments, Unit 2B","day":"2026-10-22","start":"16:00","end":"16:30","calendar":"leasing","location":"Elm Street Apartments"},{"id":"c3","title":"Weekly leasing huddle","day":"2026-10-21","start":"14:00","end":"14:30","calendar":"main","organizer":"awallace@parkviewpm.example","meet":"kpr-tmwq-zse","description":"Agenda: showings this week, applications, renewals.","guests":[{"email":"jlee@parkviewpm.example","response":"Awaiting"},{"email":"dcarter@parkviewpm.example","response":"Yes"}]},{"id":"c4","title":"Owner call: Grace Holloway","day":"2026-10-23","start":"11:00","end":"11:30","calendar":"main","organizer":"dcarter@parkviewpm.example","guests":[{"email":"jlee@parkviewpm.example","response":"Awaiting"},{"email":"gholloway@harborviewholdings.example","response":"Yes"}]},{"id":"c5","title":"Lunch","day":"2026-10-21","start":"12:00","end":"13:00","calendar":"main"},{"id":"c6","title":"Bank deposit run","day":"2026-10-20","start":"15:00","end":"15:30","calendar":"main"},{"id":"c7","title":"Halloween","day":"2026-10-31","allDay":true,"calendar":"holidays"}],"busy":[{"email":"dcarter@parkviewpm.example","day":"2026-10-22","start":"09:00","end":"11:00"},{"email":"dcarter@parkviewpm.example","day":"2026-10-22","start":"13:00","end":"14:00"},{"email":"pshah@parkviewpm.example","day":"2026-10-22","start":"10:00","end":"12:00"},{"email":"pshah@parkviewpm.example","day":"2026-10-22","start":"15:00","end":"16:00"},{"email":"knguyen@parkviewpm.example","day":"2026-10-22","start":"08:00","end":"10:00"}]},"tasks":[{"instruction":"Share your Leasing Showings calendar with Andre Wallace so he can see event details.","hint":"In the left panel, point to Leasing Showings › Options (three dots) › Settings and sharing › Shared with › Add people and groups. Type Andre, pick him, choose See event details, and select Send.","steps":[{"action":{"kind":"type","target":"calshare:leasing","value":"Share with: awallace@parkviewpm.example\nPermission: See event details","match":"includes"},"alt":[{"kind":"type","target":"calshare:leasing","value":["Share with: awallace@parkviewpm.example","Permission: See event details"],"match":"all"}]}]},{"instruction":"Share the same calendar with Kim Nguyen so he can make changes and see event details.","hint":"Add people and groups again › Kim › Permissions: Make changes and see event details › Send.","steps":[{"action":{"kind":"type","target":"calshare:leasing","value":"Share with: knguyen@parkviewpm.example\nPermission: Make changes and see event details","match":"includes"},"alt":[{"kind":"type","target":"calshare:leasing","value":["Share with: knguyen@parkviewpm.example","Permission: Make changes and see event details"],"match":"all"}]}]},{"instruction":"Go back to the calendar.","hint":"At the top left of Settings, select Back to calendar (arrow).","steps":[{"action":{"kind":"command","id":"cal.page","value":"close"}}]},{"instruction":"Create an appointment schedule “Tenant office hours” with 30-minute appointments on Tuesdays and Thursdays from 2:00 to 4:00 PM only (turn the other days off). Use Google Meet video conferencing, add Phone number to the booking form, and save.","hint":"Create › Appointment schedule. Add the title, keep 30 minutes, uncheck Mon, Wed and Fri, and set Tue and Thu to 2:00 PM – 4:00 PM. Select Next, keep Google Meet video conferencing, check Phone number, then Save.","steps":[{"action":{"kind":"type","target":"appointments:new","value":"Title: Tenant office hours\nDuration: 30 minutes\nAvailability: Tue 2:00 PM - 4:00 PM\nAvailability: Thu 2:00 PM - 4:00 PM\nScheduling window: 60 days in advance\nBuffer time: No buffer time\nLocation: Google Meet video conferencing\nBooking form: First name, Last name, Email address, Phone number\nRequire email verification: no\nDescription: ","match":"includes"},"alt":[{"kind":"type","target":"appointments:new","value":["Title: Tenant office hours","Duration: 30 minutes","Availability: Tue 2:00 PM - 4:00 PM","Availability: Thu 2:00 PM - 4:00 PM","Location: Google Meet video conferencing","Phone number"],"match":"all"}]}]}]}}]]}]]}]

1b:["$","div",null,{"id":"practice-simulation","className":"mb-12 scroll-mt-24","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Practice Simulation"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Practice what this lesson taught in a working copy of the app. Tasks appear under the window, just like GMetrix."}]]}],["$","div",null,{"className":"space-y-10","style":{"width":"min(1360px, calc(100vw - 2rem))","marginLeft":"calc((100% - min(1360px, calc(100vw - 2rem))) / 2)"},"children":[["$","$L29","gw-m7-calendar-basics-1",{"sim":{"id":"gw-m7-calendar-basics-1","app":"gmail","title":"Set up your calendar for the week","scenario":"Denise asks you to keep the office's inspection dates in Google Calendar, with reminders, and to keep your own to-dos there too.","fileName":"Google Calendar","minutes":7,"initial":{"surface":"calendar","me":{"name":"Jordan Lee","email":"jlee@parkviewpm.example","color":"#1a73e8"},"people":[{"name":"Denise Carter","email":"dcarter@parkviewpm.example","color":"#188038","contact":true},{"name":"Marcus Reyes","email":"mreyes@parkviewpm.example","color":"#e8710a","contact":true},{"name":"Kim Nguyen","email":"knguyen@parkviewpm.example","color":"#9334e6","contact":true},{"name":"Priya Shah","email":"pshah@parkviewpm.example","color":"#d93025","contact":true},{"name":"Andre Wallace","email":"awallace@parkviewpm.example","color":"#12858a","contact":true},{"name":"Tony Russo","email":"tony@russoplumbing.example","color":"#b06000","contact":true},{"name":"Grace Holloway","email":"gholloway@harborviewholdings.example","contact":true},{"name":"Darnell Brooks","email":"dbrooks@example.com","contact":true},{"name":"Rosa Delgado","email":"rdelgado@example.com"},{"name":"Tina Okafor","email":"tokafor@example.com","contact":true},{"name":"Sam Whitfield","email":"swhitfield@example.com","contact":true},{"name":"Bright Clean Services","email":"office@brightclean.example","contact":true},{"name":"City Water Utility","email":"billing@citywater.example"},{"name":"Office Supply Depot","email":"deals@officesupplydepot.example"},{"name":"Neighborly","email":"notifications@neighborly.example"},{"name":"Parkview IT Support","email":"it-support@parkview-pm-help.example"},{"name":"Rewards Center","email":"winner@claim-rewards-now.example"},{"name":"Landlord Learning Hub","email":"news@landlordlearninghub.example"}],"org":{"name":"Parkview Property Management","domain":"parkviewpm.example"},"messages":[{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m1","from":"dcarter@parkviewpm.example","subject":"Welcome aboard, Jordan!","date":"2026-10-21T08:05","starred":false,"unread":true,"important":true,"body":"Hi Jordan,\n\nWelcome to Parkview Property Management! Your first week is about learning our tools. Most of our work happens in Gmail, Calendar, Drive and Meet.\n\nPlease keep an eye on the shared Maintenance and Leasing threads, and ask me anything.\n\nDenise Carter\nOffice Manager"},{"to":["jlee@parkviewpm.example","dcarter@parkviewpm.example"],"box":"inbox","id":"m2","from":"awallace@parkviewpm.example","cc":["knguyen@parkviewpm.example"],"subject":"Showing at Elm Street Apartments moved to Thursday","date":"2026-10-21T09:12","unread":true,"body":"Hi all,\n\nThe prospective tenant for Elm Street Apartments, Unit 2B asked to move Wednesday's showing to Thursday at 4:00 PM. Kim, can someone unlock the side door before then?\n\nThanks,\nAndre"},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m3","from":"pshah@parkviewpm.example","subject":"October rent roll","date":"2026-10-20T16:40","body":"Hi Jordan,\n\nAttached is the October rent roll. Please don't forward it outside the office: it lists every tenant's balance.\n\nPriya","attachments":[{"name":"Rent Roll - October.xlsx","size":"48 KB"}]},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m4","from":"knguyen@parkviewpm.example","subject":"Pest control visit, Riverside Commons","date":"2026-10-20T11:03","body":"FYI, the pest control company will spray the basement at Riverside Commons next Tuesday morning. No action needed from the office.\n\nKim"},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m5","from":"deals@officesupplydepot.example","subject":"30% off printer paper this week","date":"2026-10-21T06:30","category":"Promotions","unread":true,"unsubscribe":true,"body":"Stock up and save: 30% off copy paper, toner and file folders through Sunday."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m6","from":"notifications@neighborly.example","subject":"3 neighbors posted near Elm Street","date":"2026-10-20T19:22","category":"Social","unread":true,"body":"See what your neighbors are saying: a lost cat, a yard sale and a question about recycling day."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m7","from":"billing@citywater.example","subject":"Your October statement is ready","date":"2026-10-19T07:15","category":"Updates","body":"Your October water statement for account 55-1208 (Riverside Commons) is ready to view. Amount due: $412.60."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m8","from":"tony@russoplumbing.example","subject":"Invoice #4471 for Elm Street Apartments","date":"2026-10-19T14:50","body":"Hello,\n\nPlease find attached invoice #4471 for the kitchen sink repair at Elm Street Apartments, Unit 2B, completed October 16.\n\nTony Russo\nRusso Plumbing","attachments":[{"name":"Invoice 4471.pdf","size":"212 KB"}]}],"labels":[],"settings":{"categories":["Primary","Promotions","Social","Updates"]},"view":{"folder":"inbox","calView":"Week","calDate":"2026-10-21"},"tabs":["calendar"],"calendars":[{"id":"main","name":"Jordan Lee","color":"#039be5","mine":true},{"id":"leasing","name":"Leasing Showings","color":"#33b679","mine":true,"description":"Apartment showings for all buildings"},{"id":"holidays","name":"Holidays in United States","color":"#0b8043"},{"id":"denise","name":"Denise Carter","color":"#8e24aa"}],"events":[{"id":"c1","title":"Staff huddle","day":"2026-10-19","start":"09:00","end":"09:30","calendar":"main","organizer":"dcarter@parkviewpm.example","myResponse":"Yes","repeat":"Weekly on Monday","guests":[{"email":"jlee@parkviewpm.example","response":"Yes"},{"email":"awallace@parkviewpm.example","response":"Yes"},{"email":"pshah@parkviewpm.example","response":"Yes"},{"email":"knguyen@parkviewpm.example","response":"Yes"}]},{"id":"c2","title":"Showing: Elm Street Apartments, Unit 2B","day":"2026-10-22","start":"16:00","end":"16:30","calendar":"leasing","location":"Elm Street Apartments"},{"id":"c3","title":"Weekly leasing huddle","day":"2026-10-21","start":"14:00","end":"14:30","calendar":"main","organizer":"awallace@parkviewpm.example","meet":"kpr-tmwq-zse","description":"Agenda: showings this week, applications, renewals.","guests":[{"email":"jlee@parkviewpm.example","response":"Awaiting"},{"email":"dcarter@parkviewpm.example","response":"Yes"}]},{"id":"c4","title":"Owner call: Grace Holloway","day":"2026-10-23","start":"11:00","end":"11:30","calendar":"main","organizer":"dcarter@parkviewpm.example","guests":[{"email":"jlee@parkviewpm.example","response":"Awaiting"},{"email":"gholloway@harborviewholdings.example","response":"Yes"}]},{"id":"c5","title":"Lunch","day":"2026-10-21","start":"12:00","end":"13:00","calendar":"main"},{"id":"c6","title":"Bank deposit run","day":"2026-10-20","start":"15:00","end":"15:30","calendar":"main"},{"id":"c7","title":"Halloween","day":"2026-10-31","allDay":true,"calendar":"holidays"}],"busy":[{"email":"dcarter@parkviewpm.example","day":"2026-10-22","start":"09:00","end":"11:00"},{"email":"dcarter@parkviewpm.example","day":"2026-10-22","start":"13:00","end":"14:00"},{"email":"pshah@parkviewpm.example","day":"2026-10-22","start":"10:00","end":"12:00"},{"email":"pshah@parkviewpm.example","day":"2026-10-22","start":"15:00","end":"16:00"},{"email":"knguyen@parkviewpm.example","day":"2026-10-22","start":"08:00","end":"10:00"}]},"tasks":[{"instruction":"Switch the calendar to Day view.","hint":"At the top right, open the view menu (Week) and select Day.","steps":[{"action":{"kind":"command","id":"cal.view","value":"Day"}}]},{"instruction":"Switch back to Week view.","hint":"Open the view menu (Day) and select Week.","steps":[{"action":{"kind":"command","id":"cal.view","value":"Week"}}]},{"instruction":"Create an event named “Fire alarm inspection, Riverside Commons” on Thursday, October 22, from 9:00 to 10:00 AM.","hint":"In the grid, click 9:00 AM in the Thursday 22 column. Type the title in Add title and time, then select Save.","steps":[{"action":{"kind":"type","target":"event:new","value":"Title: Fire alarm inspection, Riverside Commons\nDate: Thu, Oct 22, 2026\nStart: 9:00 AM\nEnd: 10:00 AM\nAll day: no\nRepeat: Does not repeat\nGoogle Meet: no\nNotification: 30 minutes before\nCalendar: Jordan Lee\nInvitations: none\nDescription: ","match":"includes"},"alt":[{"kind":"type","target":"event:new","value":["Title: Fire alarm inspection, Riverside Commons","Date: Thu, Oct 22, 2026","Start: 9:00 AM","End: 10:00 AM"],"match":"all"}]}]},{"instruction":"Open the inspection and edit it: set the location to “Riverside Commons” and add an email notification 1 day before (keep the 30-minute notification). Save.","hint":"Click the event › Edit event (pencil) › Add location › Add notification › change Notification to Email and the time to 1 day before › Save.","steps":[{"action":{"kind":"type","target":"event:e1","value":"Title: Fire alarm inspection, Riverside Commons\nDate: Thu, Oct 22, 2026\nStart: 9:00 AM\nEnd: 10:00 AM\nAll day: no\nRepeat: Does not repeat\nGoogle Meet: no\nLocation: Riverside Commons\nNotification: 30 minutes before\nEmail: 1 day before\nCalendar: Jordan Lee\nInvitations: none\nDescription: ","match":"includes"},"alt":[{"kind":"type","target":"event:e1","value":["Location: Riverside Commons","Notification: 30 minutes before","Email: 1 day before"],"match":"all"}]}]},{"instruction":"Add a task “Order lobby light bulbs” for Friday, October 23.","hint":"Create › Task. Type the title, set the date to Friday, October 23, and select Save.","steps":[{"action":{"kind":"type","target":"task:new","value":"Title: Order lobby light bulbs\nDate: Fri, Oct 23, 2026\nList: My Tasks\nDescription: ","match":"includes"},"alt":[{"kind":"type","target":"task:new","value":["Title: Order lobby light bulbs","Date: Fri, Oct 23, 2026"],"match":"all"}]}]},{"instruction":"Create a new calendar named “Building Inspections” so inspections can be shown or hidden together.","hint":"In the left panel, next to Other calendars, select Add other calendars (+) › Create new calendar. Type the name and select Create calendar.","steps":[{"action":{"kind":"type","target":"newcal","value":"Name: Building Inspections\nDescription: ","match":"includes"},"alt":[{"kind":"type","target":"newcal","value":["Name: Building Inspections"],"match":"all"}]}]},{"instruction":"Back on the calendar, hide the Holidays in United States calendar by unchecking it.","hint":"Select Back to calendar (arrow) at the top left of Settings. In the left panel under Other calendars, uncheck Holidays in United States.","steps":[{"action":{"kind":"command","id":"cal.show","value":"holidays|off"}}]}]}}]]}]]}]

26:["$","div","2",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Notifications"}],["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"To change the reminders on one event, open it, select Edit event, and under the notifications choose a notification (a pop-up on your screen or phone) or an email, and how long before. Select Add notification for another one, then Save. To change the reminders Calendar adds to every new event, open Settings, choose your calendar under Settings for my calendars, and edit Event notifications."}],["$","div","1",{"className":"bg-green-50 border-l-4 border-green-400 p-4 rounded-xl text-gray-800 leading-relaxed","children":[["$","span",null,{"aria-hidden":"true","children":"💡 "}],"If pop-up notifications never appear on your computer, your browser may be blocking them. Allow notifications for calendar.google.com in your browser's site settings."]}]]}]]}]
27:["$","div","3",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Tasks and separate calendars"}],["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"A task is a to-do with a date. Select Create, then Task (or click a time and choose Task), type a title, set the date and an optional time, and select Save. Tasks with a date show on your calendar when Tasks is checked under My calendars. When you finish, open the task and mark it completed. You can also open Tasks from the side panel in Gmail and Calendar."}],["$","p","1",{"className":"text-gray-700 leading-relaxed","children":"Separate calendars keep different kinds of events apart. To make one, next to Other calendars select Add other calendars (+), then Create new calendar. Give it a name and description, and select Create calendar. Each calendar gets its own color, and you can check or uncheck it to show or hide its events. To remove one from the list entirely, point to it and choose Options, then Hide from list."}],["$","$L2d","2",{"block":{"type":"drag-drop","mode":"sort","title":"Event, task, or appointment schedule?","prompt":"Drag each item to what you'd create in Google Calendar.","buckets":[{"id":"event","label":"Event"},{"id":"task","label":"Task"},{"id":"appt","label":"Appointment schedule"}],"items":[{"id":"a","text":"Fire alarm inspection Thursday 9:00 to 10:00 AM","bucket":"event"},{"id":"b","text":"Order lobby light bulbs by Friday","bucket":"task"},{"id":"c","text":"Times tenants can book a 30-minute call with the office","bucket":"appt"},{"id":"d","text":"Weekly staff huddle every Monday at 9:00 AM","bucket":"event"},{"id":"e","text":"Renew the office's domain name before the end of the month","bucket":"task"},{"id":"f","text":"Open slots for applicants to book apartment tours","bucket":"appt"}],"explanation":"Events happen at a time. Tasks are things you check off by a date. Appointment schedules offer open times that other people book."}}],["$","div","3",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-blue-50 border-blue-400","children":[false,"If you also use Outlook, its calendar works much the same way. Google Calendar's Tasks play the role that Microsoft To Do plays next to Outlook."]}]]}]]}]
28:["$","div","4",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Knowledge Check"}],["$","div",null,{"className":"space-y-6","children":[["$","$L2e","0",{"block":{"type":"knowledge-check","question":"You want an email reminder the day before an inspection. Where do you set it?","options":["In Gmail's Settings","On the event: Edit event › notifications › Email, 1 day before › Save","In the mini calendar","You can't; Calendar only shows pop-ups"],"correctIndex":1,"explanation":"Each event can have several notifications, and each one can be a pop-up notification or an email.","optionRationales":["Gmail settings don't control event reminders.","Correct.","The mini calendar is for moving between dates.","Calendar offers email notifications too."]}}],["$","$L2e","1",{"block":{"type":"knowledge-check","question":"What's the difference between hiding a calendar by unchecking it and choosing Hide from list?","options":["There's no difference","Unchecking hides its events for now; Hide from list removes it from the left panel","Unchecking deletes the calendar","Hide from list deletes its events"],"correctIndex":1,"explanation":"Unchecking is a quick on/off switch. Hide from list takes the calendar out of the list; you can bring it back from Settings.","optionRationales":["They do different things.","Correct.","Unchecking never deletes anything.","Hiding doesn't delete events."]}}]]}]]}]

25:["$","div","3",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Present your screen"}],["$","div",null,{"className":"space-y-6","children":[["$","ol","0",{"start":"$undefined","className":"list-decimal pl-6 space-y-3 text-gray-700 marker:font-semibold marker:text-primary-600","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Select Present now."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"Choose A tab, A window, or Your entire screen."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Pick the tab or window and select Share."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"When you're done, select Stop presenting."}]]}],["$","p","1",{"className":"text-gray-700 leading-relaxed","children":"Presenting a tab shares that tab's sound too. For a window or your entire screen, turn on Also share system audio in the sharing window if people need to hear it. A meeting allows up to 10 presentations at the same time, and your organization's settings or the meeting host can turn presenting off."}],["$","div","2",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"Share a tab or a window, not your entire screen, whenever you can. Your entire screen shows everything, including email notifications and any tenant information that pops up."]}]]}]]}]
26:["$","div","4",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Layouts, Meeting tools, and recording"}],["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"To change how people appear, select More options › Change layout. Auto (dynamic) is the default and adjusts to the meeting. Tiled (legacy) shows people in a grid. Spotlight fills the window with the speaker or the presentation. Sidebar shows the speaker or presentation large with others at the side."}],["$","p","1",{"className":"text-gray-700 leading-relaxed","children":"Meeting tools at the bottom right holds features such as Recording. Recording is only available with certain Google Workspace editions (and Google One plans with 2 TB or more), and an administrator has to allow it; a free personal account can't record. When a meeting is recorded, the recording is saved to the organizer's Google Drive in a Google Meet folder."}],["$","div","2",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-blue-50 border-blue-400","children":[false,"If you use Microsoft Teams, the ideas carry over: Teams also has raise hand, reactions, live captions, chat, and sharing a window or screen."]}]]}]]}]
27:["$","div","5",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Knowledge Check"}],["$","div",null,{"className":"space-y-6","children":[["$","$L2f","0",{"block":{"type":"knowledge-check","question":"You're joining from a loud front office. What should you do on the preview screen?","options":["Join with your microphone on","Turn off your microphone, consider blurring your background, then join","Turn off your camera and microphone and never turn them on","Leave and rejoin later"],"correctIndex":1,"explanation":"Start muted in a noisy place and turn the microphone on when you speak. A blurred background hides the busy office.","optionRationales":["Background noise disrupts the call.","Correct.","You'll need to speak when it's your turn.","Joining late isn't necessary."]}}],["$","$L2f","1",{"block":{"type":"knowledge-check","question":"Which is the safest way to show one slide deck?","options":["Present now › Your entire screen","Present now › A tab, and choose the slides' tab","Email the slides during the call","Hold your phone up to the camera"],"correctIndex":1,"explanation":"Sharing one tab shows only that tab, so notifications and other windows stay private.","optionRationales":["Everything on your screen would be visible, including pop-ups.","Correct.","That doesn't let you walk people through it live.","That's hard to see and unprofessional."]}}],["$","$L2f","2",{"block":{"type":"knowledge-check","question":"Can you record a Google Meet call with a free personal Google Account?","options":["Yes, always","No; recording needs an eligible Google Workspace edition or a Google One plan with 2 TB or more","Only on Mondays","Only if you're presenting"],"correctIndex":1,"explanation":"Recording depends on your edition and your administrator's settings.","optionRationales":["Recording isn't included with free personal accounts.","Correct.","Days don't matter.","Presenting doesn't affect recording."]}}]]}]]}]

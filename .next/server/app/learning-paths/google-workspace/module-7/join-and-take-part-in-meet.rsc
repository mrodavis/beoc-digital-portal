@parkviewpm.example","response":"Yes"},{"email":"awallace@parkviewpm.example","response":"Yes"},{"email":"pshah@parkviewpm.example","response":"Yes"},{"email":"knguyen@parkviewpm.example","response":"Yes"}]},{"id":"c2","title":"Showing: Elm Street Apartments, Unit 2B","day":"2026-10-22","start":"16:00","end":"16:30","calendar":"leasing","location":"Elm Street Apartments"},{"id":"c3","title":"Weekly leasing huddle","day":"2026-10-21","start":"14:00","end":"14:30","calendar":"main","organizer":"awallace@parkviewpm.example","meet":"kpr-tmwq-zse","description":"Agenda: showings this week, applications, renewals.","guests":[{"email":"jlee@parkviewpm.example","response":"Awaiting"},{"email":"dcarter@parkviewpm.example","response":"Yes"}]},{"id":"c4","title":"Owner call: Grace Holloway","day":"2026-10-23","start":"11:00","end":"11:30","calendar":"main","organizer":"dcarter@parkviewpm.example","guests":[{"email":"jlee@parkviewpm.example","response":"Awaiting"},{"email":"gholloway@harborviewholdings.example","response":"Yes"}]},{"id":"c5","title":"Lunch","day":"2026-10-21","start":"12:00","end":"13:00","calendar":"main"},{"id":"c6","title":"Bank deposit run","day":"2026-10-20","start":"15:00","end":"15:30","calendar":"main"},{"id":"c7","title":"Halloween","day":"2026-10-31","allDay":true,"calendar":"holidays"}],"busy":[{"email":"dcarter@parkviewpm.example","day":"2026-10-22","start":"09:00","end":"11:00"},{"email":"dcarter@parkviewpm.example","day":"2026-10-22","start":"13:00","end":"14:00"},{"email":"pshah@parkviewpm.example","day":"2026-10-22","start":"10:00","end":"12:00"},{"email":"pshah@parkviewpm.example","day":"2026-10-22","start":"15:00","end":"16:00"},{"email":"knguyen@parkviewpm.example","day":"2026-10-22","start":"08:00","end":"10:00"}],"now":"14:06","rooms":["$1d:props:children:1:props:children:0:props:sim:initial:rooms:0"],"meeting":{"code":"kpr-tmwq-zse","stage":"in","mic":true,"camera":true,"effect":"None","layout":"Auto (dynamic)","chat":["$1d:props:children:1:props:children:0:props:sim:initial:rooms:0:chat:0"],"participants":[{"email":"awallace@parkviewpm.example","camera":true},{"email":"dcarter@parkviewpm.example","muted":true,"camera":true}]},"browserTabs":["Lease Renewal Deck - Google Slides","Inbox - jlee@parkviewpm.example - Gmail","Maintenance Request Log - Google Sheets"],"windows":["File Explorer","Calculator"]},"tasks":[{"instruction":"Present only the browser tab with your Lease Renewal Deck.","hint":"Present now › A tab › Lease Renewal Deck - Google Slides › Share.","steps":[{"action":{"kind":"command","id":"meet.present","value":"A tab: Lease Renewal Deck - Google Slides"}}]},{"instruction":"You're done with the deck. Stop presenting.","hint":"Select Stop presenting on the “You are presenting” bar.","steps":[{"action":{"kind":"command","id":"meet.stopPresent"}}]},{"instruction":"React with a thumbs up to Denise's update.","hint":"Select Send a reaction (smiley face) on the bottom bar › Thumbs up.","steps":[{"action":{"kind":"command","id":"meet.react","value":"Thumbs up"}}]},{"instruction":"Change the layout to Sidebar.","hint":"More options (three dots) › Change layout › Sidebar.","steps":[{"action":{"kind":"command","id":"meet.layout","value":"Sidebar"}}]},{"instruction":"Open Meeting tools to see what's available, such as Recording.","hint":"Select Meeting tools (bottom right).","steps":[{"action":{"kind":"command","id":"meet.panel","value":"tools"}}]},{"instruction":"The huddle is over. Leave the call.","hint":"Select Leave call (red phone button).","steps":[{"action":{"kind":"command","id":"meet.leave"}}]}]}}]

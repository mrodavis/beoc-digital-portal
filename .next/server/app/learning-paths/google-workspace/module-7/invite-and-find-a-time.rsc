24:["$","div","2",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Answer an invitation"}],["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"Open the event on your calendar and choose Yes, No, or Maybe next to Going?. You can also answer from the invitation email in Gmail. To explain your answer, select the arrow next to Maybe and choose Add note; your note is visible to all invitees. If the time doesn't work, choose Propose a new time from the same menu, pick a different time, and select Send proposal. (Propose a new time isn't available for all-day events or events with more than 200 guests.)"}],["$","$L29","1",{"block":{"type":"drag-drop","mode":"match","title":"How would you answer?","prompt":"Drag the best response onto each invitation.","items":[{"id":"a","text":"The weekly leasing huddle, and you're free","match":"Yes"},{"id":"b","text":"An owner call that may overlap with a showing you can't move","match":"Maybe, with a note"},{"id":"c","text":"A vendor demo during your vacation","match":"No"},{"id":"d","text":"A meeting you must attend, but the time conflicts with a doctor's appointment","match":"Propose a new time"}],"explanation":"Answer every invitation so the organizer can plan. A note or a proposed time saves a round of emails."}}]]}]]}]
25:["$","div","3",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Time zones"}],["$","div",null,{"className":"space-y-6","children":[["$","p","0",{"className":"text-gray-700 leading-relaxed","children":"Calendar shows events in your time zone, and each guest sees the event in their own time zone. When you schedule with someone in another zone, you can set the event in their zone: on the event page, select Time zone next to the time and choose theirs. To keep another zone in view, open Settings › General › Time zone, check Show additional time zones, and choose a Secondary time zone. It appears as a second column of times next to yours."}],["$","figure","1",{"children":[["$","div",null,{"className":"overflow-x-auto rounded-xl border border-gray-200","children":["$","table",null,{"className":"w-full text-left border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-gray-50","children":[["$","th","0",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"Grace Holloway in Los Angeles sees"}],["$","th","1",{"scope":"col","className":"px-4 py-3 text-sm font-semibold text-gray-900 border-b border-gray-200","children":"You in New York see"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"even:bg-gray-50/50","children":[["$","td","0",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"1:00 PM to 1:30 PM Pacific Time"}],["$","td","1",{"className":"px-4 py-3 text-gray-700 border-b border-gray-100 align-top leading-relaxed","children":"4:00 PM to 4:30 PM Eastern Time"}]]}]]}]]}]}],["$","figcaption",null,{"className":"text-sm text-gray-500 mt-2 italic","children":"One call, two clocks"}]]}],["$","div","2",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-yellow-50 border-yellow-400","children":[false,"Before you send an invitation across time zones, check the time on your own calendar. A call set for 1:00 PM in Los Angeles is 4:00 PM in New York."]}]]}]]}]
26:["$","div","4",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Knowledge Check"}],["$","div",null,{"className":"space-y-6","children":[["$","$L2a","0",{"block":{"type":"knowledge-check","question":"Find a time shows Priya's whole day as unknown instead of free or busy. Why?","options":["Priya hasn't shared her calendar with you","Priya is on vacation","Find a time only works on Mondays","You forgot to add Google Meet"],"correctIndex":0,"explanation":"You can only see busy times on calendars shared with you or within your organization. You can ask Priya to share hers.","optionRationales":["Correct.","Vacation would show as busy if you could see her calendar.","Find a time works any day.","A Meet link doesn't affect availability."]}}],["$","$L2a","1",{"block":{"type":"knowledge-check","question":"You can attend an owner call but might be 10 minutes late. What's the best answer?","options":["No","Ignore the invitation","Yes, with a note that you may be 10 minutes late","Delete the event"],"correctIndex":2,"explanation":"Answer and add a note (arrow next to Maybe › Add note) so the organizer knows what to expect.","optionRationales":["You can attend, so No is misleading.","Organizers rely on answers to plan.","Correct.","Deleting the event doesn't tell the organizer anything."]}}],["$","$L2a","2",{"block":{"type":"knowledge-check","question":"Where do you add a second column of times for Pacific Time?","options":["Settings › General › Time zone › Show additional time zones","On every event's page","In Gmail's settings","In the mini calendar"],"correctIndex":0,"explanation":"A secondary time zone is a Calendar setting, and it shows on every day and week view.","optionRationales":["Correct.","The event page sets one event's zone, not your view.","Gmail doesn't control Calendar's view.","The mini calendar only picks dates."]}}]]}]]}]

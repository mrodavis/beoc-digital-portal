"}]},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m4","from":"knguyen@parkviewpm.example","subject":"Pest control visit, Riverside Commons","date":"2026-10-20T11:03","body":"FYI, the pest control company will spray the basement at Riverside Commons next Tuesday morning. No action needed from the office.\n\nKim"},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m5","from":"deals@officesupplydepot.example","subject":"30% off printer paper this week","date":"2026-10-21T06:30","category":"Promotions","unread":true,"unsubscribe":true,"body":"Stock up and save: 30% off copy paper, toner and file folders through Sunday."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m6","from":"notifications@neighborly.example","subject":"3 neighbors posted near Elm Street","date":"2026-10-20T19:22","category":"Social","unread":true,"body":"See what your neighbors are saying: a lost cat, a yard sale and a question about recycling day."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m7","from":"billing@citywater.example","subject":"Your October statement is ready","date":"2026-10-19T07:15","category":"Updates","body":"Your October water statement for account 55-1208 (Riverside Commons) is ready to view. Amount due: $412.60."},{"to":["jlee@parkviewpm.example"],"box":"inbox","id":"m8","from":"tony@russoplumbing.example","subject":"Invoice #4471 for Elm Street Apartments","date":"2026-10-19T14:50","body":"Hello,\n\nPlease find attached invoice #4471 for the kitchen sink repair at Elm Street Apartments, Unit 2B, completed October 16.\n\nTony Russo\nRusso Plumbing","attachments":[{"name":"Invoice 4471.pdf","size":"212 KB"}]}],"labels":[],"settings":{"categories":["Primary","Promotions","Social","Updates"]},"view":{"folder":"inbox","calView":"Week","calDate":"2026-10-21"},"tabs":["calendar"],"calendars":[{"id":"main","name":"Jordan Lee","color":"#039be5","mine":true},{"id":"leasing","name":"Leasing Showings","color":"#33b679","mine":true,"description":"Apartment showings for all buildings"},{"id":"holidays","name":"Holidays in United States","color":"#0b8043"},{"id":"denise","name":"Denise Carter","color":"#8e24aa"}],"events":[{"id":"c1","title":"Staff huddle","day":"2026-10-19","start":"09:00","end":"09:30","calendar":"main","organizer":"dcarter@parkviewpm.example","myResponse":"Yes","repeat":"Weekly on Monday","guests":[{"email":"jlee@parkviewpm.example","response":"Yes"},{"email":"awallace@parkviewpm.example","response":"Yes"},{"email":"pshah@parkviewpm.example","response":"Yes"},{"email":"knguyen@parkviewpm.example","response":"Yes"}]},{"id":"c2","title":"Showing: Elm Street Apartments, Unit 2B","day":"2026-10-22","start":"16:00","end":"16:30","calendar":"leasing","location":"Elm Street Apartments"},{"id":"c3","title":"Weekly leasing huddle","day":"2026-10-21","start":"14:00","end":"14:30","calendar":"main","organizer":"awallace@parkviewpm.example","meet":"kpr-tmwq-zse","description":"Agenda: showings this week, applications, renewals.","guests":[{"email":"jlee@parkviewpm.example","response":"Awaiting"},{"email":"dcarter@parkviewpm.example","response":"Yes"}]},{"id":"c4","title":"Owner call: Grace Holloway","day":"2026-10-23","start":"11:00","end":"11:30","calendar":"main","organizer":"dcarter@parkviewpm.example","guests":[{"email":"jlee@parkviewpm.example","response":"Awaiting"},{"email":"gholloway@harborviewholdings.example","response":"Yes"}]},{"id":"c5","title":"Lunch","day":"2026-10-21","start":"12:00","end":"13:00","calendar":"main"},{"id":"c6","title":"Bank deposit run","day":"2026-10-20","start":"15:00","end":"15:30","calendar":"main"},{"id":"c7","title":"Halloween","day":"2026-10-31","allDay":true,"calendar":"holidays"}],"busy":[{"email":"dcarter@parkviewpm.example","day":"2026-10-22","start":"09:00","end":"11:00"},{"email":"dcarter@parkviewpm.example","day":"2026-10-22","start":"13:00","end":"14:00"},{"email":"pshah@parkviewpm.example","day":"2026-10-22","start":"10:00","end":"12:00"},{"email":"pshah@parkviewpm.example","day":"2026-10-22","start":"15:00","end":"16:00"},{"email":"knguyen@parkviewpm.example","day":"2026-10-22","start":"08:00","end":"10:00"}]},"tasks":[{"instruction":"Open Andre Wallace's invitation “Weekly leasing huddle” (today at 2:00 PM) and answer Yes.","hint":"Click the event in the Wednesday 21 column. Next to Going?, select Yes.","steps":[{"action":{"kind":"command","id":"cal.rsvp","value":"Yes"},"requires":{"selection":"evt:c3"},"selectHint":"Click the Weekly leasing huddle event first."}]},{"instruction":"Answer Maybe to “Owner call: Grace Holloway” on Friday.","hint":"Close the open card, click the Friday 11:00 AM event, and select Maybe.","steps":[{"action":{"kind":"command","id":"cal.rsvp","value":"Maybe"},"requires":{"selection":"evt:c4"},"selectHint":"Click the Owner call: Grace Holloway event first."}]},{"instruction":"Create “Lease renewal review” on Thursday, October 22, with Denise Carter and Priya Shah as guests. Use Find a time to choose the first hour after 1:00 PM when all three of you are free. Add Google Meet video conferencing, save, and send the invitations.","hint":"Create › Event › type the title › set the date to Oct 22 › More options. Under Guests, add Denise and Priya. Open the Find a time tab and click the first free time after 1:00 PM (2:00 PM). Back on Event details, select Add Google Meet video conferencing. Save › Send.","steps":[{"action":{"kind":"type","target":"event:new","value":"Title: Lease renewal review\nDate: Thu, Oct 22, 2026\nStart: 2:00 PM\nEnd: 3:00 PM\nAll day: no\nRepeat: Does not repeat\nGuest: dcarter@parkviewpm.example\nGuest: pshah@parkviewpm.example\nGoogle Meet: yes\nNotification: 30 minutes before\nCalendar: Jordan Lee\nGuests can: see guest list\nInvitations: Send\nDescription: ","match":"includes"},"alt":[{"kind":"type","target":"event:new","value":["Title: Lease renewal review","Date: Thu, Oct 22, 2026","Start: 2:00 PM","End: 3:00 PM","Guest: dcarter@parkviewpm.example","Guest: pshah@parkviewpm.example","Google Meet: yes","Invitations: Send"],"match":"all"}]}]},{"instruction":"Grace Holloway is in Los Angeles. Create “Roof estimate call with Grace” on Friday, October 23, from 1:00 to 1:30 PM in Grace's time zone, (GMT-07:00) Pacific Time - Los Angeles. Invite Grace and send the invitation.","hint":"Create › Event › title › date Oct 23 › More options. Set 1:00 PM to 1:30 PM, select Time zone and choose (GMT-07:00) Pacific Time - Los Angeles › OK. Add Grace under Guests › Save › Send.","steps":[{"action":{"kind":"type","target":"event:new","value":"Title: Roof estimate call with Grace\nDate: Fri, Oct 23, 2026\nStart: 1:00 PM\nEnd: 1:30 PM\nAll day: no\nRepeat: Does not repeat\nTime zone: (GMT-07:00) Pacific Time - Los Angeles\nGuest: gholloway@harborviewholdings.example\nGoogle Meet: no\nNotification: 30 minutes before\nCalendar: Jordan Lee\nGuests can: see guest list\nInvitations: Send\nDescription: ","match":"includes"},"alt":[{"kind":"type","target":"event:new","value":["Title: Roof estimate call with Grace","Date: Fri, Oct 23, 2026","Start: 1:00 PM","End: 1:30 PM","Time zone: (GMT-07:00) Pacific Time - Los Angeles","Guest: gholloway@harborviewholdings.example","Invitations: Send"],"match":"all"}]}]},{"instruction":"Show Pacific Time - Los Angeles as a secondary time zone on your calendar so you can see Grace's time next to yours.","hint":"Settings menu (gear) › Settings › General › Time zone. Check Show additional time zones, then choose (GMT-07:00) Pacific Time - Los Angeles as the Secondary time zone. Changes save automatically.","anyOrder":true,"steps":[{"action":{"kind":"type","target":"settings:timezone","value":"Show additional time zones: on","match":"includes"},"alt":[{"kind":"type","target":"settings:timezone","value":["Show additional time zones: on"],"match":"all"}]},{"action":{"kind":"type","target":"settings:timezone","value":"Secondary time zone: (GMT-07:00) Pacific Time - Los Angeles","match":"includes"},"alt":[{"kind":"type","target":"settings:timezone","value":["Secondary time zone: (GMT-07:00) Pacific Time - Los Angeles"],"match":"all"}]}]}]}}]]}]]}]

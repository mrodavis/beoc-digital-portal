1a:["$","div",null,{"id":"practice-simulation","className":"mb-12 scroll-mt-24","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Practice Simulation"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Practice what this lesson taught in a working copy of the app. Tasks appear under the window, just like GMetrix."}]]}],["$","div",null,{"className":"space-y-10","style":{"width":"min(1360px, calc(100vw - 2rem))","marginLeft":"calc((100% - min(1360px, calc(100vw - 2rem))) / 2)"},"children":[["$","$L27","gw-m7-invite-and-find-a-time-1",{"sim":{"id":"gw-m7-invite-and-find-a-time-1","app":"gmail","title":"Answer invitations and schedule the lease renewal review","scenario":"Andre and Denise sent you invitations, and Denise wants a lease renewal review with Priya this Thursday at the first hour everyone is free.","fileName":"Google Calendar","minutes":8,"initial":{"surface":"calendar","me":{"name":"Jordan Lee","email":"jlee@parkviewpm.example","color":"#1a73e8"},"people":[{"name":"Denise Carter","email":"dcarter@parkviewpm.example","color":"#188038","contact":true},{"name":"Marcus Reyes","email":"mreyes@parkviewpm.example","color":"#e8710a","contact":true},{"name":"Kim Nguyen","email":"knguyen@parkviewpm.example","color":"#9334e6","contact":true},{"name":"Priya Shah","email":"pshah@parkviewpm.example","color":"#d93025","contact":true},{"name":"Andre Wallace","email":"awallace@parkviewpm.example","color":"#12858a","contact":true},{"name":"Tony Russo","email":"tony@russoplumbing.example","color":"#b06000","contact":true},{"name":"Grace Holloway","email":"gholloway@harborviewholdings.example","contact":true},{"name":"Darnell Brooks","email":"dbrooks@example.com","contact":true},{"name":"Rosa Delgado","email":"rdelgado@example.com"},{"name":"Tina Okafor","email":"tokafor@example.com","contact":
ed":"Oct 9, 2026"},{"id":"f1","name":"New Tenant Welcome - Riverside Commons","kind":"slides","parent":"fR","modified":"Oct 20, 2026","sharing":{"people":[{"email":"dcarter@parkviewpm.example","role":"Editor"}]},"content":{"active":"s1","theme":"Streamline","slides":[{"id":"s1","layout":"Title slide","title":"Welcome to Riverside Commons","subtitle":"Parkview Property Management"},{"id":"s2","layout":"Title and body","title":"Your First Week","body":["Pick up your keys and key fob at the office","Set up online rent payment","Walk through your apartment and note any damage"]},{"id":"s3","layout":"Title and body","title":"Who to Call","body":["Office: (555) 019-2400, Monday to Friday, 9:00 AM to 5:00 PM","Maintenance requests: the online form or the office","Emergencies after hours: the number on your key tag"]},{"id":"s4","layout":"Title and body","title":"Laundry and Trash","body":["Laundry room: basement, 7:00 AM to 10:00 PM","Trash and recycling: bins behind Building B","Bulk pickup: call the office to schedule"]}]}}]},"tasks":[{"instruction":"Give slide 2 the Dissolve transition.","hint":"Click slide 2 › Slide › Transition (or Transition on the toolbar). In the Motion panel, choose Dissolve under Slide Transition.","steps":[{"action":{"kind":"command","id":"transition.apply","value":"Dissolve"},"requires":{"slide":"s2"},"selectHint":"Click slide 2 in the filmstrip first."}]},{"instruction":"Use the same transition on every slide.","hint":"In the Motion panel, select Apply to all slides.","steps":[{"action":{"kind":"command","id":"transition.applyAll"}}]},{"instruction":"Animate the bulleted text on slide 2 with Fade in.","hint":"Click the bulleted text on slide 2 › Insert › Animation (or View › Motion). Under Object Animations, select Add animation: a new animation starts as Appear (On click). Then change Appear to Fade in in the animation drop-down.","steps":[{"action":{"kind":"command","id":"animation.apply","value":"Appear"},"requires":{"selection":"s2.body"},"selectHint":"Click the bulleted text on slide 2 first."},{"action":{"kind":"command","id":"animation.apply","value":"Fade in"},"requires":{"selection":"s2.body"},"selectHint":"Click the bulleted text on slide 2 first."}]},{"instruction":"Make that animation start After previous instead of On click.","hint":"In the Motion panel, open the start menu under the animation and choose After previous.","steps":[{"action":{"kind":"command","id":"animation.start","value":"After previous"},"requires":{"selection":"s2.body"},"selectHint":"Click the bulleted text on slide 2 first."}]},{"instruction":"Show the speaker notes area.","hint":"View › Show speaker notes.","steps":[{"action":{"kind":"command","id":"g.view","value":"notes"}}]},{"instruction":"Add the speaker note “Hand out the key fob form here.” to slide 2.","hint":"Click Click to add speaker notes under slide 2, type the note, and press Enter.","steps":[{"action":{"kind":"type","target":"s2.notes","value":"Hand out the key fob form here."}}]}]}}]]}]]}]

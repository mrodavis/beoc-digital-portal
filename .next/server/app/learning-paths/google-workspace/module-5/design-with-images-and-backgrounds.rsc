1b:["$","div",null,{"id":"practice-simulation","className":"mb-12 scroll-mt-24","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Practice Simulation"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Practice what this lesson taught in a working copy of the app. Tasks appear under the window, just like GMetrix."}]]}],["$","div",null,{"className":"space-y-10","style":{"width":"min(1360px, calc(100vw - 2rem))","marginLeft":"calc((100% - min(1360px, calc(100vw - 2rem))) / 2)"},"children":[["$","$L23","gw-m5-design-with-images-and-backgrounds-1",{"sim":{"id":"gw-m5-design-with-images-and-backgrounds-1","app":"google","title":"Make the welcome deck look finished","scenario":"The welcome deck has the right words but looks plain. Denise sent a photo of the Riverside Commons lobby to use, and wants the contact slide to stand out.","fileName":"New Tenant Welcome - Riverside Commons","minutes":5,"initial":{"me":{"name":"Jordan Lee","email":"jlee@parkviewpm.example","color":"#1a73e8"},"org":{"name":"Parkview Property Management","domain":"parkviewpm.example"},"people":[{"name":"Denise Carter","email":"dcarter@parkviewpm.example","color":"#188038"},{"name":"Marcus Reyes","email":"mreyes@parkviewpm.example","color":"#e8710a"},{"name":"Kim Nguyen","email":"knguyen@parkviewpm.example","color":"#9334e6"},{"name":"Priya Shah","email":"pshah@parkviewpm.example","color":"#d93025"},{"name":"Andre Wallace","email":"awallace@parkviewpm.example","color":"#12858a"},{"name":"Tony Russo","email":"tony@russoplumbing.example","color":"#b06000"}],"surface":"slides","open":"f1","tabs":["f1"],"computer":["Riverside Commons Lobby.jpg","Laundry Room.jpg","Parkview Logo.png"],"files":[{"id":"fR","name":"Riverside Commons","kind":"folder","parent":"root","modified":"Oct 12, 2026"},{"id":"fE","name":"Elm Street Apartments","kind":"folder","parent":"root","modified":"Oct 9, 2026"},{"id":"f1","name":"New Tenant Welcome - Riverside Commons","kind":"slides","parent":"fR","modified":"Oct 20, 2026","sharing":{"people":[{"email":"dcarter@parkviewpm.example","role":"Editor"}]},"content":{"active":"s1","theme":"Streamline","slides":[{"id":"s1","layout":"Title slide","title":"Welcome to Riverside Commons","subtitle":"Parkview Property Management"},{"id":"s2","layout":"Title and body","title":"Your First Week","body":["Pick up your keys and key fob at the office","Set up online rent payment","Walk through your apartment and note any damage"]},{"id":"s3","layout":"Title and body","title":"Who to Call","body":["Office: (555) 019-2400, Monday to Friday, 9:00 AM to 5:00 PM","Maintenance requests: the online form or the office","Emergencies after hours: the number on your key tag"]},{"id":"s4","layout":"Title and body","title":"Laundry and Trash","body":["Laundry room: basement, 7:00 AM to 10:00 PM","Trash and recycling: bins behind Building B","Bulk pickup: call the office to schedule"]}]}}]},"tasks":[{"instruction":"On slide 1, insert the picture Riverside Commons Lobby.jpg from the computer.","hint":"With slide 1 selected, select Insert › Image › Upload from computer (or Insert image on the toolbar), choose Riverside Commons Lobby.jpg, and select Insert.","steps":[{"action":{"kind":"dialog","id":"g.image","values":{"file":"Riverside Commons Lobby.jpg"}},"requires":{"slide":"s1"},"selectHint":"Click slide 1 in the filmstrip first."}]},{"instruction":"Give slide 3 (“Who to Call”) the background color light cyan 3, on that slide only.","hint":"Click slide 3 in the filmstrip › Slide › Change background (or Background on the toolbar). Click the box to the right of Color, pick light cyan 3, and select Done. (Add to theme would change every slide.)","steps":[{"action":{"kind":"dialog","id":"g.background","values":{"color":"#d0e0e3","addToTheme":false}},"requires":{"slide":"s3"},"selectHint":"Click slide 3 in the filmstrip first."}]},{"instruction":"On slide 4, insert a Rounded rectangle shape.","hint":"Click slide 4 › Insert › Shape › Rounded rectangle (or Shape on the toolbar).","steps":[{"action":{"kind":"command","id":"insert.shape","value":"Rounded rectangle"},"requires":{"slide":"s4"},"selectHint":"Click slide 4 in the filmstrip first."}]},{"instruction":"Duplicate slide 2 so you can make a version for Elm Street Apartments.","hint":"Right-click slide 2 in the filmstrip › Duplicate slide. (Or Slide › Duplicate slide.)","steps":[{"action":{"kind":"command","id":"slides.duplicate"},"requires":{"slide":"s2"},"selectHint":"Click slide 2 in the filmstrip first."}]},{"instruction":"Move the copy (now slide 3) to the end of the presentation.","hint":"Right-click the copy in the filmstrip › Move slide to end. (Or Slide › Move slide › Slide to end, or drag it.)","steps":[{"action":{"kind":"command","id":"slides.move","value":["s5@end","s5@5"]},"requires":{"slide":"s5"},"selectHint":"Click the copy (slide 3) in the filmstrip first."}]}]}}]]}]]}]

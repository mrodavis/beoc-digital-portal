25:["$","div","5",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Knowledge Check"}],["$","div",null,{"className":"space-y-6","children":[["$","$L30","0",{"block":{"type":"knowledge-check","question":"Where do you change a Google Slides file's name?","options":["File › Save as","Click the name at the top left, type, and press Enter","Slide › Edit theme","The name can only be changed in Microsoft PowerPoint"],"correctIndex":1,"explanation":"The presentation's name at the top left is a text box. Click it, type the new name, and press Enter. You can also rename it from Drive.","optionRationales":["Slides has no Save as. Changes save automatically.","Correct.","Edit theme changes colors and layouts, not the file name.","Slides files are renamed in Slides or Drive."]}}],["$","$L30","1",{"block":{"type":"knowledge-check","question":"You want every slide in the presentation to use the same colors and fonts. What's the quickest way?","options":["Format each slide by hand","Apply a theme","Use the Title slide layout everywhere","Download it as a PDF"],"correctIndex":1,"explanation":"A theme styles every slide at once, including slides you add later.","optionRationales":["That's slow, and slides you add later won't match.","Correct. A theme sets colors, fonts, and backgrounds for every slide.","A layout arranges placeholders on one slide; it doesn't set colors and fonts.","Downloading makes a copy; it doesn't change how slides look."]}}],["$","$L30","2",{"block":{"type":"knowledge-check","question":"Slide 4 has a title and bullet points, but you now want to compare two buildings side by side. What do you do?","options":["Delete the slide and start over","Select the slide and choose Layout › Title and two columns","Change the theme","Add a speaker note"],"correctIndex":1,"explanation":"Changing the layout keeps your text and rearranges the placeholders.","optionRationales":["You don't need to start over; the layout can change.","Correct.","The theme changes the look of every slide, not the arrangement of one.","Speaker notes are for the presenter; they don't change the slide."]}}]]}]]}]

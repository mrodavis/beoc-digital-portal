oogle Slides presentation.","hint":"In Drive, select New › Google Slides (or New › Google Slides › Blank presentation).","steps":[{"action":{"kind":"command","id":"g.new","value":"Google Slides"}}]},{"instruction":"Rename the presentation “New Tenant Welcome - Riverside Commons”.","hint":"Click the title “Untitled presentation” at the top left, type the new name, and press Enter.","steps":[{"action":{"kind":"type","target":"rename:new1","value":"New Tenant Welcome - Riverside Commons"}}]},{"instruction":"Apply the Streamline theme.","hint":"In the Themes panel on the right (or Slide › Change theme), select Streamline.","steps":[{"action":{"kind":"command","id":"design.theme","value":"Streamline"}}]},{"instruction":"On slide 1, type the title “Welcome to Riverside Commons”.","hint":"Click Click to add title on the slide, type the title, then click outside the box.","steps":[{"action":{"kind":"type","target":"s1.title","value":"Welcome to Riverside Commons"}}]},{"instruction":"Add a new slide that uses the Title and body layout.","hint":"Select the arrow next to New slide (+) on the toolbar and choose Title and body. (Slide › New slide also adds one.)","steps":[{"action":{"kind":"command","id":"slides.new","value":"Title and body"}}]},{"instruction":"On the new slide, type the title “Your First Week”.","hint":"Click Click to add title on slide 2, type, then click outside the box.","steps":[{"action":{"kind":"type","target":"s2.title","value":"Your First Week"}}]},{"instruction":"Change slide 2's layout to Title and two columns.","hint":"Click slide 2 in the filmstrip (so no text box is selected), then select Layout on the toolbar (or Slide › Apply layout) and choose Title and two columns.","steps":[{"action":{"kind":"command","id":"slides.layout","value":"Title and two columns"},"requires":{"slide":"s2"},"selectHint":"Click slide 2 in the filmstrip first."}]}]}}]]}]]}]

1c:["$","div",null,{"className":"bg-white rounded-2xl shadow-md border border-gray-200 p-8","children":["$","div",null,{"className":"space-y-12","children":[["$","div","0",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Ready for orientation"}],["$","div",null,{"className":"space-y-6","children":[["$","div","0",{"className":"rounded-xl border border-amber-200 bg-amber-50 p-6","children":[["$","span",null,{"className":"block text-xs font-semibold uppercase tracking-wide text-amber-800 mb-2","children":"On the job"}],"$undefined",["$","p",null,{"className":"text-sm font-medium text-amber-900 mb-2","children":"The welcome presentation is almost done."}],["$","p",null,{"className":"text-gray-800 leading-relaxed","children":"A draft slide about parking isn't approved yet. Denise will present at orientation, sometimes over Google Meet for tenants who can't come in. Andre Wallace, the leasing agent, wants to suggest changes. The lobby screen needs a PowerPoint copy, and new tenants get a PDF by email."}],["$","p",null,{"className":"mt-3 pt-3 border-t border-amber-200 text-gray-900","children":[["$","span",null,{"className":"font-semibold","children":"Your task: "}],"Hide the draft slide, rehearse, share with Andre, and make both downloads."]}]]}],["$","ul","1",{"className":"list-disc pl-6 space-y-3 text-gray-700 marker:text-primary-500","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"To skip a slide, right-click it in the filmstrip and choose Skip slide. It stays in the file but doesn't appear in the slideshow. Choose it again to show the slide."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"Skipping is safer than deleting a slide you'll need later: the content and its notes stay in the presentation."}]]}]]}]]}],["$","div","1",{"children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-6","children":"Present your slides"}],["$","div",null,{"className":"space-y-6","children":[["$","ul","0",{"className":"list-disc pl-6 space-y-3 text-gray-700 marker:text-primary-500","children":[["$","li","0",{"className":"leading-relaxed pl-1","children":"Slideshow (top right) presents full screen from the slide you're on. The arrow next to Slideshow has Present from beginning and Presenter view."}],["$","li","1",{"className":"leading-relaxed pl-1","children":"Presenter view opens a separate window with your speaker notes, a timer, and the next slide, while the audience sees only the slides. It works best with a second screen or projector."}],["$","li","2",{"className":"leading-relaxed pl-1","children":"Move through the slides with the arrow keys. Home goes to the first slide and End to the last; type a slide number and press Enter to jump to it."}],["$","li","3",{"className":"leading-relaxed pl-1","children":"While presenting, press S to open speaker notes, L for the laser pointer, and B or W for a blank black or white screen (press any key to return)."}],["$","li","4",{"className":"leading-relaxed pl-1","children":"Press Esc to stop presenting."}]]}],["$","div","1",{"className":"p-4 rounded-xl border-l-4 text-gray-800 leading-relaxed bg-blue-50 border-blue-400","children":[false,"Present in Google Meet (work or school accounts, in Chrome): in the Meet call, select Present now › A tab, choose the presentation's tab, and select Share. Then select Start slideshow in Meet. You can show your speaker notes and add a co-presenter. In PowerPoint and Teams, the matching step is sharing PowerPoint Live in the Teams meeting."]}],["$","$L21","2",{"block":{"type":"drag-drop","mode":"order","title":"Rehearse, then present","prompt":"Put Denise's steps in order for orientation day.","items":[{"id":"1","text":"Right-click the draft parking slide › Skip slide"},{"id":"2","text":"Arrow next to Slideshow › Presenter view, and read through the notes"},{"id":"3","text":"End the rehearsal"},{"id":"4","text":"Arrow next to Slideshow › Present from beginning"},{"id":"5","text":"Press Esc when the last slide is done"}],"explanation":"Hide what isn't ready, rehearse with your notes, then present from the first slide."}}]]}]]}],"$L22","$L23"]}]}]
1d:["$","div",null,{"id":"practice-simulation","className":"mb-12 scroll-mt-24","children":[["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"font-display text-3xl font-bold tracking-tight text-ink sm:text-[40px] sm:leading-[1.05]","children":"Practice Simulation"}],["$","p",null,{"className":"mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft","children":"Practice what this lesson taught in a working copy of the app. Tasks appear under the window, just like GMetrix."}]]}],["$","div",null,{"className":"space-y-10","style":{"width":"min(1360px, calc(100vw - 2rem))","marginLeft":"calc((100% - min(1360px, calc(100vw - 2rem))) / 2)"},"children":[["$","$L24","gw-m5-present-share-and-download-1",{"sim":{"id":"gw-m5-present-share-and-download-1","app":"google","title":"Present, share, and download the welcome deck","scenario":"The deck is ready for Thursday's orientation. A draft slide isn't approved yet, Andre wants to suggest changes, and the lobby screen needs a PowerPoint copy.","fileName":"New Tenant Welcome - Riverside Commons","minutes":5,"initial":{"me":{"name":"Jordan Lee","email":"jlee@parkviewpm.example","color":"#1a73e8"},"org":{"name":"Parkview Property Management","domain":"parkviewpm.example"},"people":[{"name":"Denise Carter","email":"dcarter@parkviewpm.example","color":"#188038"},{"name":"Marcus Reyes","email":"mreyes@parkviewpm.example","color":"#e8710a"},{"name":"Kim Nguyen","email":"knguyen@parkviewpm.example","color":"#9334e6"},{"name":"Priya Shah","email":"pshah@parkviewpm.example","color":"#d93025"},{"name":"Andre Wallace","email":"awallace@parkviewpm.example","color":"#12858a"},{"name":"Tony Russo","email":"tony@russoplumbing.example","color":"#b06000"}],"surface":"slides","open":"f1","tabs":["f1"],"files":[{"id":"fR","name":"Riverside Commons","kind":"folder","parent":"root","modified":"Oct 12, 2026"},{"id":"fE","name":"Elm Street Apartments","kind":"folder","parent":"root","modified":"Oct 9, 2026"},{"id":"f1","name":"New Tenant Welcome - Riverside Commons","kind":"slides","parent":"fR","modified":"Oct 20, 2026","sharing":{"people":[{"email":"dcarter@parkviewpm.example","role":"Editor"}]},"content":{"active":"s1","theme":"Streamline","slides":[{"id":"s1","layout":"Title slide","title":"Welcome to Riverside Commons","subtitle":"Parkview Property Management"},{"id":"s2","layout":"Title and body","title":"Your First Week","body":["Pick up your keys and key fob at the office","Set up online rent payment","Walk through your apartment and note any damage"],"notes":"Hand out the key fob form here."},{"id":"s3","layout":"Title and body","title":"Who to Call","body":["Office: (555) 019-2400, Monday to Friday, 9:00 AM to 5:00 PM","Maintenance requests: the online form or the office","Emergencies after hours: the number on your key tag"]},{"id":"s4","layout":"Title and body","title":"Laundry and Trash","body":["Laundry room: basement, 7:00 AM to 10:00 PM","Trash and recycling: bins behind Building B","Bulk pickup: call the office to schedule"]},{"id":"s5","layout":"Title and body","title":"DRAFT: Parking rules","body":["Waiting for Denise to approve"]}]}}]},"tasks":[{"instruction":"Skip slide 5 (“DRAFT: Parking rules”) so it doesn't appear when you present.","hint":"Right-click slide 5 in the filmstrip › Skip slide. (Or Slide › Skip slide.)","steps":[{"action":{"kind":"command","id":"slides.hide"},"requires":{"slide":"s5"},"selectHint":"Click slide 5 in the filmstrip first."}]},{"instruction":"Rehearse in presenter view so you can see your speaker notes.","hint":"Select the arrow next to Slideshow at the top right › Presenter view. When you're done looking, press Esc to stop presenting.","steps":[{"action":{"kind":"command","id":"slideshow.presenterStart"}}]},{"instruction":"Start the slideshow from the beginning.","hint":"Stop presenter view first (press Esc). Then select the arrow next to Slideshow › Present from beginning. Press Esc to stop.","steps":[{"action":{"kind":"command","id":"slideshow.fromBeginning"}}]},{"instruction":"Share the presentation with Andre Wallace as a Commenter so he can suggest changes without editing.","hint":"Press Esc to leave the slideshow. Select Share (top right), type Andre's address, choose Commenter, and select Send.","steps":[{"action":{"kind":"dialog","id":"g.share","values":{"file":"f1","email":"awallace@parkviewpm.example","role":"Commenter"}}}]},{"instruction":"Download a PDF copy to email to new tenants.","hint":"File › Download › PDF Document (.pdf).","steps":[{"action":{"kind":"command","id":"g.download","value":"PDF Document (.pdf)"}}]},{"instruction":"Download a PowerPoint copy for the lobby screen.","hint":"File › Download › Microsoft PowerPoint (.pptx).","steps":[{"action":{"kind":"command","id":"g.download","value":"Microsoft PowerPoint (.pptx)"}}]}]}}]]}]]}]

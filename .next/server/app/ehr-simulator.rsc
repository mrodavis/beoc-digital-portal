13:["$","section",null,{"className":"mb-14","aria-labelledby":"help","children":[["$","h2",null,{"id":"help","className":"mb-6 text-3xl font-bold text-gray-900","children":"When something goes wrong"}],["$","div",null,{"className":"divide-y divide-gray-200 rounded-xl border border-gray-200 bg-white shadow-sm","children":[["$","details","It says my class code was not recognized.",{"className":"group p-5","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-gray-900","children":[["$","span",null,{"className":"mr-2 inline-block text-primary-600 transition-transform group-open:rotate-90","children":"›"}],"It says my class code was not recognized."]}],["$","p",null,{"className":"mt-3 pl-5 leading-relaxed text-gray-700","children":"Check the code with your instructor; letters that look alike (O and 0, I and 1) are never used, so if you see one, it is the other. If the class has been closed or the code was changed, your instructor can give you the new one."}]]}],["$","details","It says my email cannot be used for a new account.",{"className":"group p-5","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-gray-900","children":[["$","span",null,{"className":"mr-2 inline-block text-primary-600 transition-transform group-open:rotate-90","children":"›"}],"It says my email cannot be used for a new account."]}],["$","p",null,{"className":"mt-3 pl-5 leading-relaxed text-gray-700","children":"You already have an account. Sign in instead. If you are in a second class, your instructor can add you to it from their roster."}]]}],["$","details","I forgot my password.",{"className":"group p-5","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-gray-900","children":[["$","span",null,{"className":"mr-2 inline-block text-primary-600 transition-transform group-open:rotate-90","children":"›"}],"I forgot my password."]}],["$","p",null,{"className":"mt-3 pl-5 leading-relaxed text-gray-700","children":"There is no email reset. Ask your instructor: they can issue you a temporary password. After you sign in with it, click your name in the top bar and choose a new one under My Account."}]]}],["$","details","It says I have made too many attempts.",{"className":"group p-5","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-gray-900","children":[["$","span",null,{"className":"mr-2 inline-block text-primary-600 transition-transform group-open:rotate-90","children":"›"}],"It says I have made too many attempts."]}],["$","p",null,{"className":"mt-3 pl-5 leading-relaxed text-gray-700","children":"After 10 wrong passwords the account locks for 15 minutes. Wait it out, or ask your instructor to clear the lock."}]]}],["$","details","A simulation says I am in the wrong role.",{"className":"group p-5","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-gray-900","children":[["$","span",null,{"className":"mr-2 inline-block text-primary-600 transition-transform group-open:rotate-90","children":"›"}],"A simulation says I am in the wrong role."]}],["$","p",null,{"className":"mt-3 pl-5 leading-relaxed text-gray-700","children":"Use the role selector in the top bar to switch to the role the assignment names. If the role is not in the list, your class does not include it; tell your instructor."}]]}],["$","details","Which device should I use?",{"className":"group p-5","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-gray-900","children":[["$","span",null,{"className":"mr-2 inline-block text-primary-600 transition-transform group-open:rotate-90","children":"›"}],"Which device should I use?"]}],["$","p",null,{"className":"mt-3 pl-5 leading-relaxed text-gray-700","children":"A laptop or desktop with a current Chrome, Edge, or Safari. Like real hospital software, the simulator is built for a full-size screen. A tablet works; a phone is too small."}]]}]]}]]}]

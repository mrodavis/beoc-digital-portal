a:["$","p",null,{"className":"mt-3 max-w-[68ch] text-lg leading-relaxed text-eng-navy-600","children":"What the TABE Reading test asks, how each question type is worded, and the strategies that keep an avoidable mistake from costing you a point."}]
b:["$","section",null,{"className":"mb-12 rounded-2xl border border-eng-navy-200 bg-white p-6","children":[["$","h2",null,{"className":"mb-4 font-display text-2xl font-bold text-eng-navy-900","children":"What the TABE Reading test asks of you"}],["$","div",null,{"className":"max-w-[68ch] space-y-4 text-[1.0625rem] leading-[1.75] text-eng-navy-800","children":[["$","p","0",{"children":"TABE stands for Tests of Adult Basic Education. The Reading test measures comprehension: it gives you passages and asks what they say, what they mean, and how they are built. It is not a test of what you already know about a topic — in fact, answering from your own knowledge instead of from the passage is one of the most common ways to lose points."}],["$","p","1",{"children":"Passages come from a wide range of adult contexts: workplace documents, health and science articles, history and biography, arguments and editorials, and material presented in charts or tables. You are not expected to be familiar with any of these subjects in advance."}],["$","p","2",{"children":"In ENG0300, the goal is a TABE Reading scale score of 563 or above. That score, or a final grade of C+ or better, satisfies the course completion requirement for Academic Bridge progression."}]]}],["$","dl",null,{"className":"mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4","children":[["$","div","What it measures",{"className":"rounded-xl bg-eng-navy-50 p-4","children":[["$","dt",null,{"className":"text-xs font-bold uppercase tracking-wide text-eng-navy-500","children":"What it measures"}],["$","dd",null,{"className":"mt-1 font-semibold leading-snug text-eng-navy-900","children":"Reading comprehension, not background knowledge"}]]}],["$","div","Question format",{"className":"rounded-xl bg-eng-navy-50 p-4","children":[["$","dt",null,{"className":"text-xs font-bold uppercase tracking-wide text-eng-navy-500","children":"Question format"}],["$","dd",null,{"className":"mt-1 font-semibold leading-snug text-eng-navy-900","children":"Mostly multiple choice, with some multi-part items"}]]}],["$","div","Passage sources",{"className":"rounded-xl bg-eng-navy-50 p-4","children":[["$","dt",null,{"className":"text-xs font-bold uppercase tracking-wide text-eng-navy-500","children":"Passage sources"}],["$","dd",null,{"className":"mt-1 font-semibold leading-snug text-eng-navy-900","children":"Workplace, health, science, history, argument, and data"}]]}],["$","div","ENG0300 goal",{"className":"rounded-xl bg-eng-navy-50 p-4","children":[["$","dt",null,{"className":"text-xs font-bold uppercase tracking-wide text-eng-navy-500","children":"ENG0300 goal"}],["$","dd",null,{"className":"mt-1 font-semibold leading-snug text-eng-navy-900","children":"Scale score 563+"}]]}]]}],["$","p",null,{"className":"mt-6 rounded-lg border-l-4 border-eng-gold-500 bg-eng-gold-50 p-4 text-[0.9375rem] leading-relaxed text-eng-navy-800","children":"The TABE is administered by your program, not through this portal. Your instructor will tell you when and where you are scheduled to test."}]]}]

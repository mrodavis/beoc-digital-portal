1c:["$","section","2",{"children":[["$","h3",null,{"className":"mb-3 font-display text-xl font-bold text-eng-navy-900","children":"Purpose and audience change the writing, not the facts"}],[["$","p","0",{"className":"mb-3 max-w-[68ch] text-[1.0625rem] leading-[1.75] text-eng-navy-800","children":"The same information written to inform a classmate and to persuade a supervisor produces two different paragraphs. The facts do not change. The verbs, the adjectives, the order, and whether there is an ask at the end all do."}],["$","p","1",{"className":"mb-3 max-w-[68ch] text-[1.0625rem] leading-[1.75] text-eng-navy-800","children":"When a prompt names an audience, it is telling you what to optimize for. A supervisor who controls a budget needs the cost consequence early. A classmate who missed the reading needs the context first."}]],"$undefined","$undefined","$undefined"]}]
1d:["$","section","3",{"children":[["$","h3",null,{"className":"mb-3 font-display text-xl font-bold text-eng-navy-900","children":"Revising is diagnosis, not polish"}],[["$","p","0",{"className":"mb-3 max-w-[68ch] text-[1.0625rem] leading-[1.75] text-eng-navy-800","children":"Rereading a draft and changing whatever sounds off will fix small things and miss large ones. Revise against the rubric instead: check focus, then evidence and development, then organization, then conventions — in that order, because fixing a comma in a sentence you are about to cut is wasted work."}]],"$undefined",["$","div",null,{"className":"my-4 overflow-x-auto rounded-xl border border-eng-navy-200","children":["$","table",null,{"className":"w-full min-w-[36rem] border-collapse text-left text-sm","children":[["$","thead",null,{"className":"bg-eng-navy-50","children":["$","tr",null,{"children":[["$","th","Symptom",{"scope":"col","className":"px-4 py-3 font-semibold text-eng-navy-900","children":"Symptom"}],["$","th","Strand",{"scope":"col","className":"px-4 py-3 font-semibold text-eng-navy-900","children":"Strand"}],["$","th","The fix",{"scope":"col","className":"px-4 py-3 font-semibold text-eng-navy-900","children":"The fix"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"border-t border-eng-navy-100 align-top","children":[["$","td","0",{"className":"px-4 py-3 leading-relaxed font-semibold text-eng-navy-900","children":"I cannot find one sentence that answers the question"}],["$","td","1",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"Focus"}],["$","td","2",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"Write the claim as a single sentence and put it first"}]]}],["$","tr","1",{"className":"border-t border-eng-navy-100 align-top","children":[["$","td","0",{"className":"px-4 py-3 leading-relaxed font-semibold text-eng-navy-900","children":"My support could apply to any text"}],["$","td","1",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"Evidence"}],["$","td","2",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"Replace it with a specific detail from this one"}]]}],["$","tr","2",{"className":"border-t border-eng-navy-100 align-top","children":[["$","td","0",{"className":"px-4 py-3 leading-relaxed font-semibold text-eng-navy-900","children":"I quoted something and moved on"}],["$","td","1",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"Evidence"}],["$","td","2",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"Add a sentence saying what it shows"}]]}],["$","tr","3",{"className":"border-t border-eng-navy-100 align-top","children":[["$","td","0",{"className":"px-4 py-3 leading-relaxed font-semibold text-eng-navy-900","children":"The reader has to reorder my sentences"}],["$","td","1",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"Organization"}],["$","td","2",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"Order by claim, then evidence, then explanation"}]]}],["$","tr","4",{"className":"border-t border-eng-navy-100 align-top","children":[["$","td","0",{"className":"px-4 py-3 leading-relaxed font-semibold text-eng-navy-900","children":"My last sentence repeats my first"}],["$","td","1",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"Organization"}],["$","td","2",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"Cut it, or make it advance the idea"}]]}],["$","tr","5",{"className":"border-t border-eng-navy-100 align-top","children":[["$","td","0",{"className":"px-4 py-3 leading-relaxed font-semibold text-eng-navy-900","children":"Errors slow the reader down"}],["$","td","1",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"Conventions"}],["$","td","2",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"Read it aloud; most errors are audible"}]]}]]}]]}]}],"$undefined"]}]

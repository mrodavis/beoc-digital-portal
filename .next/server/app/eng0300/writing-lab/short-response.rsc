23:["$","div",null,{"children":[["$","p",null,{"className":"font-semibold text-eng-navy-900","children":"Keep the evidence, but shrink it"}],["$","p",null,{"className":"mt-1 text-[0.9375rem] leading-relaxed text-eng-navy-700","children":"The detail about people who had not shopped there in years is the sharpest part. One clause is enough; the rest was padding."}]]}]
24:["$","li","Add the explanation the draft never reached",{"className":"rounded-xl border border-eng-navy-100 bg-eng-navy-50/50 p-4","children":["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-eng-navy-800 text-xs font-bold text-white","aria-hidden":"true","children":4}],["$","div",null,{"children":[["$","p",null,{"className":"font-semibold text-eng-navy-900","children":"Add the explanation the draft never reached"}],["$","p",null,{"className":"mt-1 text-[0.9375rem] leading-relaxed text-eng-navy-700","children":"What does that detail prove? That the store's value to the neighborhood was never captured by its sales — which is exactly why the author put it last."}]]}]]}]}]
25:["$","div",null,{"className":"mt-6","children":[["$","h4",null,{"className":"mb-2 text-sm font-bold uppercase tracking-wide text-eng-navy-500","children":"The revision"}],["$","blockquote",null,{"className":"rounded-xl border-l-4 border-eng-green-600 bg-eng-green-50 p-4 text-[0.9375rem] leading-relaxed text-eng-navy-800","children":"The author includes the detail to show that the store mattered to the neighborhood far more than its sales suggested. The line included people who had not bought anything there in years, which means they came for the place rather than for anything they needed. Ending on that image makes the closing feel like a loss to the block, not just to Ruth."}]]}]
26:["$","p",null,{"className":"mt-5 rounded-xl bg-eng-navy-800 p-4 text-[0.9375rem] leading-relaxed text-white","children":[["$","span",null,{"className":"font-bold uppercase tracking-wide text-white/70","children":"Takeaway"}],["$","span",null,{"className":"mt-1 block","children":"The repaired version is barely longer. It is better because every sentence answers the question that was asked, and the last one says what the evidence proves."}]]}]

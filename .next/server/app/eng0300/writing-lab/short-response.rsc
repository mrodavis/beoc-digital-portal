 font-bold uppercase tracking-wide text-eng-navy-500","children":"The thinking, in order"}],["$","ol",null,{"className":"space-y-3","children":[["$","li","Check the question's verb",{"className":"rounded-xl border border-eng-navy-100 bg-eng-navy-50/50 p-4","children":["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-eng-navy-800 text-xs font-bold text-white","aria-hidden":"true","children":1}],["$","div",null,{"children":[["$","p",null,{"className":"font-semibold text-eng-navy-900","children":"Check the question's verb"}],["$","p",null,{"className":"mt-1 text-[0.9375rem] leading-relaxed text-eng-navy-700","children":"The prompt says explain why the author includes it. The draft explains what the detail says, which is a different question. Two of the three sentences are just the passage restated."}]]}]]}]}],["$","li","Write a claim that uses the prompt's verb",{"className":"rounded-xl border border-eng-navy-100 bg-eng-navy-50/50 p-4","children":["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-eng-navy-800 text-xs font-bold text-white","aria-hidden":"true","children":2}],["$","div",null,{"children":[["$","p",null,{"className":"font-semibold text-eng-navy-900","children":"Write a claim that uses the prompt's verb"}],["$","p",null,{"className":"mt-1 text-[0.9375rem] leading-relaxed text-eng-navy-700","children":"\"The author includes it to show that…\" — starting this way makes it structurally impossible to answer the wrong question."}]]}]]}]}],["$","li","Keep the evidence, but shrink it",{"className":"rounded-xl border border-eng-navy-100 bg-eng-navy-50/50 p-4","children":["$","div",null,{"className":"flex items-start gap-3","children":["$L22","$L23"]}]}],"$L24"]}]]}],"$L25","$L26"]}]]}]

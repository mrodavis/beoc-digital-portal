12:{"metadata":[["$","title","0",{"children":"Tier 2 — Paragraph | ENG0300 Writing Lab"}],["$","meta","1",{"name":"description","content":"A paragraph is not a group of sentences about the same topic. It is one idea, developed in an order a reader can follow, with words that mark the moves."}],["$","link","2",{"rel":"icon","href":"/icon.svg?9d9710eb4b6c3903","type":"image/svg+xml","sizes":"any"}],["$","$L2d","3",{}]],"error":null,"digest":"$undefined"}

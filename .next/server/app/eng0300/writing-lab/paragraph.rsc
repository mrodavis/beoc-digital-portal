1d:["$","div",null,{"className":"space-y-12","children":[["$","section",null,{"id":"learn","className":"scroll-mt-32 border-t border-eng-navy-200 pt-10","children":[["$","div",null,{"className":"mb-6","children":[["$","div",null,{"className":"mb-2 flex items-center gap-3","children":[["$","span",null,{"className":"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-eng-navy-800 text-sm font-bold text-white","aria-hidden":"true","children":1}],["$","span",null,{"className":"text-sm font-bold uppercase tracking-widest text-eng-teal-700","children":"Learn"}]]}],["$","h2",null,{"className":"font-display text-2xl font-bold text-eng-navy-900 sm:text-3xl","children":"How this works"}],["$","p",null,{"className":"mt-2 max-w-[68ch] text-base leading-relaxed text-eng-navy-600","children":"Read this first. Everything after it assumes these ideas."}]]}],["$","div",null,{"className":"space-y-8","children":[["$","section","0",{"children":[["$","h3",null,{"className":"mb-3 font-display text-xl font-bold text-eng-navy-900","children":"A topic sentence makes a claim"}],[["$","p","0",{"className":"mb-3 max-w-[68ch] text-[1.0625rem] leading-[1.75] text-eng-navy-800","children":"\"This paragraph is about employer-paid training\" names a subject. It is not a topic sentence, because there is nothing in it a reader could agree or disagree with."}],["$","p","1",{"className":"mb-3 max-w-[68ch] text-[1.0625rem] leading-[1.75] text-eng-navy-800","children":"\"Employers pay for training because it is cheaper than hiring\" is a topic sentence. It commits to something, which tells you exactly what the rest of the paragraph has to support."}]],"$undefined","$undefined",["$","div",null,{"className":"mt-4 max-w-[68ch] rounded-lg border-l-4 border-eng-gold-500 bg-eng-gold-50 p-4","children":[["$","p",null,{"className":"mb-1 text-sm font-bold uppercase tracking-wide text-eng-gold-700","children":"Quick test"}],["$","p",null,{"className":"text-[0.9375rem] leading-relaxed text-eng-navy-80
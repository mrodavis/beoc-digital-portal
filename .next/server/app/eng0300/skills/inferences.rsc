18:["$","div",null,{"className":"space-y-8","children":[["$","section","0",{"children":[["$","h3",null,{"className":"mb-3 font-display text-xl font-bold text-eng-navy-900","children":"An inference is text plus what you already know"}],[["$","p","0",{"className":"mb-3 max-w-[68ch] text-[1.0625rem] leading-[1.75] text-eng-navy-800","children":"An inference is a conclusion you reach that the author never states directly. It is not a guess and it is not your opinion. It is what the details in the passage make true when you put them together with ordinary knowledge about how the world works."}],["$","p","1",{"className":"mb-3 max-w-[68ch] text-[1.0625rem] leading-[1.75] text-eng-navy-800","children":"Every inference on a reading test has to survive one question: which words in the passage make this true? If you cannot answer that, it is a guess."}]],"$undefined",["$","div",null,{"className":"my-4 overflow-x-auto rounded-xl border border-eng-navy-200","children":["$","table",null,{"className":"w-full min-w-[36rem] border-collapse text-left text-sm","children":[["$","thead",null,{"className":"bg-eng-navy-50","children":["$","tr",null,{"children":[["$","th","The text says",{"scope":"col","className":"px-4 py-3 font-semibold text-eng-navy-900","children":"The text says"}],["$","th","You already know",{"scope":"col","className":"px-4 py-3 font-semibold text-eng-navy-900","children":"You already know"}],["$","th","Reasonable inference",{"scope":"col","className":"px-4 py-3 font-semibold text-eng-navy-900","children":"Reasonable inference"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"border-t border-eng-navy-100 align-top","children":[["$","td","0",{"className":"px-4 py-3 leading-relaxed font-semibold text-eng-navy-900","children":"She checked the balance twice before adding the item to her cart."}],["$","td","1",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"People check a balance twice when money is tight."}],["$","td","2",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"She is watching her spending closely."}]]}],["$","tr","1",{"className":"border-t border-eng-navy-100 align-top","children":[["$","td","0",{"className":"px-4 py-3 leading-relaxed font-semibold text-eng-navy-900","children":"The supervisor scheduled the meeting for 7 a.m. and brought printed copies for everyone."}],["$","td","1",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"Early meetings with printed materials are usually planned in advance and treated as important."}],["$","td","2",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"The supervisor considered the meeting important and prepared for it."}]]}]]}]]}]}],"$undefined"]}],["$","section","1",{"children":[["$","h3",null,{"className":"mb-3 font-display text-xl font-bold text-eng-navy-900","children":"How far is too far"}],[["$","p","0",{"className":"mb-3 max-w-[68ch] text-[1.0625rem] leading-[1.75] text-eng-navy-800","children":"The most common wrong answer on an inference question is one that is reasonable in life but unsupported by this passage. Test writers build those on purpose."}]],["$","ul",null,{"className":"mb-4 max-w-[68ch] space-y-2","children":[["$","li","0",{"className":"flex gap-3 text-[1.0625rem] leading-relaxed text-eng-navy-800","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-eng-teal-600","aria-hidden":"true"}],["$","span",null,{"children":"Supported — every part of the statement traces back to something in the text."}]]}],["$","li","1",{"className":"flex gap-3 text-[1.0625rem] leading-relaxed text-eng-navy-800","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-eng-teal-600","aria-hidden":"true"}],["$","span",null,{"children":"Overreach — the direction is right, but the statement is stronger than the evidence (\"always,\" \"never,\" \"everyone\")."}]]}],"$L22","$L23"]}],"$undefined","$L24"]}],"$L25"]}]

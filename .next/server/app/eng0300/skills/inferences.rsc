23:["$","div",null,{"className":"mt-4 max-w-[68ch] rounded-lg border-l-4 border-eng-gold-500 bg-eng-gold-50 p-4","children":[["$","p",null,{"className":"mb-1 text-sm font-bold uppercase tracking-wide text-eng-gold-700","children":"Test tip"}],["$","p",null,{"className":"text-[0.9375rem] leading-relaxed text-eng-navy-800","children":"Before choosing, finish this sentence out loud: \"I know this because the passage says ______.\" If you cannot fill the blank with actual words from the text, choose a different answer."}]]}]
24:["$","section","2",{"children":[["$","h3",null,{"className":"mb-3 font-display text-xl font-bold text-eng-navy-900","children":"Conclusions across a longer text"}],[["$","p","0",{"className":"mb-3 max-w-[68ch] text-[1.0625rem] leading-[1.75] text-eng-navy-800","children":"In longer passages, the evidence for a conclusion is rarely in one place. You collect a detail from the opening, another from the middle, and a third near the end, and the conclusion is what all three point to at once."}],["$","p","1",{"className":"mb-3 max-w-[68ch] text-[1.0625rem] leading-[1.75] text-eng-navy-800","children":"When a question asks you to draw a conclusion about the whole text, expect to use at least two widely separated details."}]],"$undefined","$undefined","$undefined"]}]
25:["$","div",null,{"className":"max-w-[62ch]","children":[["$","p",null,{"className":"font-semibold text-eng-navy-900","children":"Collect the details that seem deliberate."}],["$","p",null,{"className":"mt-1 text-[0.9375rem] leading-relaxed text-eng-navy-700","children":"Copies appear in a restroom and a stairwell — private places, not the bulletin board. Nobody discusses them out loud. Half the tear-off numbers are gone by Friday."}]]}]
26:["$","li","1",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-eng-teal-700 text-sm font-bold text-white","aria-hidden":"true","children":2}],["$","div",null,{"className":"max-w-[62ch]","children":[["$","p",null,{"className":"font-semibold text-eng-navy-900","children":"Ask what those details have in common."}],["$","p",null,{"className":"mt-1 text-[0.9375rem] leading-relaxed text-eng-navy-700","children":"All three point the same direction: the resource is being used, but privately. The placement in unobserved locations and the silence on the floor both suggest workers do not want to be seen taking it."}]]}]]}]
27:["$","li","2",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-eng-teal-700 text-sm font-bold text-white","aria-hidden":"true","children":3}],["$","div",null,{"className":"max-w-[62ch]","children":[["$","p",null,{"className":"font-semibold text-eng-navy-900","children":"Add ordinary knowledge, carefully."}],["$","p",null,{"className":"mt-1 text-[0.9375rem] leading-relaxed text-eng-navy-700","children":"People generally avoid being seen seeking help when they think it could be held against them. The bolded confidentiality line suggests someone anticipated exactly that concern."}]]}]]}]

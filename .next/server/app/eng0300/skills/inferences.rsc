29:["$","li","4",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-eng-teal-700 text-sm font-bold text-white","aria-hidden":"true","children":5}],["$","div",null,{"className":"max-w-[62ch]","children":[["$","p",null,{"className":"font-semibold text-eng-navy-900","children":"Reject the overreach."}],["$","p",null,{"className":"mt-1 text-[0.9375rem] leading-relaxed text-eng-navy-700","children":"I cannot conclude that workers distrust management, that anyone was in crisis, or that the program was successful. The passage supports interest paired with a desire for privacy — nothing stronger."}]]}]]}]

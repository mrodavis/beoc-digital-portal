19:["$","div",null,{"className":"mt-4 max-w-[68ch] rounded-lg border-l-4 border-eng-gold-500 bg-eng-gold-50 p-4","children":[["$","p",null,{"className":"mb-1 text-sm font-bold uppercase tracking-wide text-eng-gold-700","children":"Test tip"}],["$","p",null,{"className":"text-[0.9375rem] leading-relaxed text-eng-navy-800","children":"Cause/effect and problem/solution are the pair most often confused. Ask whether the passage ends by explaining a result (cause/effect) or by proposing a response (problem/solution). If someone is doing something about it, it is problem/solution."}]]}]
1a:["$","section","1",{"children":[["$","h3",null,{"className":"mb-3 font-display text-xl font-bold text-eng-navy-900","children":"Structure follows purpose"}],[["$","p","0",{"className":"mb-3 max-w-[68ch] text-[1.0625rem] leading-[1.75] text-eng-navy-800","children":"Authors do not choose a structure at random. They choose the one that fits what they are trying to accomplish, which means the structure itself is a clue to the author's purpose."}],["$","p","1",{"className":"mb-3 max-w-[68ch] text-[1.0625rem] leading-[1.75] text-eng-navy-800","children":"A manual explaining how to operate a machine uses sequence because order matters. An article arguing that one policy works better than another uses comparison because the reader has to see both. A report on a neighborhood's flooding uses cause and effect if it is explaining what happened, and problem/solution if it is advocating for a fix."}]],["$","ul",null,{"className":"mb-4 max-w-[68ch] space-y-2","children":[["$","li","0",{"className":"flex gap-3 text-[1.0625rem] leading-relaxed text-eng-navy-800","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-eng-teal-600","aria-hidden":"true"}],["$","span",null,{"children":"Read the first and last paragraph to find the shape before you read the middle for detail."}]]}],["$","li","1",{"className":"flex gap-3 text-[1.0625rem] leading-relaxed text-eng-navy-800","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-eng-teal-600","aria-hidden":"true"}],["$","span",null,{"children":"Scan for signal words — three or four of the same family usually settles the structure."}]]}],["$","li","2",{"className":"flex gap-3 text-[1.0625rem] leading-relaxed text-eng-navy-800","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-eng-teal-600","aria-hidden":"true"}],["$","span",null,{"children":"Watch for a passage that uses one structure inside another: a problem/solution article often contains a chronology."}]]}]]}],"$undefined","$undefined"]}]
1b:["$","section","2",{"children":[["$","h3",null,{"className":"mb-3 font-display text-xl font-bold text-eng-navy-900","children":"Comparing structure across two texts"}],[["$","p","0",{"className":"mb-3 max-w-[68ch] text-[1.0625rem] leading-[1.75] text-eng-navy-800","children":"When you are given two texts on one topic, the question is rarely which one is right. It is how each author organized the same subject, and what that organization lets them do."}]],["$","ul",null,{"className":"mb-4 max-w-[68ch] space-y-2","children":[["$","li","0",{"className":"flex gap-3 text-[1.0625rem] leading-relaxed text-eng-navy-800","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-eng-teal-600","aria-hidden":"true"}],["$","span",null,{"children":"Name each text's structure separately before you compare them."}]]}],["$","li","1",{"className":"flex gap-3 text-[1.0625rem] leading-relaxed text-eng-navy-800","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-eng-teal-600","aria-hidden":"true"}],["$","span",null,{"children":"Ask what each structure emphasizes — a chronology emphasizes how something developed; a comparison emphasizes trade-offs."}]]}],["$","li","2",{"className":"flex gap-3 text-[1.0625rem] leading-relaxed text-eng-navy-800","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-eng-teal-600","aria-hidden":"true"}],["$","span",null,{"children":"Ask what each structure leaves out. Structure is a choice, and every choice hides something."}]]}]]}],"$undefined","$undefined"]}]

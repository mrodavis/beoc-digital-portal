1d:["$","section","3",{"children":[["$","h3",null,{"className":"mb-3 font-display text-xl font-bold text-eng-navy-900","children":"Figurative language says one thing to mean another"}],"$undefined",["$","ul",null,{"className":"mb-4 max-w-[68ch] space-y-2","children":[["$","li","0",{"className":"flex gap-3 text-[1.0625rem] leading-relaxed text-eng-navy-800","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-eng-teal-600","aria-hidden":"true"}],["$","span",null,{"children":"First ask what the phrase would mean literally, then ask what the author is actually claiming."}]]}],["$","li","1",{"className":"flex gap-3 text-[1.0625rem] leading-relaxed text-eng-navy-800","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-eng-teal-600","aria-hidden":"true"}],["$","span",null,{"children":"A figurative-language item usually has one literal-minded distractor. It restates the image instead of interpreting it."}]]}]]}],["$","div",null,{"className":"my-4 overflow-x-auto rounded-xl border border-eng-navy-200","children":["$","table",null,{"className":"w-full min-w-[36rem] border-collapse text-left text-sm","children":[["$","thead",null,{"className":"bg-eng-navy-50","children":["$","tr",null,{"children":[["$","th","Type",{"scope":"col","className":"px-4 py-3 font-semibold text-eng-navy-900","children":"Type"}],["$","th","How it works",{"scope":"col","className":"px-4 py-3 font-semibold text-eng-navy-900","children":"How it works"}],["$","th","Example",{"scope":"col","className":"px-4 py-3 font-semibold text-eng-navy-900","children":"Example"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"border-t border-eng-navy-100 align-top","children":[["$","td","0",{"className":"px-4 py-3 leading-relaxed font-semibold text-eng-navy-900","children":"Simile"}],["$","td","1",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"Compares using like or as."}],["$","td","2",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"The training manual was as dense as a tax form."}]]}],["$","tr","1",{"className":"border-t border-eng-navy-100 align-top","children":[["$","td","0",{"className":"px-4 py-3 leading-relaxed font-semibold text-eng-navy-900","children":"Metaphor"}],["$","td","1",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"States the comparison directly, without like or as."}],["$","td","2",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"Her second job was a treadmill she could not step off."}]]}],["$","tr","2",{"className":"border-t border-eng-navy-100 align-top","children":[["$","td","0",{"className":"px-4 py-3 leading-relaxed font-semibold text-eng-navy-900","children":"Idiom"}],["$","td","1",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"A fixed phrase whose meaning is not literal."}],["$","td","2",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"The proposal was dead in the water."}]]}],["$","tr","3",{"className":"border-t border-eng-navy-100 align-top","children":[["$","td","0",{"className":"px-4 py-3 leading-relaxed font-semibold text-eng-navy-900","children":"Personification"}],["$","td","1",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"Gives human qualities to something not human."}],["$","td","2",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"The old furnace groaned all winter."}]]}],["$","tr","4",{"className":"border-t border-eng-navy-100 align-top","children":[["$","td","0",{"className":"px-4 py-3 leading-relaxed font-semibold text-eng-navy-900","children":"Hyperbole"}],["$","td","1",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"Deliberate exaggeration for effect."}],["$","td","2",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"The line at the DMV took a lifetime."}]]}]]}]]}]}],"$undefined"]}]
1e:["$","section",null,{"id":"see-it","className":"scroll-mt-32 border-t border-eng-navy-200 pt-10","children":[["$","div",null,{"className":"mb-6","children":[["$","div",null,{"className":"mb-2 flex items-center gap-3","children":[["$","span",null,{"className":"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-eng-navy-800 text-sm font-bold text-white","aria-hidden":"true","children":2}],["$","span",null,{"className":"text-sm font-bold uppercase tracking-widest text-eng-teal-700","children":"See It"}]]}],["$","h2",null,{"className":"font-display text-2xl font-bold text-eng-navy-900 sm:text-3xl","children":"A worked example"}],["$","p",null,{"className":"mt-2 max-w-[68ch] text-base leading-relaxed text-eng-navy-600","children":"Watch the reasoning before you try it. Notice the order of the moves — that order is the skill."}]]}],["$","div",null,{"className":"space-y-6","children":[["$","h3",null,{"className":"font-display text-xl font-bold text-eng-navy-900","children":"Defining a technical word from its context"}],["$","article",null,{"className":"rounded-xl border border-eng-navy-200 bg-white shadow-sm","children":[["$","header",null,{"className":"border-b border-eng-navy-100 px-4 py-4 sm:px-6","children":["$","div",null,{"className":"flex flex-wrap items-center gap-x-3 gap-y-2","children":[["$","h4",null,{"className":"font-display text-lg font-bold text-eng-navy-900","children":"Open Enrollment"}],["$","span",null,{"className":"rounded-full bg-eng-teal-50 px-3 py-1 text-xs font-semibold text-eng-teal-800","children":"Health"}],["$","span",null,{"className":"text-xs text-eng-navy-400","children":[175," words"]}]]}]}],["$","div",null,{"className":"px-4 py-5 sm:px-6","children":[["$","div",null,{"className":"max-w-[68ch] space-y-4 text-[1.0625rem] leading-[1.75] text-eng-navy-800","children":[["$","p","0",{"className":"flex gap-3","children":["$undefined",["$","span",null,{"children":"Every fall, employees are asked to choose a health plan during a short window called open enrollment. The choice is harder than it looks, because the plan with the lowest monthly premium is not always the cheapest plan overall."}]]}],["$","p","1",{"className":"flex gap-3","children":["$undefined",["$","span",null,{"children":"A premium is what you pay each month simply to have coverage, whether or not you see a doctor. A deductible is different: it is the amount you must pay yourself before the plan begins paying its share. A plan with a low premium often carries a high deductible, which means low monthly cost but a large bill the first time you need care."}]]}],["$","p","2",{"className":"flex gap-3","children":["$undefined",["$","span",null,{"children":"Employees who rarely see a doctor may come out ahead with the low-premium plan. Employees managing an ongoing condition usually do not, because they will reach that deductible early in the year and keep paying full price until they do."}]]}]]}],"$undefined",["$","p",null,{"className":"mt-5 border-t border-eng-navy-100 pt-3 text-xs italic text-eng-navy-400","children":"Original passage — BEOC Academic Bridge"}]]}]]}],["$","div",null,{"className":"rounded-xl border-2 border-eng-teal-600 bg-white p-4 sm:p-6","children":[["$","p",null,{"className":"mb-1 text-sm font-bold uppercase tracking-wide text-eng-teal-700","children":"The question"}],["$","p",null,{"className":"text-lg font-semibold leading-relaxed text-eng-navy-900","children":"As used in the passage, what does deductible mean?"}],["$","p",null,{"className":"mb-4 mt-6 text-sm font-bold uppercase tracking-wide text-eng-teal-700","children":"Thinking it through"}],["$","ol",null,{"className":"space-y-4","children":[["$","li","0",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-eng-teal-700 text-sm font-bold text-white","aria-hidden":"true","children":1}],["$","div",null,{"className":"max-w-[62ch]","children":["$L27","$L28"]}]]}],"$L29","$L2a","$L2b"]}],"$L2c","$L2d"]}]]}]]}]
1f:["$","section",null,{"id":"try-it","className":"scroll-mt-32 border-t border-eng-navy-200 pt-10","children":[["$","div",null,{"className":"mb-6","children":[["$","div",null,{"className":"mb-2 flex items-center gap-3","children":[["$","span",null,{"className":"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-eng-navy-800 text-sm font-bold text-white","aria-hidden":"true","children":3}],["$","span",null,{"className":"text-sm font-bold uppercase tracking-widest text-eng-teal-700","children":"Try It"}]]}],["$","h2",null,{"className":"font-display text-2xl font-bold text-eng-navy-900 sm:text-3xl","children":"Your turn, with support"}],["$","p",null,{"className":"mt-2 max-w-[68ch] text-base leading-relaxed text-eng-navy-600","children":"One question, with a hint available. Nothing here is graded."}]]}],["$","div",null,{"className":"space-y-6","children":["$undefined",[["$","article","vocab-guided-lease",{"className":"rounded-xl border border-eng-navy-200 bg-white shadow-sm","children":[["$","header",null,{"className":"border-b border-eng-navy-100 px-4 py-4 sm:px-6","children":["$","div",null,{"className":"flex flex-wrap items-center gap-x-3 gap-y-2","children":[["$","h4",null,{"className":"font-display text-lg font-bold text-eng-navy-900","children":"Reading the Lease"}],["$","span",null,{"className":"rounded-full bg-eng-teal-50 px-3 py-1 text-xs font-semibold text-eng-teal-800","children":"Informational"}],["$","span",null,{"className":"text-xs text-eng-navy-400","children":[68," words"]}]]}]}],["$","div",null,{"className":"px-4 py-5 sm:px-6","children":[["$","div",null,{"className":"max-w-[68ch] space-y-4 text-[1.0625rem] leading-[1.75] text-eng-navy-800","children":[["$","p","0",{"className":"flex gap-3","children":["$undefined",["$","span",null,{"children":"The lease looked standard until the eleventh page, where a clause stated that the tenant would forfeit the security deposit if the apartment was vacated before the term ended. Marisol had planned to move for a job in the spring. Unlike the flexible month-to-month arrangement she had before, this agreement gave her no way to leave early without losing the deposit entirely."}]]}]]}],"$undefined",["$","p",null,{"className":"mt-5 border-t border-eng-navy-100 pt-3 text-xs italic text-eng-navy-400","children":"Original passage — BEOC Academic Bridge"}]]}]]}]],["$","div",null,{"className":"space-y-4","children":[["$","$L2e","vocab-g1",{"question":{"id":"vocab-g1","type":"vocabulary-in-context","question":"As used in the passage, forfeit most nearly means —","passageId":"vocab-guided-lease","choices":["to renew","to lose as a penalty","to deposit","to negotiate"],"correctAnswer":1,"hint":"The last sentence restates the same idea in plain words. Find the phrase that repeats it.","explanation":"The final sentence says she has no way to leave early \"without losing the deposit entirely.\" That restatement defines forfeit as losing something as a penalty.","choiceRationales":["Opposite of the context — nothing is being extended or renewed.","Correct. The passage restates it as losing the deposit, and the loss is triggered by breaking the term.","Confuses the word with the noun beside it. A deposit is what she would lose, not what forfeit means.","Plausible in a lease generally, but the sentence describes an automatic consequence, not a discussion."],"skill":"vocabulary","difficulty":"Developing"},"number":1}]]}]]}]]}]
20:["$","section",null,{"id":"practice","className":"scroll-mt-32 border-t border-eng-navy-200 pt-10","children":[["$","div",null,{"className":"mb-6","children":[["$","div",null,{"className":"mb-2 flex items-center gap-3","children":[["$","span",null,{"className":"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-eng-navy-800 text-sm font-bold text-white","aria-hidden":"true","children":4}],["$","span",null,{"className":"text-sm font-bold uppercase tracking-widest text-eng-teal-700","children":"Practice"}]]}],["$","h2",null,{"className":"font-display text-2xl font-bold text-eng-navy-900 sm:text-3xl","children":"Practice on a full passage"}],["$","p",null,{"className":"mt-2 max-w-[68ch] text-base leading-relaxed text-eng-navy-600","children":"A longer passage with several questions. Check each answer as you go."}]]}],["$","div",null,{"className":"space-y-6","children":["$undefined",[["$","article","vocab-practice-grid",{"className":"rounded-xl border border-eng-navy-200 bg-white shadow-sm","children":[["$","header",null,{"className":"border-b border-eng-navy-100 px-4 py-4 sm:px-6","children":["$","div",null,{"className":"flex flex-wrap items-center gap-x-3 gap-y-2","children":[["$","h4",null,{"className":"font-display text-lg font-bold text-eng-navy-900","children":"The Grid in August"}],["$","span",null,{"className":"rounded-full bg-eng-teal-50 px-3 py-1 text-xs font-semibold text-eng-teal-800","children":"Science"}],["$","span",null,{"className":"text-xs text-eng-navy-400","children":[235," words"]}]]}]}],["$","div",null,{"className":"px-4 py-5 sm:px-6","children":[["$","div",null,{"className":"max-w-[68ch] space-y-4 text-[1.0625rem] leading-[1.75] text-eng-navy-800","children":[["$","p","0",{"className":"flex gap-3","children":[["$","span",null,{"className":"w-5 shrink-0 pt-1 text-right text-sm font-semibold tabular-nums text-eng-navy-300","aria-hidden":"true","children":1}],["$","span",null,{"children":"On the hottest afternoons of the summer, the regional power grid strains under a load it was never designed to carry all at once. Utilities call these hours peak demand — the narrow window, usually between four and seven in the evening, when air conditioners, ovens, and returning commuters all draw power simultaneously."}]]}],["$","p","1",{"className":"flex gap-3","children":[["$","span",null,{"className":"w-5 shrink-0 pt-1 text-right text-sm font-semibold tabular-nums text-eng-navy-300","aria-hidden":"true","children":2}],["$","span",null,{"children":"To keep the system stable, utilities can ask large customers to curtail usage, reducing their draw voluntarily in exchange for a lower rate the rest of the year. Factories dim lights. Warehouses shift equipment runs to the night. A hospital cannot participate, but a bottling plant often can."}]]}],["$","p","2",{"className":"flex gap-3","children":[["$","span",null,{"className":"w-5 shrink-0 pt-1 text-right text-sm font-semibold tabular-nums text-eng-navy-300","aria-hidden":"true","children":3}],["$","span",null,{"children":"When voluntary reductions are not enough, the utility may lower voltage slightly across a region. Older residents still call this a brownout, because decades ago it made incandescent bulbs visibly dim. Modern lighting rarely shows it, so most customers now feel nothing at all."}]]}],["$","p","3",{"className":"flex gap-3","children":[["$","span",null,{"className":"w-5 shrink-0 pt-1 text-right text-sm font-semibold tabular-nums text-eng-navy-300","aria-hidden":"true","children":4}],["$","span",null,{"children":"Grid operators describe August as walking a tightrope in the wind. The comparison is deliberate. The margin between supply and demand on those afternoons is thin, and the consequences of losing balance are immediate and public."}]]}]]}],"$undefined",["$","p",null,{"className":"mt-5 border-t border-eng-navy-100 pt-3 text-xs italic text-eng-navy-400","children":"Original passage — BEOC Academic Bridge"}]]}]]}]],"$L2f"]}]]}]

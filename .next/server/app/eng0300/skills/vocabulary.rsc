2a:["$","li","1",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-eng-teal-700 text-sm font-bold text-white","aria-hidden":"true","children":2}],["$","div",null,{"className":"max-w-[62ch]","children":[["$","p",null,{"className":"font-semibold text-eng-navy-900","children":"Identify the clue type."}],["$","p",null,{"className":"mt-1 text-[0.9375rem] leading-relaxed text-eng-navy-700","children":"This is a definition clue. The meaning is stated outright right after the colon. That is the fastest kind to use."}]]}]]}]
2b:["$","li","2",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-eng-teal-700 text-sm font-bold text-white","aria-hidden":"true","children":3}],["$","div",null,{"className":"max-w-[62ch]","children":[["$","p",null,{"className":"font-semibold text-eng-navy-900","children":"Confirm with the surrounding contrast."}],["$","p",null,{"className":"mt-1 text-[0.9375rem] leading-relaxed text-eng-navy-700","children":"The passage sets deductible against premium — monthly cost versus what you pay before coverage kicks in. The contrast confirms the definition rather than competing with it."}]]}]]}]
2c:["$","li","3",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-eng-teal-700 text-sm font-bold text-white","aria-hidden":"true","children":4}],["$","div",null,{"className":"max-w-[62ch]","children":[["$","p",null,{"className":"font-semibold text-eng-navy-900","children":"Check the definition against the last paragraph."}],["$","p",null,{"className":"mt-1 text-[0.9375rem] leading-relaxed text-eng-navy-700","children":"Someone with an ongoing condition reaches the deductible early and pays full price until then. That only makes sense with the definition I have, so it holds."}]]}]]}]

46:["$","div",null,{"className":"overflow-x-auto","children":["$","table",null,{"className":"w-full min-w-[18rem] border-collapse text-sm","children":[["$","caption",null,{"className":"sr-only","children":"Bar chart of families on one child-care center's waiting lists in September, by the child's age group: 26 for infants under age 1, 17 for toddlers age 1, 11 for twos, and 5 for preschool children ages 3 to 5."}],["$","thead",null,{"children":["$","tr",null,{"className":"border-b-2 border-eng-navy-200 text-left","children":[["$","th","Age group",{"scope":"col","className":"py-2 pr-4 font-semibold text-eng-navy-800","children":"Age group"}],["$","th","Families waiting",{"scope":"col","className":"py-2 pr-4 font-semibold text-eng-navy-800","children":"Families waiting"}]]}]}],["$","tbody",null,{"children":[["$","tr","Infants (under age 1)",{"className":"border-b border-eng-navy-100","children":[["$","th",null,{"scope":"row","className":"py-2 pr-4 text-left font-medium text-eng-navy-800","children":"Infants (under age 1)"}],[["$","td","0",{"className":"py-2 pr-4 tabular-nums text-eng-navy-700","children":[26,""]}]]]}],["$","tr","Toddlers (age 1)",{"className":"border-b border-eng-navy-100","children":[["$","th",null,{"scope":"row","className":"py-2 pr-4 text-left font-medium text-eng-navy-800","children":"Toddlers (age 1)"}],[["$","td","0",{"className":"py-2 pr-4 tabular-nums text-eng-navy-700","children":[17,""]}]]]}],["$","tr","Twos (age 2)",{"className":"border-b border-eng-navy-100","children":[["$","th",null,{"scope":"row","className":"py-2 pr-4 text-left font-medium text-eng-navy-800","children":"Twos (age 2)"}],[["$","td","0",{"className":"py-2 pr-4 tabular-nums text-eng-navy-700","children":[11,""]}]]]}],["$","tr","Preschool (ages 3–5)",{"className":"border-b border-eng-navy-100","children":[["$","th",null,{"scope":"row","className":"py-2 pr-4 text-left font-medium text-eng-navy-800","children":"Preschool (ages 3–5)"}],[["$","td","0",{"className":"py-2 pr-4 ta
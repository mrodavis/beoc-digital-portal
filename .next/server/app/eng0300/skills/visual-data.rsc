31:["$","div",null,{"className":"space-y-4","children":[["$","$L4d","vd-g1",{"question":{"id":"vd-g1","type":"chart-data","question":"Based on the figure, how much higher is the broadband subscription rate for households earning $100,000 and above than for households earning under $25,000?","passageId":"vd-guided-broadband","choices":["24 percentage points","38 percentage points","57 percentage points","95 percentage points"],"correctAnswer":1,"hint":"Find both bars, then subtract the smaller from the larger. Do not stop at reading one bar.","explanation":"The highest income group is at 95 percent and the lowest at 57 percent. 95 − 57 = 38 percentage points.","choiceRationales":["This is the gap between the two middle categories, not between the highest and lowest.","Correct. 95 minus 57 is 38.","This is the value of the lowest bar, not a difference between two bars.","This is the value of the highest bar, not a difference."],"skill":"visual-data","difficulty":"Foundation"},"number":1}]]}]

1a:["$","section","2",{"children":[["$","h3",null,{"className":"mb-3 font-display text-xl font-bold text-eng-navy-900","children":"What a figure cannot tell you"}],[["$","p","0",{"className":"mb-3 max-w-[68ch] text-[1.0625rem] leading-[1.75] text-eng-navy-800","children":"Charts invite conclusions they do not support. A chart shows what happened; it rarely shows why, and it never shows what will happen next unless the text says so."}]],["$","ul",null,{"className":"mb-4 max-w-[68ch] space-y-2","children":[["$","li","0",{"className":"flex gap-3 text-[1.0625rem] leading-relaxed text-eng-navy-800","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-eng-teal-600","aria-hidden":"true"}],["$","span",null,{"children":"A chart shows association, not cause. Two lines rising together do not establish that one caused the other."}]]}],["$","li","1",{"className":"flex gap-3 text-[1.0625rem] leading-relaxed text-eng-navy-800","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-eng-teal-600","aria-hidden":"true"}],["$","span",null,{"children":"A chart covering three years does not establish a long-term trend."}]]}],["$","li","2",{"className":"flex gap-3 text-[1.0625rem] leading-relaxed text-eng-navy-800","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-eng-teal-600","aria-hidden":"true"}],["$","span",null,{"children":"A chart of percentages hides the size of the group. Fifty percent of six people is three."}]]}],["$","li","3",{"className":"flex gap-3 text-[1.0625rem] leading-relaxed text-eng-navy-800","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-eng-teal-600","aria-hidden":"true"}],["$","span",null,{"children":"If the answer choice contains information not in the figure and not in the text, it is wrong regardless of how sensible it sounds."}]]}]]}],"$undefined","$undefined"]}]
1b:["$","section","3",{"children":[["$","h3",null,{"className":"mb-3 font-display text-xl font-bold text-eng-navy-900","children":"Integrating more than one source"}],[["$","p","0",{"className":"mb-3 max-w-[68ch] text-[1.0625rem] leading-[1.75] text-eng-navy-800","children":"The final outcome of this course asks you to combine sources. When two sources address one topic, work through them in order: what does each say, where do they agree, where do they differ, and what can you conclude only by holding both at once?"}]],["$","ul",null,{"className":"mb-4 max-w-[68ch] space-y-2","children":[["$","li","0",{"className":"flex gap-3 text-[1.0625rem] leading-relaxed text-eng-navy-800","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-eng-teal-600","aria-hidden":"true"}],["$","span",null,{"children":"Check whether the sources measure the same thing over the same period. Often they do not, and that is the answer."}]]}],["$","li","1",{"className":"flex gap-3 text-[1.0625rem] leading-relaxed text-eng-navy-800","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-eng-teal-600","aria-hidden":"true"}],["$","span",null,{"children":"Agreement between two independent sources strengthens a conclusion."}]]}],["$","li","2",{"className":"flex gap-3 text-[1.0625rem] leading-relaxed text-eng-navy-800","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-eng-teal-600","aria-hidden":"true"}],["$","span",null,{"children":"A disagreement is information. Ask what would explain it before deciding one source is wrong."}]]}]]}],"$undefined","$undefined"]}]
1c:["$","section",null,{"id":"see-it","className":"scroll-mt-32 border-t border-eng-navy-200 pt-10","children":[["$","div",null,{"className":"mb-6","children":[["$","div",null,{"className":"mb-2 flex items-center gap-3","children":[["$","span",null,{"className":"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-eng-navy-800 text-sm font-bold text-white","aria-hidden":"true","children":2}],["$","span",null,{"className":"text-sm font-bold uppercase tracking-widest text-eng-teal-700","children":"See It"}]]}],["$","h2",null,{"className":"font-display text-2xl font-bold text-eng-navy-900 sm:text-3xl","children":"A worked example"}],["$","p",null,{"className":"mt-2 max-w-[68ch] text-base leading-relaxed text-eng-navy-600","children":"Watch the reasoning before you try it. Notice the order of the moves — that order is the skill."}]]}],["$","div",null,{"className":"space-y-6","children":[["$","h3",null,{"className":"font-display text-xl font-bold text-eng-navy-900","children":"Connecting a chart to the argument beside it"}],["$","article",null,{"className":"rounded-xl border border-eng-navy-200 bg-white shadow-sm","children":[["$","header",null,{"className":"border-b border-eng-navy-100 px-4 py-4 sm:px-6","children":["$","div",null,{"className":"flex flex-wrap items-center gap-x-3 gap-y-2","children":[["$","h4",null,{"className":"font-display text-lg font-bold text-eng-navy-900","children":"The Cost of Getting There"}],["$","span",null,{"className":"rounded-full bg-eng-teal-50 px-3 py-1 text-xs font-semibold text-eng-teal-800","children":"Data / Charts"}],["$","span",null,{"className":"text-xs text-eng-navy-400","children":[190," words"]}]]}]}],["$","div",null,{"className":"px-4 py-5 sm:px-6","children":[["$","div",null,{"className":"max-w-[68ch] space-y-4 text-[1.0625rem] leading-[1.75] text-eng-navy-800","children":[["$","p","0",{"className":"flex gap-3","children":["$undefined",["$","span",null,{"children":"When a training program reports its completion rate, the number is usually explained in terms of academics: the material was too hard, or students arrived underprepared. Program staff who track the reasons students actually give tell a different story."}]]}],["$","p","1",{"className":"flex gap-3","children":["$undefined",["$","span",null,{"children":"In an exit survey at one workforce program, students who withdrew were asked to identify the primary reason. Academic difficulty appeared, but it was not the largest category. Transportation and schedule conflicts together accounted for more than half of all withdrawals."}]]}],["$","p","2",{"className":"flex gap-3","children":["$undefined",["$","span",null,{"children":"The distinction matters because it points to different fixes. A program that believes its students are underprepared invests in tutoring. A program that knows its students cannot reliably get to class invests in bus passes, evening sections, and attendance policies that survive a missed shift."}]]}]]}],["$","figure",null,{"className":"my-6 rounded-xl border border-eng-navy-200 bg-white p-4 sm:p-6","children":[["$","figcaption",null,{"className":"mb-4","children":[["$","span",null,{"className":"block text-sm font-semibold uppercase tracking-wide text-eng-teal-700","children":"Figure"}],["$","span",null,{"className":"mt-1 block text-base font-bold text-eng-navy-900","children":"Primary reason given for withdrawing, one workforce program exit survey"}]]}],["$","div",null,{"className":"mb-6 space-y-3","aria-hidden":"true","children":[["$","div","Transportation",{"children":[["$","div",null,{"className":"mb-1 flex items-baseline justify-between gap-3 text-sm","children":[["$","span",null,{"className":"font-medium text-eng-navy-800","children":"Transportation"}],["$","span",null,{"className":"font-bold tabular-nums text-eng-navy-900","children":[31,"%"]}]]}],["$","div",null,{"className":"h-3 w-full overflow-hidden rounded-full bg-eng-navy-100","children":["$","div",null,{"className":"h-full rounded-full bg-e
items-center justify-center rounded-full bg-eng-teal-700 text-sm font-bold text-white","aria-hidden":"true","children":3}],["$","div",null,{"className":"max-w-[62ch]","children":[["$","p",null,{"className":"font-semibold text-eng-navy-900","children":"Check the first claim against the figure."}],["$","p",null,{"className":"mt-1 text-[0.9375rem] leading-relaxed text-eng-navy-700","children":"Academic difficulty is 16 percent. Transportation is 31 and schedule conflict is 24, both larger. The claim holds."}]]}]]}],["$","li","3",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-eng-teal-700 text-sm font-bold text-white","aria-hidden":"true","children":4}],["$","div",null,{"className":"max-w-[62ch]","children":[["$","p",null,{"className":"font-semibold text-eng-navy-900","children":"Check the second claim by combining bars."}],["$","p",null,{"className":"mt-1 text-[0.9375rem] leading-relaxed text-eng-navy-700","children":"31 plus 24 is 55 percent. That is more than half, so \"more than half\" is exact rather than loose. This combination is the strongest support."}]]}]]}],["$","li","4",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-eng-teal-700 text-sm font-bold text-white","aria-hidden":"true","children":5}],["$","div",null,{"className":"max-w-[62ch]","children":[["$","p",null,{"className":"font-semibold text-eng-navy-900","children":"Guard against the overreach."}],["$","p",null,{"className":"mt-1 text-[0.9375rem] leading-relaxed text-eng-navy-700","children":"I cannot conclude that transportation causes withdrawals at other programs, or that bus passes would fix it. The figure reports reasons students gave, at one program."}]]}]]}]]}],["$","div",null,{"className":"mt-6 rounded-lg bg-eng-green-50 p-4","children":[["$","p",null,{"className":"mb-1 text-sm font-bold uppercase tracking-wide text-eng-gre
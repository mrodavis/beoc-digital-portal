25:["$","div",null,{"className":"mt-4 max-w-[68ch] rounded-lg border-l-4 border-eng-gold-500 bg-eng-gold-50 p-4","children":[["$","p",null,{"className":"mb-1 text-sm font-bold uppercase tracking-wide text-eng-gold-700","children":"Test tip"}],["$","p",null,{"className":"text-[0.9375rem] leading-relaxed text-eng-navy-800","children":"When asked which evidence best supports a claim, restate the claim in your own words first. Distractors are usually true statements from the passage that support a slightly different claim."}]]}]
26:["$","section","2",{"children":[["$","h3",null,{"className":"mb-3 font-display text-xl font-bold text-eng-navy-900","children":"Common weaknesses to name"}],[["$","p","0",{"className":"mb-3 max-w-[68ch] text-[1.0625rem] leading-[1.75] text-eng-navy-800","children":"Naming a weakness is not the same as saying the claim is false. An argument can reach a correct conclusion on insufficient evidence. The question on a reading test is whether the author supported the claim, not whether you agree with it."}]],"$undefined",["$","div",null,{"className":"my-4 overflow-x-auto rounded-xl border border-eng-navy-200","children":["$","table",null,{"className":"w-full min-w-[36rem] border-collapse text-left text-sm","children":[["$","thead",null,{"className":"bg-eng-navy-50","children":["$","tr",null,{"children":[["$","th","Weakness",{"scope":"col","className":"px-4 py-3 font-semibold text-eng-navy-900","children":"Weakness"}],["$","th","What it looks like",{"scope":"col","className":"px-4 py-3 font-semibold text-eng-navy-900","children":"What it looks like"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"border-t border-eng-navy-100 align-top","children":[["$","td","0",{"className":"px-4 py-3 leading-relaxed font-semibold text-eng-navy-900","children":"Too small a sample"}],["$","td","1",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"A conclusion about all workers drawn from one workplace."}]]}],["$","tr","1",{"className":"border-t border-eng-navy-100 align-top","children":[["$","td","0",{"className":"px-4 py-3 leading-relaxed font-semibold text-eng-navy-900","children":"Anecdote in place of data"}],["$","td","1",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"One person's experience treated as proof of a general pattern."}]]}],["$","tr","2",{"className":"border-t border-eng-navy-100 align-top","children":[["$","td","0",{"className":"px-4 py-3 leading-relaxed font-semibold text-eng-navy-900","children":"Irrelevant support"}],["$","td","1",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"Evidence that is true and interesting but does not address the claim being made."}]]}],["$","tr","3",{"className":"border-t border-eng-navy-100 align-top","children":[["$","td","0",{"className":"px-4 py-3 leading-relaxed font-semibold text-eng-navy-900","children":"Correlation treated as cause"}],["$","td","1",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"Two things happened together, so the author says one caused the other."}]]}],["$","tr","4",{"className":"border-t border-eng-navy-100 align-top","children":[["$","td","0",{"className":"px-4 py-3 leading-relaxed font-semibold text-eng-navy-900","children":"Ignoring the obvious objection"}],["$","td","1",{"className":"px-4 py-3 leading-relaxed text-eng-navy-700","children":"The author never addresses the strongest reason a reader might disagree."}]]}]]}]]}]}],"$undefined"]}]

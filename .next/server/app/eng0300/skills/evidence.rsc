28:["$","div",null,{"className":"rounded-xl border-2 border-eng-teal-600 bg-white p-4 sm:p-6","children":[["$","p",null,{"className":"mb-1 text-sm font-bold uppercase tracking-wide text-eng-teal-700","children":"The question"}],["$","p",null,{"className":"text-lg font-semibold leading-relaxed text-eng-navy-900","children":"Which of the author's reasons is best supported, and which is weakest?"}],["$","p",null,{"className":"mb-4 mt-6 text-sm font-bold uppercase tracking-wide text-eng-teal-700","children":"Thinking it through"}],["$","ol",null,{"className":"space-y-4","children":[["$","li","0",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-eng-teal-700 text-sm font-bold text-white","aria-hidden":"true","children":1}],["$","div",null,{"className":"max-w-[62ch]","children":[["$","p",null,{"className":"font-semibold text-eng-navy-900","children":"Locate the claim."}],["$","p",null,{"className":"mt-1 text-[0.9375rem] leading-relaxed text-eng-navy-700","children":"Paragraph 1, stated outright: employers should move to a four-day week without cutting pay. Everything after is support."}]]}]]}],["$","li","1",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-eng-teal-700 text-sm font-bold text-white","aria-hidden":"true","children":2}],["$","div",null,{"className":"max-w-[62ch]","children":[["$","p",null,{"className":"font-semibold text-eng-navy-900","children":"Sort the support into reasons."}],["$","p",null,{"className":"mt-1 text-[0.9375rem] leading-relaxed text-eng-navy-700","children":"Retention (paragraph 2), output (paragraph 3), a personal example (paragraph 4). Paragraph 5 raises an objection rather than supporting the claim."}]]}]]}],["$","li","2",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-eng-teal-700 text-sm font-bold text-white","aria-hidden":"true","children":3}],["$","div",null,{"className":"max-w-[62ch]","children":[["$","p",null,{"className":"font-semibold text-eng-navy-900","children":"Test paragraph 3 for sufficiency and relevance."}],["$","p",null,{"className":"mt-1 text-[0.9375rem] leading-relaxed text-eng-navy-700","children":"It cites several published trials, gives the result, and explains a mechanism — the extra day absorbs errands that otherwise eat working hours. Multiple sources, directly on the claim. This is the strongest support."}]]}]]}],["$","li","3",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-eng-teal-700 text-sm font-bold text-white","aria-hidden":"true","children":4}],["$","div",null,{"className":"max-w-[62ch]","children":[["$","p",null,{"className":"font-semibold text-eng-navy-900","children":"Test paragraph 4."}],["$","p",null,{"className":"mt-1 text-[0.9375rem] leading-relaxed text-eng-navy-700","children":"One manager, one team, and \"everyone was happier\" with nothing to verify it. This is anecdote standing in for data. It is the weakest support, even though it is the most vivid."}]]}]]}],["$","li","4",{"className":"flex gap-4","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-eng-teal-700 text-sm font-bold text-white","aria-hidden":"true","children":5}],["$","div",null,{"className":"max-w-[62ch]","children":[["$","p",null,{"className":"font-semibold text-eng-navy-900","children":"Notice what paragraph 5 does for the argument."}],["$","p",null,{"className":"mt-1 text-[0.9375rem] leading-relaxed text-eng-navy-700","children":"The author states the objection fairly and does not answer it. That is honest, but it leaves a real gap: the claim says employers, and the objection shows an entire category of employers the argument does not cover."}]]}]]}]]}],"$L32","$L33"]}]
2a:["$","span",null,{"children":"None of this addresses the largest question, which is how the lost fare revenue would be replaced in a system where fares cover a substantial share of the operating budget."}]

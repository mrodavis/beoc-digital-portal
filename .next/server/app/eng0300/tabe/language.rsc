30:["$","span",null,{"children":"For capitals, ask whether the word is part of a name. Dean Alvarez yes, the dean no. Spanish yes, biology no. March yes, spring no."}]
31:["$","li","For apostrophes, expand the contraction: it's becomes it is, who's becomes who is. If the expansion is nonsense, you want the possessive.",{"className":"flex gap-2 text-sm leading-relaxed text-eng-navy-700","children":[["$","span",null,{"className":"font-bold text-eng-teal-700","aria-hidden":"true","children":[4,"."]}],["$","span",null,{"children":"For apostrophes, expand the contraction: it's becomes it is, who's becomes who is. If the expansion is nonsense, you want the possessive."}]]}]
32:["$","div",null,{"className":"border-t border-eng-navy-100 bg-eng-navy-50/50 p-5","children":[["$","h4",null,{"className":"mb-3 text-sm font-bold uppercase tracking-wide text-eng-navy-500","children":"Two worked examples"}],["$","ol",null,{"className":"grid gap-4 md:grid-cols-2","children":[["$","li","0",{"className":"rounded-xl border border-eng-navy-200 bg-white p-4","children":[["$","p",null,{"className":"text-sm font-semibold leading-relaxed text-eng-navy-900","children":"Which is correct? (A) My co-worker, who trained me is retiring. (B) My co-worker, who trained me, is retiring."}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-eng-navy-600","children":[["$","span",null,{"className":"font-bold uppercase tracking-wide text-eng-navy-400","children":"Thinking"}]," ","— ","Who trained me is extra information about the co-worker. Extra information gets a comma on each side; A opens the pair and never closes it."]}],["$","p",null,{"className":"mt-2 rounded-lg bg-eng-green-50 p-2.5 text-sm leading-relaxed text-eng-green-700","children":[["$","span",null,{"className":"font-bold uppercase tracking-wide","children":"Answer"}]," ","— ","B."]}]]}],["$","li","1",{"className":"rounded-xl border border-eng-navy-200 bg-white p-4","children":[["$","p",null,{"className":"text-sm font-semibold leading-relaxed text-eng-navy-900","children":"Which is capitalized correctly? (A) I applied to the office of financial aid in the Spring. (B) I applied to the Office of Financial Aid in the spring."}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-eng-navy-600","children":[["$","span",null,{"className":"font-bold uppercase tracking-wide text-eng-navy-400","children":"Thinking"}]," ","— ","The Office of Financial Aid is the name of a specific office, so it takes capitals. Spring is a season and never does."]}],["$","p",null,{"className":"mt-2 rounded-lg bg-eng-green-50 p-2.5 text-sm leading-relaxed text-eng-green-700","children":[["$","span",null,{"className":"font-bold uppercase tracking-wide","children":"Answer"}]," ","— ","B. The test pairs these two rules deliberately, because they pull in opposite directions."]}]]}]]}]]}]
